---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Sya Creates : Designer UX/UI indépendante · AI-assisted development',
  description = "Designer UX/UI indépendante. J'associe une expertise produit éprouvée à un développement assisté par IA pour livrer des interfaces crédibles, plus vite.",
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f3d2e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preconnect + <link> plutôt qu'un @import CSS (bloquant le rendu,
         ~2,25 s de pénalité mesurés au Lighthouse en prod). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'Sya Creates',
        url: 'https://sya-creates.vercel.app',
        image: ogImageURL.toString(),
        description,
        email: 'sya.creates@gmail.com',
        founder: {
          '@type': 'Person',
          name: 'Aïda',
          jobTitle: 'Designer UX/UI indépendante',
        },
        areaServed: 'FR',
        knowsAbout: ['UX Design', 'UI Design', 'Développement assisté par IA'],
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    const sections = document.querySelectorAll('section[id]:not(#hero)');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    sections.forEach((section) => {
      section.classList.add('reveal');
      observer.observe(section);
    });
  }

  // Cartes "flip" — clic/tap ou Entrée/Espace retourne la carte vers sa
  // face arrière (explication), un second déclenchement la referme.
  // "click" (pas pointerdown/touchstart) : les navigateurs ne synthétisent
  // pas de click après un tap qui a scrollé la page, donc rien à gérer en plus.
  document.querySelectorAll('.flip-card').forEach((card) => {
    const front = card.querySelector('.flip-card__front');
    const back = card.querySelector('.flip-card__back');

    // Le dos de la carte reste dans le DOM même face cachée (rotation 3D,
    // pas display:none) : sans aria-hidden, son texte reste exposé aux
    // lecteurs d'écran et aux outils de contrôle vocal en même temps que
    // le recto, alors qu'un seul des deux est réellement visible.
    const syncFaces = (flipped: boolean) => {
      front?.setAttribute('aria-hidden', String(flipped));
      back?.setAttribute('aria-hidden', String(!flipped));
    };
    syncFaces(false);

    const toggle = () => {
      const flipped = card.classList.toggle('is-flipped');
      card.setAttribute('aria-expanded', String(flipped));
      syncFaces(flipped);
    };

    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      toggle();
    });
  });
</script>
