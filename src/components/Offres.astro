---
const offres = [
  {
    numero: '01',
    titre: 'Discovery',
    texte:
      "Cadrer le besoin, comprendre les utilisateurs et poser les bases d'un projet qui a du sens avant de concevoir quoi que ce soit.",
  },
  {
    numero: '02',
    titre: 'UX Design',
    texte:
      "Architecturer les parcours, structurer l'information et concevoir des interfaces qui se comprennent sans mode d'emploi.",
  },
  {
    numero: '03',
    titre: 'UI Design',
    texte:
      'Donner une forme visuelle soignée et cohérente à l\'expérience, avec un système de design réutilisable.',
  },
  {
    numero: '04',
    titre: 'Fast Integration',
    texte:
      'Transformer les maquettes en interface fonctionnelle rapidement, grâce à un développement assisté par IA.',
  },
  {
    numero: '05',
    titre: 'Strategy / Marketing',
    texte:
      'Aligner design et objectifs business pour que chaque écran serve la conversion et la crédibilité de la marque.',
  },
  {
    numero: '06',
    titre: 'UX Audit',
    texte:
      "Analyser l'existant, identifier les points de friction et prioriser les améliorations à plus fort impact.",
  },
  {
    numero: '07',
    titre: 'Ongoing Support',
    texte:
      "Rester disponible après la livraison pour ajuster, faire évoluer et accompagner la suite du produit.",
  },
];
---

<section class="offers" id="offres">
  <span class="blob blob--offers" aria-hidden="true"></span>

  <div class="offers__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Offres
    </span>

    <h2 class="offers__title">
      Sept façons de vous accompagner, <em>du cadrage à la mise en ligne.</em>
    </h2>

    <p class="offers__intro">
      Chaque offre peut se combiner selon l'avancement de votre projet — d'un premier cadrage à
      l'amélioration continue d'un produit déjà en ligne.
    </p>

    <div class="offers__grid">
      {
        offres.map((offre, index) => (
          <div class="offer-card glass-card reveal-item" style={`--i: ${index}`}>
            <span class="offer-card__numero">{offre.numero}</span>
            <h3 class="offer-card__titre">{offre.titre}</h3>
            <p class="offer-card__texte">{offre.texte}</p>
            <a href="#contact" class="offer-card__cta">
              En discuter →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .offers {
    position: relative;
    padding: 96px 24px;
    overflow: hidden;
  }

  .blob--offers {
    width: 420px;
    height: 420px;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(139, 92, 246, 0.14), transparent 70%);
    opacity: 0.7;
  }

  .offers__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .offers__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 34ch;
  }

  .offers__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .offers__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  .offers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 56px;
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
  }

  .offer-card__numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--gradient-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 12px;
    margin-bottom: 18px;
  }

  .offer-card__titre {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .offer-card__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex-grow: 1;
  }

  .offer-card__cta {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    margin-top: 20px;
  }

  .offer-card__cta:hover {
    color: var(--color-accent-2);
  }

  @media (max-width: 860px) {
    .offers {
      padding: 64px 20px;
    }

    .offers__grid {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
