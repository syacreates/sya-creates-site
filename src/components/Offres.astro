---
import SectionCorners from './SectionCorners.astro';

const offres = [
  {
    numero: '01',
    titre: 'Discovery',
    texte:
      "Cadrer le besoin, comprendre les utilisateurs et poser les bases d'un projet qui a du sens avant de concevoir quoi que ce soit.",
  },
  {
    numero: '02',
    titre: 'UX Design',
    texte:
      "Architecturer les parcours, structurer l'information et concevoir des interfaces qui se comprennent sans mode d'emploi.",
  },
  {
    numero: '03',
    titre: 'UI Design',
    texte:
      'Donner une forme visuelle soignée et cohérente à l\'expérience, avec un système de design réutilisable.',
  },
  {
    numero: '04',
    titre: 'Fast Integration',
    texte:
      'Transformer les maquettes en interface fonctionnelle rapidement, grâce à un développement assisté par IA.',
  },
  {
    numero: '05',
    titre: 'Strategy / Marketing',
    texte:
      'Aligner design et objectifs business pour que chaque écran serve la conversion et la crédibilité de la marque.',
  },
  {
    numero: '06',
    titre: 'UX Audit',
    texte:
      "Analyser l'existant, identifier les points de friction et prioriser les améliorations à plus fort impact.",
  },
  {
    numero: '07',
    titre: 'Ongoing Support',
    texte:
      "Rester disponible après la livraison pour ajuster, faire évoluer et accompagner la suite du produit.",
  },
];
---

<section class="offers" id="offres">
  <SectionCorners />

  <div class="offers__inner">
    <p class="offers__eyebrow">Offres</p>

    <h2 class="offers__title">
      Sept façons de vous accompagner, du cadrage à la mise en ligne.
    </h2>

    <p class="offers__intro">
      Chaque offre peut se combiner selon l'avancement de votre projet — d'un premier cadrage à
      l'amélioration continue d'un produit déjà en ligne.
    </p>

    <div class="offers__grid">
      {
        offres.map((offre) => (
          <div class="offer-card">
            <span class="offer-card__numero">{offre.numero}</span>
            <h3 class="offer-card__titre">{offre.titre}</h3>
            <p class="offer-card__texte">{offre.texte}</p>
            <a href="#contact" class="offer-card__cta">
              En discuter →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .offers {
    position: relative;
    background: var(--color-bg);
    padding: 96px 48px;
  }

  .offers__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .offers__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
  }

  .offers__title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 30ch;
  }

  .offers__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  .offers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 56px;
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 28px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .offer-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-ink);
  }

  .offer-card__numero {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .offer-card__titre {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .offer-card__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex-grow: 1;
  }

  .offer-card__cta {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
    margin-top: 20px;
  }

  @media (max-width: 860px) {
    .offers {
      padding: 64px 24px;
    }

    .offers__grid {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
  }
</style>
