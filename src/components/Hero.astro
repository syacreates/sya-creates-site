---
import WordCube from './WordCube.astro';

const titleLine1 = "Je débloque ton produit,";
const titleLine2 = "et j'élimine tes frictions UX.";
const words1 = titleLine1.split(' ');
const words2 = titleLine2.split(' ');

const tags = [
  'Discovery',
  'UX Research',
  'UI Design',
  'Design System',
  'AI-assisted Dev',
  'Fast Shipping',
  'Suivi produit',
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <!-- Cascade de cubes noir/anthracite (voir <script>) : lévite au centre
       de .hero__orbfield, avec un léger flottement d'arrivée avant de se
       stabiliser. Purement décorative et non interactive (ni cliquable, ni
       glissable, ni pilotable au clavier) — aria-hidden, et
       pointer-events:none pour ne jamais intercepter un clic destiné au
       contenu en dessous. -->
  <canvas id="hero-cubes" class="hero__cubes" aria-hidden="true"></canvas>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <div class="title-flanked title-flanked--hero">
      <span class="title-flanked__line" aria-hidden="true" />
      <h1 class="hero__title">
        <span class="hero__title-line">
          {words1.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i}`}>{w}&nbsp;</span></span>
          ))}
        </span>
        <span class="hero__title-line hero__title-accent">
          {words2.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i + words1.length}`}>{w}&nbsp;</span></span>
          ))}
        </span>
      </h1>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__marquee" role="presentation">
      <div class="hero__marquee-track">
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        {tags.map((tag) => <span class="tag-pill" aria-hidden="true">{tag}</span>)}
      </div>
    </div>

    <div class="hero__orbfield" aria-hidden="true"></div>

    <WordCube />
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-cubes') as HTMLCanvasElement | null;
  const field = canvas?.parentElement;
  const orbfield = document.querySelector('.hero__orbfield') as HTMLElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && field && orbfield && !prefersReduced) {
    // Three.js/cannon-es chargés à la demande (voir IntroOverlay.astro pour
    // le détail de la mesure Lighthouse qui a motivé ce changement) — pas
    // en import statique qui alourdirait le bundle initial de la page.
    void (async () => {
    const [THREE, { RoundedBoxGeometry }, { RoomEnvironment }, CANNON] = await Promise.all([
      import('three'),
      import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
      import('three/examples/jsm/environments/RoomEnvironment.js'),
      import('cannon-es'),
    ]);

    let width = field.clientWidth;
    let height = field.clientHeight;

    // --- Three.js scene, orthographic so 1 unit = 1px ---
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.8);
    const key = new THREE.DirectionalLight(0xffffff, 0.5);
    key.position.set(120, 220, 260);
    scene.add(ambient, key);

    // --- cannon-es world : sans gravité, le cube lévite. Un ressort
    // critiquement amorti (voir applyLevitation) le retient près du
    // centre du champ d'orbes au lieu de le laisser tomber — un espace
    // de mouvement resserré, calé sur .hero__orbfield plutôt que sur
    // toute la hauteur du hero.
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, 0, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);

    const cubeMat = new CANNON.Material('cube');
    const wallMat = new CANNON.Material('wall');
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, wallMat, { friction: 0.1, restitution: 0.4 }));

    let depth = Math.min(width, height) * 0.5;

    function makeWall(px: number, py: number, pz: number, hx: number, hy: number, hz: number) {
      const body = new CANNON.Body({ mass: 0, material: wallMat, shape: new CANNON.Box(new CANNON.Vec3(hx, hy, hz)) });
      body.position.set(px, py, pz);
      world.addBody(body);
      return body;
    }

    let wallTop: CANNON.Body, wallBottom: CANNON.Body, wallLeft: CANNON.Body, wallRight: CANNON.Body, wallFront: CANNON.Body, wallBack: CANNON.Body;

    // Point de lévitation (centre de .hero__orbfield) et bornes qui
    // contiennent l'élan de rotation à l'arrivée — proportionnels à la
    // taille réelle du champ d'orbes (pas des constantes en dur), donc
    // valables à toutes les largeurs d'écran.
    let restX = 0;
    let restY = 0;

    function layoutBounds() {
      const heroRect = field!.getBoundingClientRect();
      const orbRect = orbfield!.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      const laneLeftX = orbRect.left - centerX;
      const laneRightX = orbRect.right - centerX;
      const orbTopWorldY = height / 2 - (orbRect.top - heroRect.top);
      const orbBottomWorldY = height / 2 - (orbRect.bottom - heroRect.top);
      restX = (laneLeftX + laneRightX) / 2;
      restY = (orbTopWorldY + orbBottomWorldY) / 2;
      depth = Math.min(width, height) * 0.5;

      const big = 4000;
      const halfW = (laneRightX - laneLeftX) / 2 - 10;
      const halfH = (orbTopWorldY - orbBottomWorldY) / 2 - 10;
      if (wallTop) [wallTop, wallBottom, wallLeft, wallRight, wallFront, wallBack].forEach((b) => world.removeBody(b));
      wallTop = makeWall(restX, restY + halfH, 0, halfW + 30, 20, big);
      wallBottom = makeWall(restX, restY - halfH, 0, halfW + 30, 20, big);
      wallLeft = makeWall(restX - halfW, restY, 0, 20, halfH + 30, big);
      wallRight = makeWall(restX + halfW, restY, 0, 20, halfH + 30, big);
      wallFront = makeWall(0, 0, depth / 2, big, big, 20);
      wallBack = makeWall(0, 0, -depth / 2, big, big, 20);
    }
    layoutBounds();

    // --- Cascade de cubes : plusieurs cubes noir/chrome de tailles
    // différentes, empilés en diagonale façon socle sculptural, plutôt que
    // l'ancien gros cube unique à faces labellisées — purement décoratif
    // désormais (plus de texte imprimé sur les faces). Toute la cascade
    // reste UN seul corps physique (une boîte de collision englobante),
    // donc elle lévite/se lance/rebondit comme un seul objet rigide.
    type ClusterCubeSpec = {
      x: number; y: number; z: number; size: number;
      tone: 'black' | 'anthracite';
    };
    // Composition recalée sur la photo de référence : une tour qui tombe
    // presque à la verticale (léger zigzag gauche/droite), pas une longue
    // diagonale à 45° — le plus gros cube en haut, le plus petit tout en
    // bas, comme une pile qui vient de dégringoler. Pas d'angle de départ
    // par cube ici : chaque mini-cube reçoit sa propre rotation continue à
    // la volée (voir spawnCluster), donc un angle statique serait aussitôt
    // écrasé dès la première frame.
    const CLUSTER_CUBES: ClusterCubeSpec[] = [
      { x: 15, y: 160, z: 20, size: 90, tone: 'black' },
      { x: -38, y: 95, z: -10, size: 78, tone: 'anthracite' },
      { x: 28, y: 32, z: 16, size: 66, tone: 'black' },
      { x: -22, y: -32, z: -14, size: 58, tone: 'anthracite' },
      { x: 18, y: -92, z: 10, size: 50, tone: 'black' },
      { x: -25, y: -148, z: -10, size: 44, tone: 'anthracite' },
      { x: 12, y: -200, z: 12, size: 38, tone: 'black' },
    ];

    type ClusterRig = { mesh: THREE.Group; body: CANNON.Body; size: number; age: number };
    const cubes: ClusterRig[] = [];

    function toneMaterial(tone: 'black' | 'anthracite') {
      // Deux gris sombres à contraste modéré (quasi-noir / anthracite),
      // plutôt que le blanc trop clair du premier essai — toujours pas de
      // metalness ~1 plein : on a déjà appris (voir historique du hero)
      // qu'un chrome trop pur devient quasi invisible sur ce fond sombre,
      // faute de reflets d'environnement assez lumineux.
      // Rugosité/clearcoat relevés par rapport à la première passe : avec
      // chaque mini-cube en rotation continue sur un axe aléatoire, une
      // face finit tôt ou tard par pointer pile vers la lumière clé — un
      // matériau trop "miroir" (roughness/clearcoatRoughness bas) fait
      // alors flasher cette face en blanc pur à cet instant-là. Un fini
      // plus mat garde le reflet visible sans jamais saturer.
      return tone === 'anthracite'
        ? new THREE.MeshPhysicalMaterial({
            color: 0x3a3d40,
            metalness: 0.45,
            roughness: 0.6,
            envMapIntensity: 0.6,
            clearcoat: 0.2,
            clearcoatRoughness: 0.55,
            transparent: true,
            opacity: 0,
          })
        : new THREE.MeshPhysicalMaterial({
            color: 0x0c1210,
            metalness: 0.18,
            roughness: 0.6,
            envMapIntensity: 0.45,
            clearcoat: 0.15,
            clearcoatRoughness: 0.6,
            transparent: true,
            opacity: 0,
          });
    }

    // Tangage fixe (X) sur le groupe entier, pour garder le dessus des
    // cubes lisible — sans lacet (Y) permanent qui coucherait la tour
    // verticale dessinée en coordonnées locales vers une diagonale trop
    // horizontale une fois vue caméra. Déclaré avant spawnCluster() qui
    // l'utilise dès la construction du groupe.
    const VIEW_TILT = new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.16, 0.05, 0));

    function spawnCluster() {
      const group = new THREE.Group();
      let maxExtent = 0;
      for (const spec of CLUSTER_CUBES) {
        const geo = new RoundedBoxGeometry(spec.size, spec.size, spec.size, 4, spec.size * 0.08);
        const mesh = new THREE.Mesh(geo, toneMaterial(spec.tone));
        mesh.position.set(spec.x, spec.y, spec.z);
        // Arêtes dessinées explicitement, comme sur l'ancien cube unique :
        // un fini satiné en rotation libre traverse des angles où aucune
        // arête n'est visible entre deux faces sans ce trait.
        const edges = new THREE.LineSegments(
          new THREE.EdgesGeometry(geo, 25),
          new THREE.LineBasicMaterial({
            color: spec.tone === 'anthracite' ? 0x1c1e20 : 0x000000,
            transparent: true,
            opacity: 0,
          })
        );
        mesh.add(edges);
        // Animation propre à chaque mini-cube (axe/vitesse/déphasage de
        // rotation, phase/amplitude de flottement) plutôt qu'un seul
        // mouvement partagé par toute la cascade — demandé explicitement
        // pour un rendu moins mécanique, plus naturel : chaque cube tourne
        // à son rythme, certains flottent plus haut ou plus bas que
        // d'autres à un instant donné.
        mesh.userData = {
          baseY: spec.y,
          spinAxis: new THREE.Vector3(
            Math.random() * 2 - 1,
            Math.random() * 2 - 1,
            Math.random() * 2 - 1
          ).normalize(),
          spinSpeed: 0.06 + Math.random() * 0.22,
          spinPhase: Math.random() * Math.PI * 2,
          bobAmp: 5 + Math.random() * 9,
          bobSpeed: 0.55 + Math.random() * 0.7,
          bobPhase: Math.random() * Math.PI * 2,
        };
        group.add(mesh);
        const reach = Math.hypot(spec.x, spec.y, spec.z) + spec.size * 0.9;
        if (reach > maxExtent) maxExtent = reach;
      }
      // Tangage de lecture fixe sur le groupe entier (garde le dessus des
      // cubes visible) — la cascade ne tourne plus comme un seul bloc,
      // chaque cube gère sa propre rotation individuellement (voir tick()).
      group.quaternion.copy(VIEW_TILT);
      scene.add(group);

      // Boîte de collision englobante nettement plus petite que l'étendue
      // visuelle réelle (les cubes du bord ont surtout du vide entre eux) :
      // à 0.72 elle talonnait les murs invisibles de .hero__orbfield côté
      // mobile (largeur/hauteur ~150-170px de rayon), d'où le tremblement —
      // le ressort la replaçait sans cesse en butée contre un mur. Marge
      // large ici pour laisser le ressort respirer.
      const half = Math.min(maxExtent * 0.5, 100);
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.15,
        angularDamping: 0.35,
      });
      // Apparaît déjà à son point de lévitation — il n'y a plus de chute à
      // jouer. La rotation du corps physique n'est plus utilisée (voir la
      // rotation continue pilotée dans tick()), seule sa position compte.
      body.position.set(restX, restY, 0);

      const rig: ClusterRig = { mesh: group, body, size: maxExtent, age: 0 };
      cubes.push(rig);
      return rig;
    }

    const rig = spawnCluster();
    world.addBody(rig.body);

    // Purement décorative : ni cliquable, ni glissable, ni pilotable au
    // clavier. Le canvas n'intercepte donc plus aucun pointeur (voir
    // pointer-events:none dans le <style>), pas besoin de relais de clic
    // vers le contenu en dessous.

    // --- Render loop, paused while offscreen ---
    let running = true;
    let rafId = 0;
    let prevTime = performance.now();

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      // Ressort critiquement amorti qui retient chaque cascade près de son
      // point de lévitation (restX, restY, 0) — pas de gravité, donc rien
      // d'autre ne l'y ramènerait après l'élan d'arrivée.
      const SPRING_K = 5;
      const SPRING_DAMP = 2 * Math.sqrt(SPRING_K);
      for (const c of cubes) {
        const b = c.body;
        b.velocity.x += (-SPRING_K * (b.position.x - restX) - SPRING_DAMP * b.velocity.x) * dt;
        b.velocity.y += (-SPRING_K * (b.position.y - restY) - SPRING_DAMP * b.velocity.y) * dt;
        b.velocity.z += (-SPRING_K * b.position.z - SPRING_DAMP * b.velocity.z) * dt;
      }
      world.step(1 / 60, dt, 6);

      for (let i = cubes.length - 1; i >= 0; i--) {
        const c = cubes[i];

        // Le groupe ne porte plus que la position d'ensemble (lévitation) —
        // ni bob ni rotation uniformes ici, chaque mini-cube gère les
        // siens individuellement juste en dessous, pour un mouvement
        // désynchronisé plutôt qu'un bloc rigide qui tourne d'un seul tenant.
        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);

        for (const child of c.mesh.children) {
          const u = child.userData as {
            baseY: number; spinAxis: THREE.Vector3; spinSpeed: number; spinPhase: number;
            bobAmp: number; bobSpeed: number; bobPhase: number;
          };
          child.position.y = u.baseY + Math.sin(now / 1000 * u.bobSpeed + u.bobPhase) * u.bobAmp;
          child.quaternion.setFromAxisAngle(u.spinAxis, now / 1000 * u.spinSpeed + u.spinPhase);
        }

        // Fondu d'apparition — la cascade arrive progressivement plutôt que
        // de recouvrir brutalement un label (chip, texte) qu'elle traverse.
        c.age += dt;
        const fadeIn = Math.min(c.age / 0.4, 1);
        c.mesh.traverse((obj) => {
          if (obj instanceof THREE.Mesh) {
            (obj.material as THREE.MeshPhysicalMaterial).opacity = fadeIn;
          } else if (obj instanceof THREE.LineSegments) {
            (obj.material as THREE.LineBasicMaterial).opacity = fadeIn * 0.85;
          }
        });
      }
      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !running) {
          running = true;
          prevTime = performance.now();
          rafId = requestAnimationFrame(tick);
        } else if (!visible && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(field);
    rafId = requestAnimationFrame(tick);

    window.addEventListener('resize', () => {
      width = field.clientWidth;
      height = field.clientHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      layoutBounds();
    });
    })();
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 24px var(--section-py);
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    font-style: italic;
    font-weight: 500;
  }

  /* Traits volontairement courts : le titre du hero occupe déjà toute la
     largeur utile de .hero__inner (780px) — des traits plus longs lui
     voleraient assez de place pour casser sa mise en ligne habituelle
     ("Je débloque ton produit," passerait sur deux lignes). */
  .title-flanked--hero {
    gap: 16px;
    align-items: center;
  }

  .title-flanked--hero .title-flanked__line {
    width: 32px;
  }

  @media (max-width: 640px) {
    .title-flanked--hero .title-flanked__line {
      width: 18px;
    }
  }

  /* Apparition mot par mot au chargement — chaque mot glisse depuis son
     propre masque, façon titre animé du site de référence. */
  .word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
  }

  .word-inner {
    display: inline-block;
    opacity: 0;
    transform: translateY(110%);
    animation: word-reveal 0.75s var(--ease-spring) both;
    animation-delay: calc(var(--i, 0) * 65ms + 0.15s);
  }

  .hero__title-accent .word-inner {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes word-reveal {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
    height: 400px;
    margin-top: 24px;
    perspective: 1200px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  /* Cube chromé — scène WebGL (Three.js + cannon-es), voir le <script>
     plus bas. Le canvas couvre tout le hero, mais le cube lévite dans une
     zone resserrée calée en JS sur .hero__orbfield. Posé au-dessus du
     texte pour rester manipulable par-dessus. */
  .hero__cubes {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    /* Purement décorative : n'intercepte jamais un clic/tap destiné au
       contenu en dessous (CTA, liens, cartes flip) — plus besoin du relais
       de clic qu'exigeait l'ancien cube manipulable. */
    pointer-events: none;
    /* Même halo respirant que le cube-logo de l'écran d'intro (voir
       IntroOverlay.astro, .intro-overlay__cta-icon) : un drop-shadow qui
       pulse épouse la silhouette réelle du cube (canvas à fond alpha
       transparent), donc suit son flottement sans calcul de position. */
    animation: hero-cube-glow 2.2s ease-in-out infinite;
  }

  @keyframes hero-cube-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 8px rgba(127, 196, 160, 0.4));
    }
    50% {
      filter: drop-shadow(0 0 22px rgba(127, 196, 160, 0.9));
    }
  }

  /* Bandeau de mots-clés — repris de l'ancienne section Vision, déplacé
     ici sous la note "café virtuel", avant le champ de cubes. */
  .hero__marquee {
    width: 100%;
    max-width: 480px;
    margin-top: 4px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .hero__marquee-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px var(--section-py-mobile);
    }

    .hero__orbfield {
      height: 360px;
    }

    .hero__marquee {
