---
const stars = [
  { top: '4%', left: '18%', size: 10, delay: '0s' },
  { top: '10%', left: '52%', size: 7, delay: '0.6s' },
  { top: '2%', left: '78%', size: 13, delay: '1.2s' },
  { top: '20%', left: '92%', size: 8, delay: '0.3s' },
  { top: '30%', left: '2%', size: 11, delay: '1.8s' },
  { top: '36%', left: '58%', size: 6, delay: '2.4s' },
  { top: '46%', left: '82%', size: 10, delay: '0.9s' },
  { top: '54%', left: '20%', size: 7, delay: '1.5s' },
  { top: '60%', left: '44%', size: 13, delay: '0.2s' },
  { top: '66%', left: '8%', size: 8, delay: '2.1s' },
  { top: '72%', left: '70%', size: 10, delay: '1.1s' },
  { top: '80%', left: '35%', size: 7, delay: '0.5s' },
  { top: '86%', left: '58%', size: 11, delay: '1.7s' },
  { top: '90%', left: '88%', size: 8, delay: '0.8s' },
  { top: '16%', left: '32%', size: 7, delay: '2.6s' },
  { top: '58%', left: '95%', size: 9, delay: '1.4s' },
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <h1 class="hero__title">
      Un design qui inspire confiance,
      <span class="hero__title-accent">une exécution qui va plus vite.</span>
    </h1>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__orbfield" aria-hidden="true">
      <span class="hero__nebula"></span>

      {
        stars.map((star) => (
          <span
            class="hero__star"
            style={`top:${star.top}; left:${star.left}; width:${star.size}px; height:${star.size}px; animation-delay:${star.delay};`}
          />
        ))
      }

      <span class="hero__orb hero__orb--1"></span>
      <span class="hero__orb hero__orb--2"></span>
      <span class="hero__orb hero__orb--3"></span>

      <span class="hero__chip hero__chip--1">🔍 Discovery</span>
      <span class="hero__chip hero__chip--2">✏️ UX</span>
      <span class="hero__chip hero__chip--3">🎨 UI</span>
      <span class="hero__chip hero__chip--4 hero__chip--active">🚀 Ship</span>
      <span class="hero__chip hero__chip--5">🧩 Design System</span>
      <span class="hero__chip hero__chip--6">🤖 AI-assisted</span>
      <span class="hero__chip hero__chip--7">📈 Strategy</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 24px 96px;
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-accent {
    display: block;
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
    height: 400px;
    margin-top: 24px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  /* Nébuleuse — halo diffus derrière les orbes, pour un fond "espace" */
  .hero__nebula {
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(circle at 30% 35%, rgba(31, 61, 46, 0.22), transparent 55%),
      radial-gradient(circle at 72% 60%, rgba(214, 178, 110, 0.18), transparent 50%),
      radial-gradient(circle at 55% 20%, rgba(76, 140, 99, 0.16), transparent 45%);
    filter: blur(30px);
    animation: float-blob 16s ease-in-out infinite;
    pointer-events: none;
  }

  /* Étoiles scintillantes réalistes — deux barres en dégradé radial qui se
     croisent, façon sparkle/éclat lumineux à 4 branches effilées, avec un
     cœur blanc chaud qui vire à l'or sur les pointes. */
  .hero__star {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    animation: star-twinkle 2.6s ease-in-out infinite;
  }

  .hero__star::before,
  .hero__star::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: radial-gradient(
      ellipse at center,
      #fffdf5 0%,
      #fff2c7 22%,
      #f0c25f 48%,
      rgba(201, 150, 47, 0) 78%
    );
  }

  .hero__star::before {
    width: 100%;
    height: 30%;
  }

  .hero__star::after {
    width: 30%;
    height: 100%;
  }

  @keyframes star-twinkle {
    0%, 100% {
      opacity: 0.3;
      transform: scale(0.55) rotate(0deg);
    }
    45% {
      opacity: 1;
      transform: scale(1) rotate(8deg);
    }
    55% {
      opacity: 1;
      transform: scale(1.25) rotate(8deg);
    }
    100% {
      opacity: 0.3;
      transform: scale(0.55) rotate(0deg);
    }
  }

  .hero__orb {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    animation: float-blob 8s ease-in-out infinite;
  }

  .hero__orb--1 {
    width: 150px;
    height: 150px;
    top: 6%;
    left: 6%;
    background: radial-gradient(
      circle at 32% 28%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.1) 24%,
      var(--color-accent-2) 55%,
      var(--color-accent) 100%
    );
    box-shadow: inset 0 -12px 24px rgba(22, 36, 28, 0.2), 0 24px 44px -18px rgba(22, 36, 28, 0.4);
  }

  .hero__orb--2 {
    width: 108px;
    height: 108px;
    bottom: 8%;
    right: 10%;
    background: radial-gradient(
      circle at 34% 30%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.08) 24%,
      #e9c98a 55%,
      #c99a4f 100%
    );
    box-shadow: inset 0 -10px 20px rgba(22, 36, 28, 0.18), 0 20px 38px -16px rgba(22, 36, 28, 0.35);
    animation-duration: 10s;
    animation-delay: -3s;
  }

  .hero__orb--3 {
    width: 64px;
    height: 64px;
    top: 44%;
    right: 30%;
    background: radial-gradient(
      circle at 32% 28%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.1) 24%,
      var(--color-accent) 60%,
      var(--color-ink) 100%
    );
    box-shadow: inset 0 -8px 16px rgba(22, 36, 28, 0.2), 0 16px 30px -14px rgba(22, 36, 28, 0.35);
    animation-duration: 7s;
    animation-delay: -1.5s;
  }

  .hero__chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-ink);
    background: var(--color-glass-strong);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    animation: float-blob 6.5s ease-in-out infinite;
    white-space: nowrap;
  }

  .hero__chip--1 {
    top: 2%;
    left: 40%;
    animation-delay: -2s;
  }

  .hero__chip--2 {
    top: 50%;
    left: 2%;
    animation-duration: 7.5s;
    animation-delay: -4s;
  }

  .hero__chip--3 {
    top: 4%;
    right: 6%;
    animation-duration: 8.5s;
    animation-delay: -1s;
  }

  .hero__chip--4 {
    bottom: 4%;
    right: 32%;
    animation-duration: 6s;
    animation-delay: -3.5s;
  }

  .hero__chip--5 {
    top: 32%;
    right: 2%;
    animation-duration: 9s;
    animation-delay: -2.6s;
  }

  .hero__chip--6 {
    top: 78%;
    left: 26%;
    animation-duration: 7s;
    animation-delay: -1.8s;
  }

  .hero__chip--7 {
    top: 76%;
    left: 4%;
    animation-duration: 8s;
    animation-delay: -4.4s;
  }

  .hero__chip--active {
    background: var(--gradient-accent);
    color: #ffffff;
    border-color: transparent;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px 64px;
    }

    .hero__orbfield {
      height: 360px;
    }

    .hero__orb--1 {
      width: 110px;
      height: 110px;
    }

    .hero__orb--2 {
      width: 84px;
      height: 84px;
    }

    .hero__orb--3 {
      width: 50px;
      height: 50px;
    }

    .hero__chip {
      font-size: 0.75rem;
      padding: 8px 14px;
    }

    .hero__ctas {
      gap: 20px;
    }
  }
</style>
