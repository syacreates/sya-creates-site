---
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <h1 class="hero__title">
      Un design qui inspire confiance,
      <span class="hero__title-accent">une exécution qui va plus vite.</span>
    </h1>

    <p class="hero__subtitle">
      Designer UX/UI indépendante — 10 ans d'expérience — j'associe une exigence produit éprouvée
      à un développement assisté par IA pour livrer des interfaces soignées, plus vite.
    </p>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel</a>
      <a href="#offres" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ?</p>

    <div class="hero__visual glass-panel">
      <svg
        class="hero__illustration"
        viewBox="0 0 560 300"
        role="img"
        aria-label="D'un wireframe à une interface livrée"
      >
        <!-- Wireframe (gauche) -->
        <rect
          x="8" y="20" width="200" height="260" rx="16"
          fill="none" stroke="var(--color-line)" stroke-width="1.5"
          stroke-dasharray="5 4"
        />
        <rect x="28" y="46" width="70" height="10" rx="4" fill="var(--color-line)" />
        <rect x="28" y="72" width="160" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="88" width="160" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="104" width="120" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="140" width="160" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="156" width="160" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="172" width="90" height="6" rx="3" fill="var(--color-line)" />
        <rect x="28" y="220" width="70" height="22" rx="11" fill="none" stroke="var(--color-line)" stroke-width="1.5" />

        <!-- Flèche -->
        <line x1="222" y1="150" x2="270" y2="150" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" />
        <path d="M262 142 L272 150 L262 158" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Interface livrée (droite) -->
        <rect
          x="292" y="20" width="260" height="260"
          fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="1.5"
          rx="20"
        />
        <rect x="316" y="46" width="120" height="12" rx="6" fill="var(--color-ink)" />
        <rect x="316" y="78" width="212" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.5" />
        <rect x="316" y="94" width="212" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.5" />
        <rect x="316" y="110" width="160" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.5" />
        <rect x="316" y="146" width="212" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.3" />
        <rect x="316" y="162" width="212" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.3" />
        <rect x="316" y="178" width="130" height="6" rx="3" fill="var(--color-text-secondary)" opacity="0.3" />
        <rect x="316" y="224" width="96" height="26" rx="13" fill="var(--color-accent)" />
      </svg>

      <ol class="timeline">
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">Discovery</span>
        </li>
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">UX</span>
        </li>
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">UI</span>
        </li>
        <li class="timeline__step timeline__step--active">
          <span class="timeline__dot"></span>
          <span class="timeline__label">Ship</span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 24px 96px;
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-accent {
    display: block;
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .hero__visual {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    margin-top: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  .hero__illustration {
    width: 100%;
    height: auto;
  }

  .timeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 5px;
    right: 5px;
    height: 1px;
    background: var(--color-line);
  }

  .timeline__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .timeline__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1.5px solid var(--color-ink);
    z-index: 1;
  }

  .timeline__step--active .timeline__dot {
    background: var(--gradient-accent);
    border-color: transparent;
    animation: dot-pop 0.5s ease 0.6s both;
  }

  .timeline__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .timeline__step--active .timeline__label {
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px 64px;
    }

    .hero__visual {
      padding: 24px;
    }

    .hero__ctas {
      gap: 20px;
    }
  }
</style>
