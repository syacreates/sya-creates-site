---
const titleLine1 = "Je débloque ton produit,";
const titleLine2 = "et j'élimine tes frictions UX.";
const words1 = titleLine1.split(' ');
const words2 = titleLine2.split(' ');

const pitch = [
  { emoji: '🔍', titre: 'Diagnostic UX/UI', texte: 'Identifier ce qui bloque tes utilisateurs' },
  { emoji: '🤝', titre: 'Accompagnement complet', texte: 'Du cadrage à la mise en ligne' },
  { emoji: '⚡', titre: 'Dev IA-assisted', texte: 'Une interface fonctionnelle, vite' },
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <h1 class="hero__title">
      <span class="hero__title-line">
        {words1.map((w, i) => (
          <span class="word-mask"><span class="word-inner" style={`--i: ${i}`}>{w}&nbsp;</span></span>
        ))}
      </span>
      <span class="hero__title-line hero__title-accent">
        {words2.map((w, i) => (
          <span class="word-mask"><span class="word-inner" style={`--i: ${i + words1.length}`}>{w}&nbsp;</span></span>
        ))}
      </span>
    </h1>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <div class="hero__pitch">
      {
        pitch.map((item) => (
          <div class="hero__pitch-item">
            <span class="hero__pitch-emoji emoji-live" aria-hidden="true">{item.emoji}</span>
            <span class="hero__pitch-titre">{item.titre}</span>
            <span class="hero__pitch-texte">{item.texte}</span>
          </div>
        ))
      }
    </div>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__orbfield" aria-hidden="true">
      <span class="hero__nebula"></span>

      <canvas id="hero-cubes" class="hero__cubes"></canvas>

      <span class="hero__chip hero__chip--1">🔍 Discovery</span>
      <span class="hero__chip hero__chip--2">✏️ UX</span>
      <span class="hero__chip hero__chip--3">🎨 UI</span>
      <span class="hero__chip hero__chip--4 hero__chip--active">🚀 Ship</span>
      <span class="hero__chip hero__chip--5">🧩 Design System</span>
      <span class="hero__chip hero__chip--6">🤖 AI-assisted</span>
      <span class="hero__chip hero__chip--7">📈 Strategy</span>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import * as CANNON from 'cannon-es';

  const canvas = document.getElementById('hero-cubes') as HTMLCanvasElement | null;
  const field = canvas?.parentElement;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && field && !prefersReduced) {
    let width = field.clientWidth;
    let height = field.clientHeight;

    // --- Three.js scene, orthographic so 1 unit = 1px ---
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.6);
    const key = new THREE.DirectionalLight(0xffffff, 1.4);
    key.position.set(120, 220, 260);
    scene.add(ambient, key);

    // --- cannon-es world, same pixel-scale units ---
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -900, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);

    const cubeMat = new CANNON.Material('cube');
    const wallMat = new CANNON.Material('wall');
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, wallMat, { friction: 0.4, restitution: 0.18 }));
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, cubeMat, { friction: 0.35, restitution: 0.15 }));

    const depth = Math.min(width, height) * 0.5;

    function makeWall(px: number, py: number, pz: number, hx: number, hy: number, hz: number) {
      const body = new CANNON.Body({ mass: 0, material: wallMat, shape: new CANNON.Box(new CANNON.Vec3(hx, hy, hz)) });
      body.position.set(px, py, pz);
      world.addBody(body);
      return body;
    }

    let floor: CANNON.Body, left: CANNON.Body, right: CANNON.Body, front: CANNON.Body, back: CANNON.Body;

    function layoutWalls() {
      const big = 4000;
      if (floor) [floor, left, right, front, back].forEach((b) => world.removeBody(b));
      floor = makeWall(0, -height / 2, 0, big, 20, big);
      left = makeWall(-width / 2, 0, 0, 20, big, big);
      right = makeWall(width / 2, 0, 0, 20, big, big);
      front = makeWall(0, 0, depth / 2, big, big, 20);
      back = makeWall(0, 0, -depth / 2, big, big, 20);
    }
    layoutWalls();

    // --- Cubes: mostly forest green, one gold accent — palette from the site ---
    const palette = [
      { size: 84, color: 0x3f7a58 },
      { size: 62, color: 0x1f3d2e },
      { size: 70, color: 0x4c8c63 },
      { size: 50, color: 0xd9a854 },
      { size: 58, color: 0x2c5240 },
    ];

    type CubeRig = { mesh: THREE.Mesh; body: CANNON.Body; size: number };
    const cubes: CubeRig[] = [];

    palette.forEach((spec, i) => {
      const geo = new RoundedBoxGeometry(spec.size, spec.size, spec.size, 4, spec.size * 0.14);
      const mat = new THREE.MeshStandardMaterial({
        color: spec.color,
        metalness: 1,
        roughness: 0.22,
        envMapIntensity: 1.3,
      });
      const mesh = new THREE.Mesh(geo, mat);
      scene.add(mesh);

      const half = spec.size / 2;
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.5,
        angularDamping: 0.6,
      });
      body.position.set((Math.random() - 0.5) * width * 0.6, height + 200 + i * 90, (Math.random() - 0.5) * depth * 0.4);
      body.quaternion.setFromEuler((Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI);
      body.angularVelocity.set((Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2);
      // Dropped in staggered by physics-world sleep until its turn — simplest: just delay adding to world.
      cubes.push({ mesh, body, size: spec.size });
    });

    cubes.forEach((c, i) => {
      setTimeout(() => world.addBody(c.body), i * 220);
    });

    // --- Drag to throw ---
    const raycaster = new THREE.Raycaster();
    const pointerNDC = new THREE.Vector2();
    let dragging: CubeRig | null = null;
    let dragPlaneZ = 0;
    let lastWorldPos = new THREE.Vector3();
    let lastMoveTime = 0;
    let throwVelocity = new THREE.Vector3();

    function toNDC(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    }

    function worldOnPlane(z: number) {
      raycaster.setFromCamera(pointerNDC, camera);
      const dir = raycaster.ray.direction;
      const origin = raycaster.ray.origin;
      const t = (z - origin.z) / dir.z;
      return new THREE.Vector3(origin.x + dir.x * t, origin.y + dir.y * t, z);
    }

    canvas.addEventListener('pointerdown', (e) => {
      toNDC(e);
      raycaster.setFromCamera(pointerNDC, camera);
      const hit = raycaster.intersectObjects(cubes.map((c) => c.mesh))[0];
      if (!hit) return;
      dragging = cubes.find((c) => c.mesh === hit.object) || null;
      if (!dragging) return;
      canvas.setPointerCapture(e.pointerId);
      dragPlaneZ = dragging.body.position.z;
      lastWorldPos = worldOnPlane(dragPlaneZ);
      lastMoveTime = performance.now();
      dragging.body.velocity.set(0, 0, 0);
      dragging.body.angularVelocity.set(0, 0, 0);
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      toNDC(e);
      const target = worldOnPlane(dragPlaneZ);
      const now = performance.now();
      const dt = Math.max((now - lastMoveTime) / 1000, 1 / 120);
      throwVelocity.set((target.x - lastWorldPos.x) / dt, (target.y - lastWorldPos.y) / dt, 0);
      dragging.body.position.set(target.x, target.y, dragPlaneZ);
      dragging.body.velocity.set(0, 0, 0);
      lastWorldPos = target;
      lastMoveTime = now;
    });

    function releaseDrag() {
      if (!dragging) return;
      dragging.body.velocity.set(
        THREE.MathUtils.clamp(throwVelocity.x, -1800, 1800),
        THREE.MathUtils.clamp(throwVelocity.y, -1800, 1800),
        0
      );
      dragging = null;
    }
    canvas.addEventListener('pointerup', releaseDrag);
    canvas.addEventListener('pointercancel', releaseDrag);

    // --- Render loop, paused while offscreen ---
    let running = true;
    let rafId = 0;
    let prevTime = performance.now();

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      world.step(1 / 60, dt, 6);
      for (const c of cubes) {
        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);
        c.mesh.quaternion.set(c.body.quaternion.x, c.body.quaternion.y, c.body.quaternion.z, c.body.quaternion.w);
      }
      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !running) {
          running = true;
          prevTime = performance.now();
          rafId = requestAnimationFrame(tick);
        } else if (!visible && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(field);
    rafId = requestAnimationFrame(tick);

    window.addEventListener('resize', () => {
      width = field.clientWidth;
      height = field.clientHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      layoutWalls();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 24px 96px;
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    font-style: italic;
    font-weight: 500;
  }

  /* Apparition mot par mot au chargement — chaque mot glisse depuis son
     propre masque, façon titre animé du site de référence. */
  .word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
  }

  .word-inner {
    display: inline-block;
    opacity: 0;
    transform: translateY(110%);
    animation: word-reveal 0.75s var(--ease-spring) both;
    animation-delay: calc(var(--i, 0) * 65ms + 0.15s);
  }

  .hero__title-accent .word-inner {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes word-reveal {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  /* Rangée "ce que je fais concrètement" — répond dès le premier regard à
     quoi/comment/quoi-concrètement, avant même le CTA. */
  .hero__pitch {
    display: flex;
    gap: 12px;
    margin-top: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__pitch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 172px;
    padding: 16px 14px;
    background: var(--color-glass-strong);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-card-sm);
    box-shadow: var(--shadow-card);
  }

  .hero__pitch-emoji {
    font-size: 1.25rem;
    margin-bottom: 2px;
  }

  .hero__pitch-titre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-ink);
  }

  .hero__pitch-texte {
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
    height: 400px;
    margin-top: 24px;
    perspective: 1200px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  /* Nébuleuse — halo diffus derrière les orbes, pour un fond "espace" */
  .hero__nebula {
    position: absolute;
    inset: -20%;
    z-index: 0;
    background:
      radial-gradient(circle at 30% 35%, rgba(31, 61, 46, 0.22), transparent 55%),
      radial-gradient(circle at 72% 60%, rgba(214, 178, 110, 0.18), transparent 50%),
      radial-gradient(circle at 55% 20%, rgba(76, 140, 99, 0.16), transparent 45%);
    filter: blur(30px);
    animation: float-blob 16s ease-in-out infinite;
    pointer-events: none;
  }

  /* Cubes chromés — scène WebGL (Three.js + cannon-es), voir le <script>
     plus bas. Le canvas occupe la même zone que l'ancien champ d'orbes. */
  .hero__cubes {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .hero__cubes:active {
    cursor: grabbing;
  }

  .hero__chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-ink);
    background: var(--color-glass-strong);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    animation: float-blob 6.5s ease-in-out infinite;
    white-space: nowrap;
  }

  .hero__chip--1 {
    top: 2%;
    left: 40%;
    animation-delay: -2s;
  }

  .hero__chip--2 {
    top: 50%;
    left: 2%;
    animation-duration: 7.5s;
    animation-delay: -4s;
  }

  .hero__chip--3 {
    top: 4%;
    right: 6%;
    animation-duration: 8.5s;
    animation-delay: -1s;
  }

  .hero__chip--4 {
    bottom: 4%;
    right: 32%;
    animation-duration: 6s;
    animation-delay: -3.5s;
  }

  .hero__chip--5 {
    top: 32%;
    right: 2%;
    animation-duration: 9s;
    animation-delay: -2.6s;
  }

  .hero__chip--6 {
    top: 78%;
    left: 26%;
    animation-duration: 7s;
    animation-delay: -1.8s;
  }

  .hero__chip--7 {
    top: 76%;
    left: 4%;
    animation-duration: 8s;
    animation-delay: -4.4s;
  }

  .hero__chip--active {
    background: var(--gradient-accent);
    color: #ffffff;
    border-color: transparent;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px 64px;
    }

    .hero__orbfield {
      height: 360px;
    }

    .hero__chip {
      font-size: 0.75rem;
      padding: 8px 14px;
    }

    .hero__ctas {
      gap: 20px;
    }

    .hero__pitch-item {
      width: calc(50% - 6px);
    }
  }
</style>
