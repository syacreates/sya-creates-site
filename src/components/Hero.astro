---
const titleLine1 = "Je débloque ton produit,";
const titleLine2 = "et j'élimine tes frictions UX.";
const words1 = titleLine1.split(' ');
const words2 = titleLine2.split(' ');

const pitch = [
  { emoji: '🔍', titre: 'Diagnostic UX/UI', texte: 'Identifier ce qui bloque tes utilisateurs' },
  { emoji: '🤝', titre: 'Accompagnement complet', texte: 'Du cadrage à la mise en ligne' },
  { emoji: '⚡', titre: 'Dev IA-assisted', texte: 'Une interface fonctionnelle, vite' },
];

const tags = [
  'Discovery',
  'UX Research',
  'UI Design',
  'Design System',
  'AI-assisted Dev',
  'Fast Shipping',
  'Suivi produit',
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <!-- Cubes chromés (voir <script>) : un canvas plein-hero, pour que la
       chute parte du haut de la page. Elles tombent dans l'ordre et se
       posent de gauche à droite ; le cube or (dernier) reprend l'accent
       visuel que la section Méthode donne déjà à sa dernière étape. Le
       canvas est posé au-dessus du texte, qu'il déborde légèrement en
       tombant, façon elevenses-product.com.
       Interactif au clavier (tabindex + Entrée/Espace relance la pile) :
       affordance réelle plutôt que décorative, donc pas d'aria-hidden. -->
  <canvas
    id="hero-cubes"
    class="hero__cubes"
    tabindex="0"
    role="button"
    aria-label="Cubes chromés interactifs — appuie sur Entrée pour les relancer"
  ></canvas>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <h1 class="hero__title">
      <span class="hero__title-line">
        {words1.map((w, i) => (
          <span class="word-mask"><span class="word-inner" style={`--i: ${i}`}>{w}&nbsp;</span></span>
        ))}
      </span>
      <span class="hero__title-line hero__title-accent">
        {words2.map((w, i) => (
          <span class="word-mask"><span class="word-inner" style={`--i: ${i + words1.length}`}>{w}&nbsp;</span></span>
        ))}
      </span>
    </h1>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <div class="hero__pitch">
      {
        pitch.map((item) => (
          <div
            class="hero__pitch-item flip-card"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label={`${item.titre} — appuie pour voir le détail`}
          >
            <div class="flip-card__inner">
              <div class="flip-card__front">
                <span class="hero__pitch-emoji emoji-live" aria-hidden="true">{item.emoji}</span>
                <span class="hero__pitch-titre">{item.titre}</span>
              </div>
              <div class="flip-card__back">
                <p>{item.texte}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__marquee" role="presentation">
      <div class="hero__marquee-track">
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        {tags.map((tag) => <span class="tag-pill" aria-hidden="true">{tag}</span>)}
      </div>
    </div>

    <div class="hero__orbfield" aria-hidden="true">
      <span class="hero__nebula"></span>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import * as CANNON from 'cannon-es';

  const canvas = document.getElementById('hero-cubes') as HTMLCanvasElement | null;
  const field = canvas?.parentElement;
  const orbfield = document.querySelector('.hero__orbfield') as HTMLElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Sur mobile, la pile de cubes (calée sur la largeur du champ d'orbes,
  // presque plein écran à ces largeurs) recouvre trop le titre pour rester
  // lisible — l'animation ne démarre qu'à partir d'un écran assez large.
  const tooNarrow = window.innerWidth < 700;

  if (canvas && field && orbfield && !prefersReduced && !tooNarrow) {
    let width = field.clientWidth;
    let height = field.clientHeight;

    // --- Three.js scene, orthographic so 1 unit = 1px ---
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.6);
    const key = new THREE.DirectionalLight(0xffffff, 1.4);
    key.position.set(120, 220, 260);
    scene.add(ambient, key);

    // --- cannon-es world, same pixel-scale units ---
    // Gravité adoucie : la chute part maintenant du haut de la page, donc
    // beaucoup plus longue qu'avant — une gravité trop forte rendrait
    // l'atterrissage brutal.
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -680, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);

    const cubeMat = new CANNON.Material('cube');
    const wallMat = new CANNON.Material('wall');
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, wallMat, { friction: 0.4, restitution: 0.18 }));
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, cubeMat, { friction: 0.35, restitution: 0.15 }));

    let depth = Math.min(width, height) * 0.5;

    function makeWall(px: number, py: number, pz: number, hx: number, hy: number, hz: number) {
      const body = new CANNON.Body({ mass: 0, material: wallMat, shape: new CANNON.Box(new CANNON.Vec3(hx, hy, hz)) });
      body.position.set(px, py, pz);
      world.addBody(body);
      return body;
    }

    let floor: CANNON.Body, left: CANNON.Body, right: CANNON.Body, front: CANNON.Body, back: CANNON.Body;

    // Le sol et les murs latéraux sont calés sur la position réelle de
    // .hero__orbfield (le champ d'orbes/chips) — les cubes tombent sur
    // toute la hauteur du hero mais atterrissent pile dans cette zone.
    let laneLeftX = -width / 2;
    let laneRightX = width / 2;
    let floorWorldY = -height / 2;

    function layoutWalls() {
      const heroRect = field!.getBoundingClientRect();
      const orbRect = orbfield!.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      laneLeftX = orbRect.left - centerX;
      laneRightX = orbRect.right - centerX;
      floorWorldY = height / 2 - (orbRect.bottom - heroRect.top);
      depth = Math.min(width, height) * 0.5;

      const big = 4000;
      // Murs latéraux volontairement bas (pas "big") : la pile peut monter
      // jusqu'à cette hauteur, puis les cubes en trop perdent l'équilibre
      // et basculent par-dessus au lieu d'être contenus indéfiniment.
      const wallFillHeight = 420;
      const wallCenterY = floorWorldY + wallFillHeight / 2;
      if (floor) [floor, left, right, front, back].forEach((b) => world.removeBody(b));
      floor = makeWall((laneLeftX + laneRightX) / 2, floorWorldY - 10, 0, (laneRightX - laneLeftX) / 2 + 30, 20, big);
      left = makeWall(laneLeftX - 10, wallCenterY, 0, 20, wallFillHeight / 2, big);
      right = makeWall(laneRightX + 10, wallCenterY, 0, 20, wallFillHeight / 2, big);
      front = makeWall(0, 0, depth / 2, big, big, 20);
      back = makeWall(0, 0, -depth / 2, big, big, 20);
    }
    layoutWalls();

    // --- Borne invisible sur le CTA principal : empêche un cube de se
    // poser dessus et de masquer durablement l'action pendant que la pile
    // s'accumule. (Les chips flottantes ont été retirées du hero — plus de
    // label à protéger de ce côté-là.)
    const protectedEls = Array.from(document.querySelectorAll('.hero__ctas .btn--primary')) as HTMLElement[];
    const uiBumpers = protectedEls.map((el) => {
      const r = el.getBoundingClientRect();
      const body = new CANNON.Body({
        mass: 0,
        material: wallMat,
        // Marge généreuse : un cube en rotation a une silhouette 2D plus
        // large que sa boîte alignée aux axes (jusqu'à ×1.4 en diagonale).
        shape: new CANNON.Box(new CANNON.Vec3(r.width / 2 + 28, r.height / 2 + 28, 60)),
      });
      world.addBody(body);
      return { el, body };
    });

    function updateUiBumpers() {
      const heroRect = field!.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      for (const { el, body } of uiBumpers) {
        const r = el.getBoundingClientRect();
        const x = r.left + r.width / 2 - centerX;
        const screenTopY = r.top + r.height / 2 - heroRect.top;
        body.position.set(x, height / 2 - screenTopY, 0);
      }
    }

    // --- Cubes : quelques étapes-clés de la section Méthode, dans l'ordre
    // — elles tombent et se posent de gauche à droite. Le cube or,
    // dernier, reprend l'accent que la section Méthode donne déjà à sa
    // toute dernière étape. Canvas posé au-dessus du texte, qu'il déborde
    // légèrement en tombant, façon elevenses-product.com.
    const palette = [
      { size: 118, color: 0x3f7a58 }, // 01 Cadrage
      { size: 100, color: 0x4c8c63 }, // 03 Développement IA-assisted
      { size: 72, color: 0xd9a854 }, // 05 Suivi — accent
    ];

    type CubeRig = { mesh: THREE.Mesh; body: CANNON.Body; size: number; age: number };
    const cubes: CubeRig[] = [];
    let spawnCount = 0;

    function spawnCube(spec: { size: number; color: number }, targetX: number) {
      const geo = new RoundedBoxGeometry(spec.size, spec.size, spec.size, 4, spec.size * 0.06);
      const mat = new THREE.MeshStandardMaterial({
        color: spec.color,
        metalness: 1,
        roughness: 0.22,
        envMapIntensity: 1.3,
        transparent: true,
        opacity: 0,
      });
      const mesh = new THREE.Mesh(geo, mat);
      // Arêtes dessinées explicitement : un cube en rotation libre (tumbling
      // sur les 3 axes) traverse des angles où le chrome lisse ne montre
      // aucune arête visible entre deux faces — la silhouette se lit alors
      // comme un losange/rectangle plutôt qu'un cube. Ce trait fin garde les
      // 12 arêtes visibles en permanence, quelle que soit la rotation.
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo, 25),
        new THREE.LineBasicMaterial({ color: 0x1f3d2e, transparent: true, opacity: 0 })
      );
      mesh.add(edges);
      scene.add(mesh);

      const half = spec.size / 2;
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.5,
        angularDamping: 0.6,
      });
      // Départ près du haut du canvas (= haut de la page) plutôt que loin
      // au-dessus, invisible — la chute doit se voir depuis le sommet.
      body.position.set(targetX, height / 2 - 40 - (spawnCount % 6) * 60, (Math.random() - 0.5) * depth * 0.3);
      body.quaternion.setFromEuler((Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI);
      body.angularVelocity.set((Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2);
      spawnCount++;

      const rig: CubeRig = { mesh, body, size: spec.size, age: 0 };
      cubes.push(rig);
      return rig;
    }

    palette.forEach((spec, i) => {
      const t = palette.length > 1 ? i / (palette.length - 1) : 0.5;
      const targetX = laneLeftX + t * (laneRightX - laneLeftX);
      const rig = spawnCube(spec, targetX);
      // Chute séquentielle, une étape après l'autre — comme le process.
      setTimeout(() => world.addBody(rig.body), i * 320);
    });

    // La pile continue de s'alimenter : un nouveau cube tombe régulièrement
    // et vient s'empiler, jusqu'à ce que le tas devienne trop haut pour les
    // murs (voir layoutWalls) et que les cubes en trop basculent et tombent.
    let spawnTimer = 0;
    const SPAWN_INTERVAL = 3.2;

    // --- Drag to throw ---
    const raycaster = new THREE.Raycaster();
    const pointerNDC = new THREE.Vector2();
    let dragging: CubeRig | null = null;
    let dragPlaneZ = 0;
    let lastWorldPos = new THREE.Vector3();
    let lastMoveTime = 0;
    let throwVelocity = new THREE.Vector3();

    function toNDC(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    }

    function worldOnPlane(z: number) {
      raycaster.setFromCamera(pointerNDC, camera);
      const dir = raycaster.ray.direction;
      const origin = raycaster.ray.origin;
      const t = (z - origin.z) / dir.z;
      return new THREE.Vector3(origin.x + dir.x * t, origin.y + dir.y * t, z);
    }

    canvas.addEventListener('pointerdown', (e) => {
      registerInteraction();
      toNDC(e);
      raycaster.setFromCamera(pointerNDC, camera);
      const hit = raycaster.intersectObjects(cubes.map((c) => c.mesh))[0];
      if (!hit) {
        // Le canvas couvre tout le hero (z-index au-dessus du texte) : sans
        // ce relais, aucun clic sur le CTA, les liens ou les cartes flip
        // en dessous n'atteint jamais sa cible réelle.
        canvas!.style.pointerEvents = 'none';
        const under = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
        canvas!.style.pointerEvents = '';
        under?.click();
        return;
      }
      dragging = cubes.find((c) => c.mesh === hit.object) || null;
      if (!dragging) return;
      canvas.setPointerCapture(e.pointerId);
      dragPlaneZ = dragging.body.position.z;
      lastWorldPos = worldOnPlane(dragPlaneZ);
      lastMoveTime = performance.now();
      dragging.body.velocity.set(0, 0, 0);
      dragging.body.angularVelocity.set(0, 0, 0);
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      toNDC(e);
      const target = worldOnPlane(dragPlaneZ);
      const now = performance.now();
      const dt = Math.max((now - lastMoveTime) / 1000, 1 / 120);
      throwVelocity.set((target.x - lastWorldPos.x) / dt, (target.y - lastWorldPos.y) / dt, 0);
      dragging.body.position.set(target.x, target.y, dragPlaneZ);
      dragging.body.velocity.set(0, 0, 0);
      lastWorldPos = target;
      lastMoveTime = now;
    });

    function releaseDrag() {
      if (!dragging) return;
      dragging.body.velocity.set(
        THREE.MathUtils.clamp(throwVelocity.x, -1800, 1800),
        THREE.MathUtils.clamp(throwVelocity.y, -1800, 1800),
        0
      );
      dragging = null;
    }
    canvas.addEventListener('pointerup', releaseDrag);
    canvas.addEventListener('pointercancel', releaseDrag);

    // --- Affordance : personne ne devine spontanément qu'un tas de cubes
    // stabilisé se manipule. Un léger wobble périodique le suggère, sans
    // ajouter le moindre bouton/texte visible en permanence. ---
    let isHovering = false;
    let lastInteraction = performance.now();
    let nextWobbleAt = lastInteraction + 6000 + Math.random() * 2000;

    function registerInteraction() {
      lastInteraction = performance.now();
      nextWobbleAt = lastInteraction + 6000 + Math.random() * 2000;
    }

    canvas.addEventListener('pointerenter', () => {
      isHovering = true;
    });
    canvas.addEventListener('pointerleave', () => {
      isHovering = false;
      registerInteraction();
    });

    function wobbleRandomCube() {
      const settled = cubes.filter((c) => {
        const v = c.body.velocity;
        return Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z) < 8;
      });
      if (settled.length === 0) return;
      const target = settled[Math.floor(Math.random() * settled.length)];
      // Petite secousse angulaire — la friction/l'amortissement existants
      // la font naturellement retomber en 400-600ms, sans script dédié.
      target.body.angularVelocity.set(
        (Math.random() - 0.5) * 3,
        (Math.random() - 0.5) * 1,
        (Math.random() - 0.5) * 3
      );
    }

    // --- Clavier : le canvas est un vrai contrôle (tabindex + role="button"),
    // Entrée/Espace reproduit "faire retomber/relancer" le tas — équivalent
    // clavier de l'interaction souris, pas juste une case cochée pour la forme.
    canvas.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      registerInteraction();
      for (const c of cubes) {
        c.body.velocity.set((Math.random() - 0.5) * 260, 260 + Math.random() * 160, (Math.random() - 0.5) * 120);
        c.body.angularVelocity.set(
          (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 6
        );
      }
    });

    // --- Render loop, paused while offscreen ---
    let running = true;
    let rafId = 0;
    let prevTime = performance.now();

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      updateUiBumpers();
      world.step(1 / 60, dt, 6);

      // Wobble idle : uniquement si personne ne survole/manipule le tas.
      if (!isHovering && now >= nextWobbleAt) {
        wobbleRandomCube();
        nextWobbleAt = now + 6000 + Math.random() * 2000;
      }

      // Nourrit la pile en continu tant que le hero est visible.
      spawnTimer += dt;
      if (spawnTimer > SPAWN_INTERVAL) {
        spawnTimer = 0;
        const spec = palette[spawnCount % palette.length];
        const targetX = laneLeftX + Math.random() * (laneRightX - laneLeftX);
        const rig = spawnCube(spec, targetX);
        world.addBody(rig.body);
      }

      for (let i = cubes.length - 1; i >= 0; i--) {
        const c = cubes[i];
        // Vitesse plafonnée pour éviter qu'un contact multi-corps un peu
        // chaotique (plusieurs cubes qui se tassent en même temps) n'envoie
        // un corps à une vitesse aberrante.
        const v = c.body.velocity;
        const speed = Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
        const maxSpeed = 1400;
        if (speed > maxSpeed) v.scale(maxSpeed / speed, v);
        const av = c.body.angularVelocity;
        const aSpeed = Math.sqrt(av.x * av.x + av.y * av.y + av.z * av.z);
        if (aSpeed > 12) av.scale(12 / aSpeed, av);

        // Un cube qui a basculé par-dessus les murs (pile trop haute) finit
        // par sortir du champ visible — on le retire alors proprement.
        if (
          c.body.position.y < floorWorldY - 900 ||
          c.body.position.x < laneLeftX - 700 ||
          c.body.position.x > laneRightX + 700
        ) {
          world.removeBody(c.body);
          scene.remove(c.mesh);
          c.mesh.geometry.dispose();
          (c.mesh.material as THREE.Material).dispose();
          const edgesToDispose = c.mesh.children[0] as THREE.LineSegments | undefined;
          edgesToDispose?.geometry.dispose();
          (edgesToDispose?.material as THREE.Material | undefined)?.dispose();
          cubes.splice(i, 1);
          continue;
        }

        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);
        c.mesh.quaternion.set(c.body.quaternion.x, c.body.quaternion.y, c.body.quaternion.z, c.body.quaternion.w);

        // Fondu d'apparition — le cube arrive progressivement plutôt que de
        // recouvrir brutalement un label (chip, texte) qu'il traverse.
        c.age += dt;
        const fadeIn = Math.min(c.age / 0.4, 1);
        (c.mesh.material as THREE.MeshStandardMaterial).opacity = fadeIn;
        const edges = c.mesh.children[0] as THREE.LineSegments | undefined;
        if (edges) (edges.material as THREE.LineBasicMaterial).opacity = fadeIn * 0.85;
      }
      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !running) {
          running = true;
          prevTime = performance.now();
          rafId = requestAnimationFrame(tick);
        } else if (!visible && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(field);
    rafId = requestAnimationFrame(tick);

    window.addEventListener('resize', () => {
      width = field.clientWidth;
      height = field.clientHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      layoutWalls();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 24px 96px;
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    font-style: italic;
    font-weight: 500;
  }

  /* Apparition mot par mot au chargement — chaque mot glisse depuis son
     propre masque, façon titre animé du site de référence. */
  .word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
  }

  .word-inner {
    display: inline-block;
    opacity: 0;
    transform: translateY(110%);
