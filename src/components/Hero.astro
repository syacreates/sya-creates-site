---
const titleLine1 = "Je débloque ton produit,";
const titleLine2 = "et j'élimine tes frictions UX.";
const words1 = titleLine1.split(' ');
const words2 = titleLine2.split(' ');

const pitch = [
  { titre: 'Diagnostic UX/UI', texte: 'Identifier ce qui bloque tes utilisateurs' },
  { titre: 'Accompagnement complet', texte: 'Du cadrage à la mise en ligne' },
  { titre: 'Dev IA-assisted', texte: 'Une interface fonctionnelle, vite' },
];

const tags = [
  'Discovery',
  'UX Research',
  'UI Design',
  'Design System',
  'AI-assisted Dev',
  'Fast Shipping',
  'Suivi produit',
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <!-- Cubes chromés (voir <script>) : un canvas plein-hero, pour que la
       chute parte du haut de la page. Elles tombent dans l'ordre et se
       posent de gauche à droite ; le cube or (dernier) reprend l'accent
       visuel que la section Méthode donne déjà à sa dernière étape. Le
       canvas est posé au-dessus du texte, qu'il déborde légèrement en
       tombant, façon elevenses-product.com.
       Interactif au clavier (tabindex + Entrée/Espace relance la pile) :
       affordance réelle plutôt que décorative, donc pas d'aria-hidden. -->
  <canvas
    id="hero-cubes"
    class="hero__cubes"
    tabindex="0"
    role="button"
    aria-label="Cubes chromés interactifs, appuie sur Entrée pour les relancer"
  ></canvas>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <div class="title-flanked title-flanked--hero">
      <span class="title-flanked__line" aria-hidden="true" />
      <h1 class="hero__title">
        <span class="hero__title-line">
          {words1.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i}`}>{w}&nbsp;</span></span>
          ))}
        </span>
        <span class="hero__title-line hero__title-accent">
          {words2.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i + words1.length}`}>{w}&nbsp;</span></span>
          ))}
        </span>
      </h1>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <!-- Cartes simples, retournement au clic via le système .flip-card
         partagé du site (voir Layout.astro). -->
    <div class="hero__pitch">
      {
        pitch.map((item, index) => (
          <div
            class={`hero__pitch-card hero__pitch-card--${index} flip-card`}
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label={`${item.titre}, appuie pour voir le détail`}
          >
            <div class="flip-card__inner">
              <div class="flip-card__front">
                <!-- Mini-cube décoratif : même rendu que le gros cube du
                     hero (couleur, matériau laqué, arêtes), voir le <script>
                     plus bas pour l'initialisation partagée des 3 cartes.
                     aria-hidden : purement décoratif, le clic pour le faire
                     pivoter est un bonus, pas une action à annoncer — le
                     contenu réel de la carte reste le titre/texte au clic. -->
                <canvas class="hero__pitch-cube" aria-hidden="true"></canvas>
                <span class="hero__pitch-card__titre">{item.titre}</span>
              </div>
              <div class="flip-card__back">
                <p>{item.texte}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__marquee" role="presentation">
      <div class="hero__marquee-track">
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        {tags.map((tag) => <span class="tag-pill" aria-hidden="true">{tag}</span>)}
      </div>
    </div>

    <div class="hero__orbfield" aria-hidden="true">
      <span class="hero__nebula"></span>
      <span class="hero__floor"></span>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-cubes') as HTMLCanvasElement | null;
  const field = canvas?.parentElement;
  const orbfield = document.querySelector('.hero__orbfield') as HTMLElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Sur mobile, la pile de cubes (calée sur la largeur du champ d'orbes,
  // presque plein écran à ces largeurs) recouvre trop le titre pour rester
  // lisible — l'animation ne démarre qu'à partir d'un écran assez large.
  const tooNarrow = window.innerWidth < 700;

  if (canvas && field && orbfield && !prefersReduced && !tooNarrow) {
    // Three.js/cannon-es chargés à la demande (voir IntroOverlay.astro pour
    // le détail de la mesure Lighthouse qui a motivé ce changement) — pas
    // en import statique qui alourdirait le bundle initial de la page.
    void (async () => {
    // RoundedBoxGeometry retirée : BoxGeometry, seule à définir nativement
    // 6 groupes de matériaux (un par face), nécessaire pour imprimer un
    // texte différent sur chaque face du cube.
    const [THREE, { RoomEnvironment }, CANNON] = await Promise.all([
      import('three'),
      import('three/examples/jsm/environments/RoomEnvironment.js'),
      import('cannon-es'),
    ]);

    let width = field.clientWidth;
    let height = field.clientHeight;

    // --- Three.js scene, orthographic so 1 unit = 1px ---
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.6);
    const key = new THREE.DirectionalLight(0xffffff, 1.4);
    key.position.set(120, 220, 260);
    scene.add(ambient, key);

    // --- cannon-es world, same pixel-scale units ---
    // Gravité adoucie : la chute part maintenant du haut de la page, donc
    // beaucoup plus longue qu'avant — une gravité trop forte rendrait
    // l'atterrissage brutal.
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -680, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);

    const cubeMat = new CANNON.Material('cube');
    const wallMat = new CANNON.Material('wall');
    // Friction basse : quand on attrape un cube à la souris, ses voisins
    // glissent et basculent facilement au lieu de rester figés en pile.
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, wallMat, { friction: 0.18, restitution: 0.18 }));
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, cubeMat, { friction: 0.12, restitution: 0.15 }));

    let depth = Math.min(width, height) * 0.5;

    function makeWall(px: number, py: number, pz: number, hx: number, hy: number, hz: number) {
      const body = new CANNON.Body({ mass: 0, material: wallMat, shape: new CANNON.Box(new CANNON.Vec3(hx, hy, hz)) });
      body.position.set(px, py, pz);
      world.addBody(body);
      return body;
    }

    let floor: CANNON.Body, left: CANNON.Body, right: CANNON.Body, front: CANNON.Body, back: CANNON.Body;

    // Le sol et les murs latéraux sont calés sur la position réelle de
    // .hero__orbfield (le champ d'orbes/chips) — les cubes tombent sur
    // toute la hauteur du hero mais atterrissent pile dans cette zone.
    let laneLeftX = -width / 2;
    let laneRightX = width / 2;
    let floorWorldY = -height / 2;

    function layoutWalls() {
      const heroRect = field!.getBoundingClientRect();
      const orbRect = orbfield!.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      laneLeftX = orbRect.left - centerX;
      laneRightX = orbRect.right - centerX;
      floorWorldY = height / 2 - (orbRect.bottom - heroRect.top);
      depth = Math.min(width, height) * 0.5;

      const big = 4000;
      // Murs latéraux volontairement bas (pas "big") : la pile peut monter
      // jusqu'à cette hauteur, puis les cubes en trop perdent l'équilibre
      // et basculent par-dessus au lieu d'être contenus indéfiniment.
      // Proportionnel à la hauteur réelle de .hero__orbfield (pas une
      // constante en dur) : la pile reste toujours contenue DANS le champ
      // d'orbes, elle ne peut plus dépasser vers le haut et venir se coller
      // sur le ruban de tags ou les cartes au-dessus.
      const wallFillHeight = orbRect.height * 0.8;
      const wallCenterY = floorWorldY + wallFillHeight / 2;
      if (floor) [floor, left, right, front, back].forEach((b) => world.removeBody(b));
      floor = makeWall((laneLeftX + laneRightX) / 2, floorWorldY - 10, 0, (laneRightX - laneLeftX) / 2 + 30, 20, big);
      left = makeWall(laneLeftX - 10, wallCenterY, 0, 20, wallFillHeight / 2, big);
      right = makeWall(laneRightX + 10, wallCenterY, 0, 20, wallFillHeight / 2, big);
      front = makeWall(0, 0, depth / 2, big, big, 20);
      back = makeWall(0, 0, -depth / 2, big, big, 20);
    }
    layoutWalls();

    // --- Borne invisible sur le CTA principal : empêche un cube de se
    // poser dessus et de masquer durablement l'action pendant que la pile
    // s'accumule. (Les chips flottantes ont été retirées du hero — plus de
    // label à protéger de ce côté-là.)
    const protectedEls = Array.from(document.querySelectorAll('.hero__ctas .btn--primary')) as HTMLElement[];
    const uiBumpers = protectedEls.map((el) => {
      const r = el.getBoundingClientRect();
      const body = new CANNON.Body({
        mass: 0,
        material: wallMat,
        // Marge généreuse : un cube en rotation a une silhouette 2D plus
        // large que sa boîte alignée aux axes (jusqu'à ×1.4 en diagonale).
        shape: new CANNON.Box(new CANNON.Vec3(r.width / 2 + 28, r.height / 2 + 28, 60)),
      });
      world.addBody(body);
      return { el, body };
    });

    function updateUiBumpers() {
      const heroRect = field!.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      for (const { el, body } of uiBumpers) {
        const r = el.getBoundingClientRect();
        const x = r.left + r.width / 2 - centerX;
        const screenTopY = r.top + r.height / 2 - heroRect.top;
        body.position.set(x, height / 2 - screenTopY, 0);
      }
    }

    // --- Cube : un seul, gros, plutôt qu'une pile qui s'alimente en
    // continu — plus simple, plus impactant, et ça élimine tout le
    // problème de pile qui grossit et vient chevaucher le contenu au-dessus
    // (tags, CTA). Canvas posé au-dessus du texte, qu'il déborde légèrement
    // en tombant, façon elevenses-product.com.
    const palette = [{ size: 170, color: 0x7fc4a0 }];

    type CubeRig = { mesh: THREE.Mesh; body: CANNON.Body; size: number; age: number };
    const cubes: CubeRig[] = [];
    let spawnCount = 0;

    // Étapes de la méthode imprimées sur les 4 faces latérales du cube
    // (haut/bas restent unies — rarement face caméra une fois la pile
    // posée à plat au sol, et jamais visibles pendant qu'il roule dessus).
    const faceLabels = ['Comprendre le besoin', 'Parcours clair', 'Interface soignée', 'Testé et validé'];

    function makeFaceTexture(text: string, bgHex: number) {
      const size = 512;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d')!;
      ctx.fillStyle = `#${bgHex.toString(16).padStart(6, '0')}`;
      ctx.fillRect(0, 0, size, size);

      if (text) {
        ctx.fillStyle = '#16241c';
        ctx.font = "600 46px 'Fraunces', Georgia, serif";
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        // Retour à la ligne simple par mot, centré verticalement selon le
        // nombre de lignes obtenues.
        const words = text.split(' ');
        const maxWidth = size * 0.78;
        const lines: string[] = [];
        let line = '';
        for (const word of words) {
          const test = line ? `${line} ${word}` : word;
          if (ctx.measureText(test).width > maxWidth && line) {
            lines.push(line);
            line = word;
          } else {
            line = test;
          }
        }
        if (line) lines.push(line);

        const lineHeight = 58;
        const startY = size / 2 - ((lines.length - 1) * lineHeight) / 2;
        lines.forEach((l, i) => ctx.fillText(l, size / 2, startY + i * lineHeight));
      }

      const texture = new THREE.CanvasTexture(canvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      return texture;
    }

    function spawnCube(spec: { size: number; color: number }, targetX: number) {
      const geo = new THREE.BoxGeometry(spec.size, spec.size, spec.size);
      // Ordre des groupes de BoxGeometry : +x, -x, +y, -y, +z, -z
      // (droite, gauche, haut, bas, avant, arrière). Haut/bas restent unies.
      // Les 4 faces latérales sont réparties pour qu'une rotation de +90°
      // autour de Y, répétée à chaque clic à partir de la pose neutre
      // (identité, +z face caméra), les amène dans l'ordre exact 1→2→3→4 :
      // +z (0°) → -x (90°) → -z (180°) → +x (270°).
      const faceOrder: (string | null)[] = [
        faceLabels[3],
        faceLabels[1],
        null,
        null,
        faceLabels[0],
        faceLabels[2],
      ];
      const materials = faceOrder.map((label) => {
        const texture = label ? makeFaceTexture(label, spec.color) : null;
        return new THREE.MeshPhysicalMaterial({
          color: spec.color,
          map: texture,
          // Fini satiné + couche vernie (clearcoat) : brillant et
          // dimensionnel façon laque, sans le mirroir plein-chrome qui
          // écraserait le texte imprimé sous des reflets illisibles.
          metalness: 0.45,
          roughness: 0.32,
          envMapIntensity: 1.4,
          clearcoat: 0.7,
          clearcoatRoughness: 0.15,
          transparent: true,
          opacity: 0,
        });
      });
      const mesh = new THREE.Mesh(geo, materials);
      // Arêtes dessinées explicitement : un cube en rotation libre (tumbling
      // sur les 3 axes) traverse des angles où le fini satiné ne montre
      // aucune arête visible entre deux faces — la silhouette se lit alors
      // comme un losange/rectangle plutôt qu'un cube. Ce trait fin garde les
      // 12 arêtes visibles en permanence, quelle que soit la rotation.
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo, 25),
        // Arête sombre (sapin profond) : le cube unique est maintenant une
        // teinte claire, une arête de la même couleur s'y fondrait — un
        // contour sombre marque nettement chaque face quel que soit l'angle.
        new THREE.LineBasicMaterial({ color: 0x1e3d2f, transparent: true, opacity: 0 })
      );
      mesh.add(edges);
      scene.add(mesh);

      const half = spec.size / 2;
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.25,
        angularDamping: 0.3,
      });
      // Départ près du haut du canvas (= haut de la page) plutôt que loin
      // au-dessus, invisible — la chute doit se voir depuis le sommet.
      body.position.set(targetX, height / 2 - 40 - (spawnCount % 6) * 60, (Math.random() - 0.5) * depth * 0.3);
      body.quaternion.setFromEuler((Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI, (Math.random() - 0.5) * Math.PI);
      body.angularVelocity.set((Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2, (Math.random() - 0.5) * 2);
      spawnCount++;

      const rig: CubeRig = { mesh, body, size: spec.size, age: 0 };
      cubes.push(rig);
      return rig;
    }

    const rig = spawnCube(palette[0], (laneLeftX + laneRightX) / 2);
    world.addBody(rig.body);

    // --- Drag to throw ---
    const raycaster = new THREE.Raycaster();
    const pointerNDC = new THREE.Vector2();
    let dragging: CubeRig | null = null;
    let dragPlaneZ = 0;
    let lastWorldPos = new THREE.Vector3();
    let lastMoveTime = 0;
    let throwVelocity = new THREE.Vector3();

    // --- Clic pour faire pivoter la face affichée ---
    // Un vrai clic (peu de mouvement, relâché vite) sur le cube fait
    // pivoter la face visible d'un quart de tour plutôt que de le
    // lancer — un clic sans mouvement n'est pas une intention de lancer.
    let pointerDownAt = 0;
    let pointerDownX = 0;
    let pointerDownY = 0;
    let totalMoveDist = 0;
    const CLICK_MAX_DIST = 6;
    const CLICK_MAX_MS = 350;

    let faceAnimating: CubeRig | null = null;
    let faceStage = 0;
    const faceAnimFrom = new THREE.Quaternion();
    const faceAnimTo = new THREE.Quaternion();
    let faceAnimStart = 0;
    const FACE_ANIM_MS = 500;
    // Légère bascule permanente : sans elle, une face pile perpendiculaire à
    // la caméra orthographique se lit comme un carré plat, pas comme un
    // cube — ce tilt garde le dessus et une tranche latérale visibles en
    // permanence, quelle que soit la face affichée.
    const CUBE_TILT = new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.32, 0, 0.14));
    let hasAutoPosed = false;

    function goToFaceStage(rig: CubeRig, stage: number) {
      faceStage = stage;
      faceAnimFrom.copy(rig.mesh.quaternion);
      faceAnimTo.setFromAxisAngle(new THREE.Vector3(0, 1, 0), faceStage * (Math.PI / 2));
      faceAnimTo.premultiply(CUBE_TILT);
      faceAnimStart = performance.now();
      faceAnimating = rig;
      rig.body.angularVelocity.set(0, 0, 0);
      rig.body.velocity.set(0, 0, 0);
    }

    function turnToNextFace(rig: CubeRig) {
      goToFaceStage(rig, (faceStage + 1) % 4);
    }

    function toNDC(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    }

    function worldOnPlane(z: number) {
      raycaster.setFromCamera(pointerNDC, camera);
      const dir = raycaster.ray.direction;
      const origin = raycaster.ray.origin;
      const t = (z - origin.z) / dir.z;
      return new THREE.Vector3(origin.x + dir.x * t, origin.y + dir.y * t, z);
    }

    canvas.addEventListener('pointerdown', (e) => {
      registerInteraction();
      toNDC(e);
      raycaster.setFromCamera(pointerNDC, camera);
      const hit = raycaster.intersectObjects(cubes.map((c) => c.mesh))[0];
      if (!hit) {
        // Le canvas couvre tout le hero (z-index au-dessus du texte) : sans
        // ce relais, aucun clic sur le CTA, les liens ou les cartes flip
        // en dessous n'atteint jamais sa cible réelle.
        canvas!.style.pointerEvents = 'none';
        const under = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
        canvas!.style.pointerEvents = '';
        under?.click();
        return;
      }
      dragging = cubes.find((c) => c.mesh === hit.object) || null;
      if (!dragging) return;
      canvas.setPointerCapture(e.pointerId);
      dragPlaneZ = dragging.body.position.z;
      lastWorldPos = worldOnPlane(dragPlaneZ);
      lastMoveTime = performance.now();
      dragging.body.velocity.set(0, 0, 0);
      dragging.body.angularVelocity.set(0, 0, 0);
      pointerDownAt = performance.now();
      pointerDownX = e.clientX;
      pointerDownY = e.clientY;
      totalMoveDist = 0;
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      totalMoveDist = Math.max(
        totalMoveDist,
        Math.hypot(e.clientX - pointerDownX, e.clientY - pointerDownY)
      );
      toNDC(e);
      const target = worldOnPlane(dragPlaneZ);
      const now = performance.now();
      const dt = Math.max((now - lastMoveTime) / 1000, 1 / 120);
      throwVelocity.set((target.x - lastWorldPos.x) / dt, (target.y - lastWorldPos.y) / dt, 0);
      dragging.body.position.set(target.x, target.y, dragPlaneZ);
      dragging.body.velocity.set(0, 0, 0);
      lastWorldPos = target;
      lastMoveTime = now;
    });

    function releaseDrag() {
      if (!dragging) return;
      const wasClick =
        totalMoveDist < CLICK_MAX_DIST && performance.now() - pointerDownAt < CLICK_MAX_MS;
      if (wasClick) {
        turnToNextFace(dragging);
      } else {
        dragging.body.velocity.set(
          THREE.MathUtils.clamp(throwVelocity.x, -1800, 1800),
          THREE.MathUtils.clamp(throwVelocity.y, -1800, 1800),
          0
        );
      }
      dragging = null;
    }
    canvas.addEventListener('pointerup', releaseDrag);
    canvas.addEventListener('pointercancel', releaseDrag);

    // --- Affordance : personne ne devine spontanément qu'un tas de cubes
    // stabilisé se manipule. Un léger wobble périodique le suggère, sans
    // ajouter le moindre bouton/texte visible en permanence. ---
    let isHovering = false;
    let lastInteraction = performance.now();
    let nextWobbleAt = lastInteraction + 6000 + Math.random() * 2000;

    function registerInteraction() {
      lastInteraction = performance.now();
      nextWobbleAt = lastInteraction + 6000 + Math.random() * 2000;
    }

    canvas.addEventListener('pointerenter', () => {
      isHovering = true;
    });
    canvas.addEventListener('pointerleave', () => {
      isHovering = false;
      registerInteraction();
    });

    function wobbleRandomCube() {
      const settled = cubes.filter((c) => {
        const v = c.body.velocity;
        return Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z) < 8;
      });
      if (settled.length === 0) return;
      const target = settled[Math.floor(Math.random() * settled.length)];
      // Petite secousse angulaire — la friction/l'amortissement existants
      // la font naturellement retomber en 400-600ms, sans script dédié.
      target.body.angularVelocity.set(
        (Math.random() - 0.5) * 3,
        (Math.random() - 0.5) * 1,
        (Math.random() - 0.5) * 3
      );
    }

    // --- Clavier : le canvas est un vrai contrôle (tabindex + role="button"),
    // Entrée/Espace reproduit "faire retomber/relancer" le tas — équivalent
    // clavier de l'interaction souris, pas juste une case cochée pour la forme.
    canvas.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      registerInteraction();
      for (const c of cubes) {
        c.body.velocity.set((Math.random() - 0.5) * 260, 260 + Math.random() * 160, (Math.random() - 0.5) * 120);
        c.body.angularVelocity.set(
          (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 6
        );
      }
    });

    // --- Render loop, paused while offscreen ---
    let running = true;
    let rafId = 0;
    let prevTime = performance.now();

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      updateUiBumpers();
      world.step(1 / 60, dt, 6);

      // Wobble idle : uniquement si personne ne survole/manipule le tas.
      if (!isHovering && now >= nextWobbleAt) {
        wobbleRandomCube();
        nextWobbleAt = now + 6000 + Math.random() * 2000;
      }

      for (let i = cubes.length - 1; i >= 0; i--) {
        const c = cubes[i];
        // Vitesse plafonnée pour éviter qu'un contact multi-corps un peu
        // chaotique (plusieurs cubes qui se tassent en même temps) n'envoie
        // un corps à une vitesse aberrante.
        const v = c.body.velocity;
        const speed = Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
        const maxSpeed = 1400;
        if (speed > maxSpeed) v.scale(maxSpeed / speed, v);
        const av = c.body.angularVelocity;
        const aSpeed = Math.sqrt(av.x * av.x + av.y * av.y + av.z * av.z);
        if (aSpeed > 12) av.scale(12 / aSpeed, av);

        // Dès que la chute initiale se stabilise, on bascule une seule fois
        // vers la pose nette (face 1 + léger tilt) plutôt que de laisser le
        // cube posé à l'orientation aléatoire où la physique l'a arrêté.
        if (!hasAutoPosed && !faceAnimating && speed < 15 && aSpeed < 0.3) {
          hasAutoPosed = true;
          goToFaceStage(c, 0);
        }

        // Un cube peut se stabiliser sur la borne invisible du CTA (plateforme
        // isolée, sans mur latéral pour le faire basculer) et y rester bloqué
        // indéfiniment au lieu de retomber dans la pile. Tant qu'il est
        // presque immobile au-dessus de cette borne, une petite poussée
        // latérale aléatoire l'empêche de s'y stabiliser.
        for (const { body: bumperBody } of uiBumpers) {
          const bumperTopY = bumperBody.position.y + 55;
          if (c.body.position.y > bumperTopY - 40 && speed < 20) {
            c.body.velocity.x += (Math.random() - 0.5) * 260;
            c.body.velocity.z += (Math.random() - 0.5) * 100;
            c.body.angularVelocity.y += (Math.random() - 0.5) * 4;
            break;
          }
        }

        // Un cube qui a basculé par-dessus les murs (pile trop haute) finit
        // par sortir du champ visible — on le retire alors proprement.
        if (
          c.body.position.y < floorWorldY - 900 ||
          c.body.position.x < laneLeftX - 700 ||
          c.body.position.x > laneRightX + 700
        ) {
          world.removeBody(c.body);
          scene.remove(c.mesh);
          c.mesh.geometry.dispose();
          // Un matériau par face (texte imprimé sur 4 des 6) — chacun avec
          // sa propre texture canvas à libérer, pas un matériau unique.
          for (const m of Array.isArray(c.mesh.material) ? c.mesh.material : [c.mesh.material]) {
            (m as THREE.MeshStandardMaterial).map?.dispose();
            m.dispose();
          }
          const edgesToDispose = c.mesh.children[0] as THREE.LineSegments | undefined;
          edgesToDispose?.geometry.dispose();
          (edgesToDispose?.material as THREE.Material | undefined)?.dispose();
          cubes.splice(i, 1);
          continue;
        }

        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);
        if (faceAnimating === c) {
          // Rotation pilotée par l'animation de clic plutôt que par la
          // physique le temps du quart de tour, pour un mouvement net et
          // prévisible plutôt qu'un roulement aléatoire.
          const t = Math.min((performance.now() - faceAnimStart) / FACE_ANIM_MS, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          c.mesh.quaternion.slerpQuaternions(faceAnimFrom, faceAnimTo, eased);
          if (t >= 1) {
            c.body.quaternion.set(c.mesh.quaternion.x, c.mesh.quaternion.y, c.mesh.quaternion.z, c.mesh.quaternion.w);
            faceAnimating = null;
          }
        } else {
          c.mesh.quaternion.set(c.body.quaternion.x, c.body.quaternion.y, c.body.quaternion.z, c.body.quaternion.w);
        }

        // Fondu d'apparition — le cube arrive progressivement plutôt que de
        // recouvrir brutalement un label (chip, texte) qu'il traverse.
        c.age += dt;
        const fadeIn = Math.min(c.age / 0.4, 1);
        for (const m of Array.isArray(c.mesh.material) ? c.mesh.material : [c.mesh.material]) {
          (m as THREE.MeshStandardMaterial).opacity = fadeIn;
        }
        const edges = c.mesh.children[0] as THREE.LineSegments | undefined;
        if (edges) (edges.material as THREE.LineBasicMaterial).opacity = fadeIn * 0.85;
      }
      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !running) {
          running = true;
          prevTime = performance.now();
          rafId = requestAnimationFrame(tick);
        } else if (!visible && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(field);
    rafId = requestAnimationFrame(tick);

    window.addEventListener('resize', () => {
      width = field.clientWidth;
      height = field.clientHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      layoutWalls();
    });
    })();
  }

  // --- Mini-cubes des 3 cartes pitch : même cube que celui du hero
  // (couleur, matériau laqué, style d'arêtes copiés tels quels), mais
  // statique — pas de monde physique, juste un pivot d'un quart de tour
  // par clic. Indépendant du bloc au-dessus : doit fonctionner même sur
  // mobile/écran étroit, là où le gros cube qui tombe est désactivé.
  const pitchCanvases = Array.from(
    document.querySelectorAll<HTMLCanvasElement>('.hero__pitch-cube')
  );
  const prefersReducedPitch = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (pitchCanvases.length) {
    void (async () => {
      const [THREE, { RoomEnvironment }] = await Promise.all([
        import('three'),
        import('three/examples/jsm/environments/RoomEnvironment.js'),
      ]);

      // Valeurs copiées du cube principal (voir plus haut) plutôt que
      // redéfinies séparément, pour un rendu identique.
      const CUBE_COLOR = 0x7fc4a0;
      const EDGE_COLOR = 0x1e3d2f;
      const CUBE_TILT = new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.32, 0, 0.14));
      const Y_AXIS = new THREE.Vector3(0, 1, 0);
      const ROTATE_MS = 650;

      type MiniCube = {
        mesh: THREE.Mesh;
        renderer: THREE.WebGLRenderer;
        scene: THREE.Scene;
        camera: THREE.OrthographicCamera;
        stage: number;
        animFrom: THREE.Quaternion;
        animTo: THREE.Quaternion;
        animStart: number;
        animating: boolean;
      };

      const minis: MiniCube[] = [];
      let rafId = 0;

      // Le cube du hero doit sa couleur nette au fait que ses faces
      // portent une texture (fond uni + texte) : color × map se multiplient,
      // ce qui sature le vert. Une face sans texture (juste `color`) rend
      // beaucoup plus pâle sous cet éclairage — sans cette même texture ici,
      // les mini-cubes auraient l'air délavés/blanchâtres au lieu d'être
      // identiques au cube source. Un simple aplat, sans texte.
      const flatCanvas = document.createElement('canvas');
      flatCanvas.width = flatCanvas.height = 64;
      const flatCtx = flatCanvas.getContext('2d')!;
      flatCtx.fillStyle = `#${CUBE_COLOR.toString(16).padStart(6, '0')}`;
      flatCtx.fillRect(0, 0, 64, 64);
      const flatTexture = new THREE.CanvasTexture(flatCanvas);
      flatTexture.colorSpace = THREE.SRGBColorSpace;

      function tick() {
        const now = performance.now();
        let anyAnimating = false;
        for (const mini of minis) {
          if (!mini.animating) continue;
          anyAnimating = true;
          const t = Math.min((now - mini.animStart) / ROTATE_MS, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          mini.mesh.quaternion.slerpQuaternions(mini.animFrom, mini.animTo, eased);
          if (t >= 1) mini.animating = false;
          mini.renderer.render(mini.scene, mini.camera);
        }
        rafId = anyAnimating ? requestAnimationFrame(tick) : 0;
      }

      for (const canvas of pitchCanvases) {
        const size = canvas.clientWidth || 48;
        const scene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-size / 2, size / 2, size / 2, -size / 2, 1, 2000);
        camera.position.z = 700;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(size, size, false);

        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

        // Éclairage adouci par rapport au cube du hero (0.6/1.4) : sur une
        // face pleine sans texte imprimé pour l'assombrir, le même réglage
        // sature le vert pastel en blanc — même matériau, même arêtes, mais
        // un éclairage recalibré pour qu'il reste lisible en vert à cette
        // taille.
        scene.add(new THREE.AmbientLight(0xffffff, 0.75));
        const key = new THREE.DirectionalLight(0xffffff, 0.55);
        key.position.set(120, 220, 260);
        scene.add(key);

        const cubeSize = size * 0.72;
        const geo = new THREE.BoxGeometry(cubeSize, cubeSize, cubeSize);
        const material = new THREE.MeshPhysicalMaterial({
          color: CUBE_COLOR,
          map: flatTexture,
          metalness: 0.45,
          roughness: 0.32,
          envMapIntensity: 1.4,
          clearcoat: 0.7,
          clearcoatRoughness: 0.15,
        });
        const mesh = new THREE.Mesh(geo, material);
        mesh.quaternion.copy(CUBE_TILT);
        const edges = new THREE.LineSegments(
          new THREE.EdgesGeometry(geo, 25),
          new THREE.LineBasicMaterial({ color: EDGE_COLOR })
        );
        mesh.add(edges);
        scene.add(mesh);
        renderer.render(scene, camera);

        const mini: MiniCube = {
          mesh,
          renderer,
          scene,
          camera,
          stage: 0,
          animFrom: new THREE.Quaternion(),
          animTo: new THREE.Quaternion(),
          animStart: 0,
          animating: false,
        };
        minis.push(mini);

        // stopPropagation : le canvas vit dans une carte .flip-card qui se
        // retourne au clic — sans ça, faire pivoter le cube retournerait
        // aussi la carte en dessous à chaque fois.
        canvas.addEventListener('pointerdown', (e) => e.stopPropagation());
        canvas.addEventListener('click', (e) => {
          e.stopPropagation();
          mini.stage += 1;
          const target = new THREE.Quaternion()
            .setFromAxisAngle(Y_AXIS, mini.stage * (Math.PI / 2))
            .premultiply(CUBE_TILT);
          if (prefersReducedPitch) {
            mini.mesh.quaternion.copy(target);
            mini.renderer.render(mini.scene, mini.camera);
            return;
          }
          mini.animFrom.copy(mini.mesh.quaternion);
          mini.animTo.copy(target);
          mini.animStart = performance.now();
          mini.animating = true;
          if (!rafId) rafId = requestAnimationFrame(tick);
        });
      }
    })();
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 24px var(--section-py);
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    font-style: italic;
    font-weight: 500;
  }

  /* Traits volontairement courts : le titre du hero occupe déjà toute la
     largeur utile de .hero__inner (780px) — des traits plus longs lui
     voleraient assez de place pour casser sa mise en ligne habituelle
     ("Je débloque ton produit," passerait sur deux lignes). */
  .title-flanked--hero {
    gap: 16px;
    align-items: center;
  }

  .title-flanked--hero .title-flanked__line {
    width: 32px;
  }

  @media (max-width: 640px) {
    .title-flanked--hero .title-flanked__line {
      width: 18px;
    }
  }

  /* Apparition mot par mot au chargement — chaque mot glisse depuis son
     propre masque, façon titre animé du site de référence. */
  .word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
  }

  .word-inner {
    display: inline-block;
    opacity: 0;
    transform: translateY(110%);
    animation: word-reveal 0.75s var(--ease-spring) both;
    animation-delay: calc(var(--i, 0) * 65ms + 0.15s);
  }

  .hero__title-accent .word-inner {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes word-reveal {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  /* Rangée "ce que je fais concrètement" — répond dès le premier regard à
     quoi/comment/quoi-concrètement, avant même le CTA. Cartes qui se
     retournent sur elles-mêmes au clic — système .flip-card partagé du
     site (voir Layout.astro pour le comportement clic/clavier, et
     global.css pour le fallback prefers-reduced-motion). */
  .hero__pitch {
    display: flex;
    align-items: center;
    margin-top: 16px;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__pitch-card {
    width: 190px;
    /* +26px vs la version sans cube, pour laisser la place au mini-cube
       au-dessus du titre sans tasser le texte. */
    height: 138px;
    position: relative;
    z-index: 1;
    border-radius: 16px;
    filter: drop-shadow(0 12px 26px rgba(22, 36, 28, 0.28));
    transition: filter 0.3s ease;
  }

  .hero__pitch-card--0 .flip-card__front,
  .hero__pitch-card--0 .flip-card__back {
    background: var(--color-accent);
  }

  .hero__pitch-card--1 .flip-card__front,
  .hero__pitch-card--1 .flip-card__back {
    background: var(--color-accent-2);
  }

  .hero__pitch-card--2 .flip-card__front,
  .hero__pitch-card--2 .flip-card__back {
    /* 3e teinte de la même famille sapin (pas d'or) : la plus claire, pour
       un dégradé à 3 niveaux plutôt qu'une 2e carte de la même couleur. */
    background: #7fc4a0;
  }

  .hero__pitch-card--2 .hero__pitch-card__titre,
  .hero__pitch-card--2 .flip-card__back p {
    /* Fond clair : texte sombre plutôt que blanc pour rester lisible
       (contraste AA — le blanc y tombe à ~2:1). */
    color: var(--color-bg);
  }

  .hero__pitch-card:hover,
  .hero__pitch-card:focus-visible {
    filter: drop-shadow(0 18px 34px rgba(22, 36, 28, 0.38));
    z-index: 2;
  }

  .hero__pitch-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .hero__pitch-card .flip-card__front,
  .hero__pitch-card .flip-card__back {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 24px;
  }

  /* Taille fixe (pas de media query dessus) : le cube garde la même
     taille/position sur les 3 cartes, à toutes les largeurs. */
  .hero__pitch-cube {
    width: 48px;
    height: 48px;
    cursor: pointer;
    /* Touch target confortable (>=44px recommandé) malgré un rendu visuel
       de 48px déjà suffisant — pas de padding invisible nécessaire ici. */
    touch-action: manipulation;
  }

  .hero__pitch-card__titre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: #ffffff;
    text-align: center;
  }

  .hero__pitch-card .flip-card__back p {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #ffffff;
    margin: 0;
    text-align: center;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
    height: 400px;
    margin-top: 24px;
    perspective: 1200px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  /* Nébuleuse — halo diffus derrière les orbes, pour un fond "espace" */
  .hero__nebula {
    position: absolute;
    inset: -20%;
    z-index: 0;
    /* Le vert foncé est calé à 86% (pas 35%) pour retomber exactement sur
       .hero__floor, au même endroit que la ligne où atterrissent les
       cubes — un seul repère vert foncé, pas deux zones désalignées. */
    background:
      radial-gradient(circle at 30% 86%, rgba(31, 61, 46, 0.22), transparent 55%),
      radial-gradient(circle at 72% 60%, rgba(214, 178, 110, 0.18), transparent 50%),
      radial-gradient(circle at 55% 20%, rgba(76, 140, 99, 0.16), transparent 45%);
    filter: blur(30px);
    animation: float-blob 16s ease-in-out infinite;
    pointer-events: none;
  }

  /* Sol : flaque vert foncé floutée au pied du champ d'orbes, là où les
     cubes atterrissent — ancre visuellement la pile au lieu de la laisser
     flotter sur le fond crème. Centrée exactement sur le bord bas de
     .hero__orbfield (bottom: -moitié de la hauteur) : c'est précisément la
     ligne où repose le sol physique en JS (floorWorldY, calé sur ce même
     bord), donc les cubes touchent vraiment le trait, pas un flou décalé
     au-dessus. */
  .hero__floor {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -30px;
    height: 60px;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(22, 36, 28, 0.55), transparent 70%);
    filter: blur(18px);
    pointer-events: none;
  }

  /* Cubes chromés — scène WebGL (Three.js + cannon-es), voir le <script>
     plus bas. Le canvas couvre tout le hero (chute depuis le haut de la
     page) ; le sol physique est calé en JS sur le bas de .hero__orbfield,
     pour que les cubes atterrissent visuellement dans le champ d'orbes.
     Posé au-dessus du texte, qu'il déborde légèrement en tombant/en
     atterrissant, façon elevenses-product.com. */
  .hero__cubes {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    /* pan-y (pas none) : le canvas couvre tout le hero, donc "none"
       empêcherait le scroll vertical natif dès qu'on touche cette zone
       sur mobile. Le drag-to-throw reste utilisable, le scroll passe. */
    touch-action: pan-y;
    cursor: grab;
  }

  .hero__cubes:active {
    cursor: grabbing;
  }

  /* Bandeau de mots-clés — repris de l'ancienne section Vision, déplacé
     ici sous la note "café virtuel", avant le champ de cubes. */
  .hero__marquee {
    width: 100%;
    max-width: 480px;
    margin-top: 4px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .hero__marquee-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px var(--section-py-mobile);
    }

    .hero__orbfield {
      height: 360px;
    }

    .hero__floor {
      height: 50px;
      bottom: -25px;
    }

    .hero__marquee {
      max-width: 100%;
    }

    .hero__ctas {
      gap: 20px;
    }

  }

  /* Doit correspondre au seuil JS (tooNarrow) : sous cette largeur, les
     cubes recouvrent trop le titre pour rester lisibles. */
  @media (max-width: 699px) {
    .hero__cubes {
      display: none;
    }
  }
</style>
