---
import SectionCorners from './SectionCorners.astro';
---

<section class="hero" id="hero">
  <SectionCorners />

  <div class="hero__grid">
    <div class="hero__content">
      <p class="hero__eyebrow">UX/UI Design · AI-assisted development</p>

      <h1 class="hero__title">
        Un design qui inspire confiance,
        <span class="hero__title-accent">une exécution qui va plus vite.</span>
      </h1>

      <p class="hero__subtitle">
        Designer UX/UI indépendant — ancien RTE, 10 ans d'expérience — j'associe une exigence
        produit éprouvée à un développement assisté par IA pour livrer des interfaces soignées,
        plus vite.
      </p>

      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary">Prendre rendez-vous</a>
        <a href="#offres" class="link-underline">Voir mes offres</a>
      </div>
    </div>

    <div class="hero__visual">
      <svg
        class="hero__illustration"
        viewBox="0 0 560 300"
        role="img"
        aria-label="D'un wireframe à une interface livrée"
      >
        <!-- Wireframe (gauche) -->
        <rect
          x="8" y="20" width="200" height="260"
          fill="none" stroke="var(--color-line)" stroke-width="1.5"
          stroke-dasharray="5 4"
        />
        <rect x="28" y="46" width="70" height="10" fill="var(--color-line)" />
        <rect x="28" y="72" width="160" height="6" fill="var(--color-line)" />
        <rect x="28" y="88" width="160" height="6" fill="var(--color-line)" />
        <rect x="28" y="104" width="120" height="6" fill="var(--color-line)" />
        <rect x="28" y="140" width="160" height="6" fill="var(--color-line)" />
        <rect x="28" y="156" width="160" height="6" fill="var(--color-line)" />
        <rect x="28" y="172" width="90" height="6" fill="var(--color-line)" />
        <rect x="28" y="220" width="70" height="22" fill="none" stroke="var(--color-line)" stroke-width="1.5" />

        <!-- Flèche -->
        <line x1="222" y1="150" x2="270" y2="150" stroke="var(--color-ink)" stroke-width="1.5" />
        <path d="M262 142 L272 150 L262 158" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />

        <!-- Interface livrée (droite) -->
        <rect
          x="292" y="20" width="260" height="260"
          fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="1.5"
          rx="4"
        />
        <rect x="316" y="46" width="120" height="12" fill="var(--color-ink)" />
        <rect x="316" y="78" width="212" height="6" fill="var(--color-text-secondary)" opacity="0.6" />
        <rect x="316" y="94" width="212" height="6" fill="var(--color-text-secondary)" opacity="0.6" />
        <rect x="316" y="110" width="160" height="6" fill="var(--color-text-secondary)" opacity="0.6" />
        <rect x="316" y="146" width="212" height="6" fill="var(--color-text-secondary)" opacity="0.4" />
        <rect x="316" y="162" width="212" height="6" fill="var(--color-text-secondary)" opacity="0.4" />
        <rect x="316" y="178" width="130" height="6" fill="var(--color-text-secondary)" opacity="0.4" />
        <rect x="316" y="224" width="96" height="26" fill="var(--color-accent)" />
      </svg>

      <ol class="timeline">
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">Discovery</span>
        </li>
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">UX</span>
        </li>
        <li class="timeline__step">
          <span class="timeline__dot"></span>
          <span class="timeline__label">UI</span>
        </li>
        <li class="timeline__step timeline__step--active">
          <span class="timeline__dot"></span>
          <span class="timeline__label">Ship</span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-bg);
    padding: 96px 48px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .hero__title {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.25rem);
    line-height: 1.1;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-accent {
    display: inline;
    color: var(--color-accent);
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 46ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    gap: 28px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  .hero__illustration {
    width: 100%;
    height: auto;
  }

  .timeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 5px;
    right: 5px;
    height: 1px;
    background: var(--color-line);
  }

  .timeline__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .timeline__dot {
    width: 11px;
    height: 11px;
    background: var(--color-surface);
    border: 1.5px solid var(--color-ink);
    z-index: 1;
  }

  .timeline__step--active .timeline__dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    animation: dot-pop 0.5s ease 0.6s both;
  }

  .timeline__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .timeline__step--active .timeline__label {
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 64px 24px;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero__visual {
      order: -1;
    }

    .hero__ctas {
      gap: 20px;
    }
  }
</style>
