---
const titleLine1 = "Je débloque ton produit,";
const titleLine2 = "et j'élimine tes frictions UX.";
const words1 = titleLine1.split(' ');
const words2 = titleLine2.split(' ');

const tags = [
  'Discovery',
  'UX Research',
  'UI Design',
  'Design System',
  'AI-assisted Dev',
  'Fast Shipping',
  'Suivi produit',
];
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <div class="title-flanked title-flanked--hero">
      <span class="title-flanked__line" aria-hidden="true" />
      <h1 class="hero__title">
        <span class="hero__title-line">
          {words1.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i}`}>{w}&nbsp;</span></span>
          ))}
        </span>
        <span class="hero__title-line hero__title-accent">
          {words2.map((w, i) => (
            <span class="word-mask"><span class="word-inner" style={`--i: ${i + words1.length}`}>{w}&nbsp;</span></span>
          ))}
        </span>
      </h1>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="hero__subtitle">
      Moi c'est Aïda. Designer UX/UI qui a fait de l'IA une alliée, pas une menace. Je prends tes
      projets de A à Z, et je livre vite.
    </p>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__marquee" role="presentation">
      <div class="hero__marquee-track">
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        {tags.map((tag) => <span class="tag-pill" aria-hidden="true">{tag}</span>)}
      </div>
    </div>

    <!-- Cascade de cubes noir/anthracite (voir <script>) : tombe en boucle
         infinie à travers .hero__orbfield, qui héberge directement le
         canvas — ses propres dimensions bornent ce que la caméra peut
         dessiner, donc les cubes apparaissent/disparaissent net aux bords
         de cette zone, sans déborder sur le reste du hero. Purement
         décorative et non interactive (ni cliquable, ni glissable, ni
         pilotable au clavier) — aria-hidden, et pointer-events:none pour ne
         jamais intercepter un clic destiné au contenu en dessous. -->
    <div class="hero__orbfield" aria-hidden="true">
      <canvas id="hero-cubes" class="hero__cubes" aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-cubes') as HTMLCanvasElement | null;
  // .hero__orbfield est maintenant le parent direct du canvas (voir markup
  // plus haut) : ses propres dimensions/position deviennent le repère de la
  // caméra ET la fenêtre de découpe visuelle de la chute — plus besoin de
  // requêter .hero__orbfield séparément.
  const field = canvas?.parentElement as HTMLElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && field && !prefersReduced) {
    // Three.js chargé à la demande (voir IntroOverlay.astro pour le détail
    // de la mesure Lighthouse qui a motivé ce changement) — pas en import
    // statique qui alourdirait le bundle initial de la page. Plus de
    // cannon-es : la cascade n'a plus besoin de physique (pas de collision,
    // pas de lévitation en place à retenir par ressort), juste une chute
    // continue calculée directement dans tick().
    void (async () => {
    const [THREE, { RoundedBoxGeometry }, { RoomEnvironment }] = await Promise.all([
      import('three'),
      import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
      import('three/examples/jsm/environments/RoomEnvironment.js'),
    ]);

    let width = field.clientWidth;
    let height = field.clientHeight;

    // --- Three.js scene, orthographic so 1 unit = 1px ---
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);
    // Tone mapping filmic : sans lui (défaut Three.js = aucun), un reflet
    // au-delà de 1.0 se clippe net en blanc plat dès qu'une face pointe
    // vers la zone la plus lumineuse de l'environnement — exactement le
    // genre de flash qu'on cherche à éviter sur un matériau glossy. ACES
    // compresse ces hautes lumières en un dégradé au lieu d'un aplat, donc
    // le verre reste brillant sans jamais tourner cube-blanc-uni.
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    // Effet verre brillant : le lustre vient surtout de l'ambiante + de
    // l'environnement (RoomEnvironment, réfléchi de façon diffuse) plutôt
    // que d'une lumière directionnelle forte — une "key light" intense sur
    // un matériau à faible roughness créerait un point chaud net qui flashe
    // en blanc pur dès qu'une face lui fait face (déjà vu avec ce cube en
    // rotation continue) ; ici la clé reste en appoint, juste pour donner
    // un léger gradient de lecture aux faces.
    const ambient = new THREE.AmbientLight(0xffffff, 1);
    const key = new THREE.DirectionalLight(0xffffff, 0.25);
    key.position.set(120, 220, 260);
    scene.add(ambient, key);

    // Champ (= .hero__orbfield) centré sur l'origine caméra par construction
    // (voir l'ortho camera juste au-dessus, bornée à ±width/2 / ±height/2) :
    // la cascade tombe donc autour de x = 0, sur une demi-hauteur halfH
    // recalculée à chaque resize.
    const restX = 0;
    let halfH = height / 2;

    function layoutBounds() {
      halfH = height / 2 - 10;
    }
    layoutBounds();

    // --- Cascade de cubes : plusieurs cubes noir/anthracite de tailles
    // différentes, empilés en diagonale façon socle sculptural, plutôt que
    // l'ancien gros cube unique à faces labellisées — purement décoratif
    // désormais (plus de texte imprimé sur les faces). Toute la cascade
    // tombe comme un seul groupe rigide (voir tick()), chaque mini-cube
    // gardant sa propre rotation/flottement par-dessus ce mouvement commun.
    type ClusterCubeSpec = {
      x: number; y: number; z: number; size: number;
      tone: 'black' | 'anthracite';
    };
    // Composition recalée sur la photo de référence : une tour qui tombe
    // presque à la verticale (léger zigzag gauche/droite), pas une longue
    // diagonale à 45° — le plus gros cube en haut, le plus petit tout en
    // bas, comme une pile qui vient de dégringoler. Pas d'angle de départ
    // par cube ici : chaque mini-cube reçoit sa propre rotation continue à
    // la volée (voir spawnCluster), donc un angle statique serait aussitôt
    // écrasé dès la première frame.
    //
    // Espacement : chaque cube tournant librement sur son propre axe (voir
    // spawnCluster), la distance entre deux centres voisins est calée pour
    // rester toujours supérieure à la somme de leurs rayons circonscrits
    // (size × √3⁄2 — le rayon de la sphère qui contient le cube quelle que
    // soit son orientation), avec ~12% de marge. Ça garantit qu'aucun coin
    // ne peut jamais traverser visuellement un cube voisin, même dans le
    // pire cas de rotation, tout en les gardant assez proches pour rester
    // une cascade compacte à l'écran (léger chevauchement en projection).
    const CLUSTER_CUBES: ClusterCubeSpec[] = [
      { x: -38, y: 185, z: -10, size: 78, tone: 'anthracite' },
      { x: 30, y: 66, z: 18, size: 66, tone: 'black' },
      { x: -25, y: -35, z: -16, size: 58, tone: 'anthracite' },
      { x: 20, y: -125, z: 12, size: 50, tone: 'black' },
      { x: -18, y: -204, z: -14, size: 44, tone: 'anthracite' },
      { x: 14, y: -270, z: 16, size: 38, tone: 'black' },
    ];

    type ClusterRig = { mesh: THREE.Group; age: number };
    const cubes: ClusterRig[] = [];

    // Étendue verticale (locale, avant tout décalage de groupe) de toute la
    // cascade — sert à savoir de combien la faire dépasser .hero__orbfield
    // en haut/en bas avant qu'elle soit entièrement hors champ, pour que la
    // boucle infinie de tick() ne se voie jamais (voir plus bas).
    let clusterTop = -Infinity;
    let clusterBottom = Infinity;
    for (const spec of CLUSTER_CUBES) {
      const top = spec.y + spec.size / 2;
      const bottom = spec.y - spec.size / 2;
      if (top > clusterTop) clusterTop = top;
      if (bottom < clusterBottom) clusterBottom = bottom;
    }

    function toneMaterial(tone: 'black' | 'anthracite') {
      // Effet "verre" brillant : metalness bas (le verre n'est pas un
      // métal), roughness et clearcoatRoughness bas pour un lustre net, et
      // clearcoat/envMapIntensity élevés pour que les reflets d'environnement
      // se voient franchement. Le risque du premier essai à faible roughness
      // (une face qui flashe en blanc pur en pointant vers la lumière clé,
      // le cube tournant en continu) est traité en amont : voir la clé très
      // faible et l'ambiante forte plus haut — le lustre vient de
      // l'environnement diffus, pas d'un point chaud directionnel.
      return tone === 'anthracite'
        ? new THREE.MeshPhysicalMaterial({
            color: 0x3a3d40,
            metalness: 0.12,
            roughness: 0.14,
            envMapIntensity: 1.9,
            clearcoat: 1,
            clearcoatRoughness: 0.08,
            transparent: true,
            opacity: 0,
          })
        : new THREE.MeshPhysicalMaterial({
            color: 0x0c1210,
            metalness: 0.08,
            roughness: 0.16,
            envMapIntensity: 1.6,
            clearcoat: 0.9,
            clearcoatRoughness: 0.1,
            transparent: true,
            opacity: 0,
          });
    }

    // Tangage fixe (X) sur le groupe entier, pour garder le dessus des
    // cubes lisible — sans lacet (Y) permanent qui coucherait la tour
    // verticale dessinée en coordonnées locales vers une diagonale trop
    // horizontale une fois vue caméra. Déclaré avant spawnCluster() qui
    // l'utilise dès la construction du groupe.
    const VIEW_TILT = new THREE.Quaternion().setFromEuler(new THREE.Euler(-0.16, 0.05, 0));

    function spawnCluster() {
      const group = new THREE.Group();
      for (const spec of CLUSTER_CUBES) {
        const geo = new RoundedBoxGeometry(spec.size, spec.size, spec.size, 4, spec.size * 0.08);
        const mesh = new THREE.Mesh(geo, toneMaterial(spec.tone));
        mesh.position.set(spec.x, spec.y, spec.z);
        // Arêtes dessinées explicitement, comme sur l'ancien cube unique :
        // un fini satiné en rotation libre traverse des angles où aucune
        // arête n'est visible entre deux faces sans ce trait.
        const edges = new THREE.LineSegments(
          new THREE.EdgesGeometry(geo, 25),
          new THREE.LineBasicMaterial({
            color: spec.tone === 'anthracite' ? 0x1c1e20 : 0x000000,
            transparent: true,
            opacity: 0,
          })
        );
        mesh.add(edges);
        // Animation propre à chaque mini-cube (axe/vitesse/déphasage de
        // rotation, phase/amplitude de flottement) plutôt qu'un seul
        // mouvement partagé par toute la cascade — demandé explicitement
        // pour un rendu moins mécanique, plus naturel : chaque cube tourne
        // à son rythme, certains flottent plus haut ou plus bas que
        // d'autres à un instant donné.
        mesh.userData = {
          baseY: spec.y,
          spinAxis: new THREE.Vector3(
            Math.random() * 2 - 1,
            Math.random() * 2 - 1,
            Math.random() * 2 - 1
          ).normalize(),
          spinSpeed: 0.06 + Math.random() * 0.22,
          spinPhase: Math.random() * Math.PI * 2,
          bobAmp: 5 + Math.random() * 9,
          bobSpeed: 0.55 + Math.random() * 0.7,
          bobPhase: Math.random() * Math.PI * 2,
        };
        group.add(mesh);
      }
      // Tangage de lecture fixe sur le groupe entier (garde le dessus des
      // cubes visible) — la cascade ne tourne plus comme un seul bloc,
      // chaque cube gère sa propre rotation individuellement (voir tick()).
      group.quaternion.copy(VIEW_TILT);
      scene.add(group);

      const rig: ClusterRig = { mesh: group, age: 0 };
      cubes.push(rig);
      return rig;
    }

    spawnCluster();

    // Purement décorative : ni cliquable, ni glissable, ni pilotable au
    // clavier. Le canvas n'intercepte donc plus aucun pointeur (voir
    // pointer-events:none dans le <style>), pas besoin de relais de clic
    // vers le contenu en dessous.

    // --- Render loop, paused while offscreen ---
    let running = true;
    let rafId = 0;
    let prevTime = performance.now();

    // Vitesse de chute — lente et contemplative, cohérente avec le rythme
    // du reste du hero (rotation/flottement des mini-cubes, glissé du
    // curseur Méthode, etc.), pas une chute rapide façon vidéo-jeu.
    const FALL_SPEED = 26; // px/s

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      // Distance totale parcourue avant de boucler : la demi-hauteur du
      // champ des deux côtés (pour que la cascade soit entièrement hors
      // champ avant d'apparaître/disparaître) plus l'étendue verticale de
      // la cascade elle-même (pour qu'elle soit hors champ AVANT que son
      // dernier cube n'ait fini de sortir). Recalculée à chaque frame à
      // partir de halfH (mis à jour au resize) : pas de plage figée.
      const fallSpan = 2 * halfH + (clusterTop - clusterBottom);
      // Départ : le bas de la cascade est juste au bord haut du champ
      // (donc la cascade entière est encore invisible, juste au-dessus).
      const fallTop = halfH - clusterBottom;
      const p = ((now / 1000) * FALL_SPEED) % fallSpan;
      const groupY = fallTop - p;

      for (let i = cubes.length - 1; i >= 0; i--) {
        const c = cubes[i];

        // Le groupe ne porte plus que la chute d'ensemble — ni bob ni
        // rotation uniformes ici, chaque mini-cube gère les siens
        // individuellement juste en dessous, pour un mouvement
        // désynchronisé plutôt qu'un bloc rigide qui tourne d'un seul tenant.
        c.mesh.position.set(restX, groupY, 0);

        for (const child of c.mesh.children) {
          const u = child.userData as {
            baseY: number; spinAxis: THREE.Vector3; spinSpeed: number; spinPhase: number;
            bobAmp: number; bobSpeed: number; bobPhase: number;
          };
          child.position.y = u.baseY + Math.sin(now / 1000 * u.bobSpeed + u.bobPhase) * u.bobAmp;
          child.quaternion.setFromAxisAngle(u.spinAxis, now / 1000 * u.spinSpeed + u.spinPhase);
        }

        // Fondu d'apparition — la cascade arrive progressivement plutôt que
        // de recouvrir brutalement un label (chip, texte) qu'elle traverse.
        c.age += dt;
        const fadeIn = Math.min(c.age / 0.4, 1);
        c.mesh.traverse((obj) => {
          if (obj instanceof THREE.Mesh) {
            (obj.material as THREE.MeshPhysicalMaterial).opacity = fadeIn;
          } else if (obj instanceof THREE.LineSegments) {
            (obj.material as THREE.LineBasicMaterial).opacity = fadeIn * 0.85;
          }
        });
      }
      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !running) {
          running = true;
          prevTime = performance.now();
          rafId = requestAnimationFrame(tick);
        } else if (!visible && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(field);
    rafId = requestAnimationFrame(tick);

    window.addEventListener('resize', () => {
      width = field.clientWidth;
      height = field.clientHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      layoutBounds();
    });
    })();
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 64px 24px var(--section-py);
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    font-style: italic;
    font-weight: 500;
  }

  /* Traits volontairement courts : le titre du hero occupe déjà toute la
     largeur utile de .hero__inner (780px) — des traits plus longs lui
     voleraient assez de place pour casser sa mise en ligne habituelle
     ("Je débloque ton produit," passerait sur deux lignes). */
  .title-flanked--hero {
    gap: 16px;
    align-items: center;
  }

  .title-flanked--hero .title-flanked__line {
    width: 32px;
  }

  @media (max-width: 640px) {
    .title-flanked--hero .title-flanked__line {
      width: 18px;
    }
  }

  /* Apparition mot par mot au chargement — chaque mot glisse depuis son
     propre masque, façon titre animé du site de référence. */
  .word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
  }

  .word-inner {
    display: inline-block;
    opacity: 0;
    transform: translateY(110%);
    animation: word-reveal 0.75s var(--ease-spring) both;
    animation-delay: calc(var(--i, 0) * 65ms + 0.15s);
  }

  .hero__title-accent .word-inner {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes word-reveal {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 680px;
    height: 400px;
    margin-top: 24px;
    perspective: 1200px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  /* Cascade de cubes — scène WebGL (Three.js), voir le <script> plus bas.
     Le canvas est désormais un enfant de .hero__orbfield (pas un calque
     plein hero) : ses propres dimensions bornent ce que la caméra peut
     dessiner, donc la chute infinie de la cascade se découpe net aux
     bords réels de .hero__orbfield, sans avoir à cliper quoi que ce soit
     en CSS. */
  .hero__cubes {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    /* Purement décorative : n'intercepte jamais un clic/tap destiné au
       contenu en dessous (CTA, liens, cartes flip) — plus besoin du relais
       de clic qu'exigeait l'ancien cube manipulable. */
    pointer-events: none;
    /* Fondu doux en haut/bas de la zone : sans lui, un cube qui entre ou
       sort de la chute apparaîtrait/disparaîtrait net au bord du canvas —
       même principe que le mask-image de .hero__marquee un peu plus bas,
       en vertical. */
    mask-image: linear-gradient(180deg, transparent, black 14%, black 86%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, black 14%, black 86%, transparent);
  }

  /* Bandeau de mots-clés — repris de l'ancienne section Vision, déplacé
     ici sous la note "café virtuel", avant le champ de cubes. */
  .hero__marquee {
    width: 100%;
    max-width: 480px;
    margin-top: 4px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .hero__marquee-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px var(--section-py-mobile);
    }

    .hero__orbfield {
      height: 360px;
    }

    .hero__marquee {
      max-width: 100%;
    }

    .hero__ctas {
      gap: 20px;
    }

  }
</style>
