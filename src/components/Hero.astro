---
---

<section class="hero" id="hero">
  <span class="blob blob--1" aria-hidden="true"></span>
  <span class="blob blob--2" aria-hidden="true"></span>

  <div class="hero__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      UX/UI Design · AI-assisted development
    </span>

    <h1 class="hero__title">
      Un design qui inspire confiance,
      <span class="hero__title-accent">une exécution qui va plus vite.</span>
    </h1>

    <p class="hero__subtitle">
      Designer UX/UI indépendante — 10 ans d'expérience — j'associe une exigence produit éprouvée
      à un développement assisté par IA pour livrer des interfaces soignées, plus vite.
    </p>

    <div class="hero__ctas">
      <a href="#contact" class="btn btn--primary">Réserver un appel découverte</a>
      <a href="#accompagnement" class="link-underline">Voir mes offres</a>
    </div>

    <p class="hero__note">On en discute autour d'un café virtuel ? <span class="emoji-live">☕️</span></p>

    <div class="hero__orbfield" aria-hidden="true">
      <span class="hero__orb hero__orb--1"></span>
      <span class="hero__orb hero__orb--2"></span>
      <span class="hero__orb hero__orb--3"></span>

      <span class="hero__chip hero__chip--1">🔍 Discovery</span>
      <span class="hero__chip hero__chip--2">✏️ UX</span>
      <span class="hero__chip hero__chip--3">🎨 UI</span>
      <span class="hero__chip hero__chip--4 hero__chip--active">🚀 Ship</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 24px 96px;
    overflow: hidden;
  }

  .blob {
    opacity: 0.55;
    animation: float-blob 9s ease-in-out infinite;
  }

  .blob--1 {
    width: 340px;
    height: 340px;
    top: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(76, 140, 99, 0.4), transparent 70%);
  }

  .blob--2 {
    width: 380px;
    height: 380px;
    top: 60px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.4), transparent 70%);
    animation-delay: -4s;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    animation: hero-reveal 0.7s ease both;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__title {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__title-accent {
    display: block;
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Champ d'orbes flottants — composition graphique originale inspirée du
     dynamisme du site de référence (formes glossy en lévitation), sans
     réutiliser ses assets. */
  .hero__orbfield {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    height: 320px;
    margin-top: 24px;
    animation: hero-reveal 0.7s ease 0.12s both;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    animation: float-blob 8s ease-in-out infinite;
  }

  .hero__orb--1 {
    width: 150px;
    height: 150px;
    top: 6%;
    left: 6%;
    background: radial-gradient(
      circle at 32% 28%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.1) 24%,
      var(--color-accent-2) 55%,
      var(--color-accent) 100%
    );
    box-shadow: inset 0 -12px 24px rgba(22, 36, 28, 0.2), 0 24px 44px -18px rgba(22, 36, 28, 0.4);
  }

  .hero__orb--2 {
    width: 108px;
    height: 108px;
    bottom: 8%;
    right: 10%;
    background: radial-gradient(
      circle at 34% 30%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.08) 24%,
      #e9c98a 55%,
      #c99a4f 100%
    );
    box-shadow: inset 0 -10px 20px rgba(22, 36, 28, 0.18), 0 20px 38px -16px rgba(22, 36, 28, 0.35);
    animation-duration: 10s;
    animation-delay: -3s;
  }

  .hero__orb--3 {
    width: 64px;
    height: 64px;
    top: 44%;
    right: 30%;
    background: radial-gradient(
      circle at 32% 28%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.1) 24%,
      var(--color-accent) 60%,
      var(--color-ink) 100%
    );
    box-shadow: inset 0 -8px 16px rgba(22, 36, 28, 0.2), 0 16px 30px -14px rgba(22, 36, 28, 0.35);
    animation-duration: 7s;
    animation-delay: -1.5s;
  }

  .hero__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--color-ink);
    background: var(--color-glass-strong);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);
    animation: float-blob 6.5s ease-in-out infinite;
    white-space: nowrap;
  }

  .hero__chip--1 {
    top: 2%;
    left: 40%;
    animation-delay: -2s;
  }

  .hero__chip--2 {
    bottom: 22%;
    left: 2%;
    animation-duration: 7.5s;
    animation-delay: -4s;
  }

  .hero__chip--3 {
    top: 4%;
    right: 6%;
    animation-duration: 8.5s;
    animation-delay: -1s;
  }

  .hero__chip--4 {
    bottom: 4%;
    right: 32%;
    animation-duration: 6s;
    animation-delay: -3.5s;
  }

  .hero__chip--active {
    background: var(--gradient-accent);
    color: #ffffff;
    border-color: transparent;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 40px 20px 64px;
    }

    .hero__orbfield {
      height: 260px;
    }

    .hero__orb--1 {
      width: 110px;
      height: 110px;
    }

    .hero__orb--2 {
      width: 84px;
      height: 84px;
    }

    .hero__orb--3 {
      width: 50px;
      height: 50px;
    }

    .hero__chip {
      font-size: 0.75rem;
      padding: 8px 14px;
    }

    .hero__ctas {
      gap: 20px;
    }
  }
</style>
