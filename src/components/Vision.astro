---
const etapes = [
  {
    emoji: '🔍',
    titre: 'Comprendre',
    texte: "Observer les utilisateurs, leurs besoins et leurs blocages avant de dessiner quoi que ce soit.",
    methodes: ['Interviews utilisateurs', 'Personas', "Cartes d'empathie"],
  },
  {
    emoji: '🧭',
    titre: 'Structurer (UX)',
    texte: "Organiser l'information et les parcours pour que tout se trouve sans effort.",
    methodes: ["Architecture de l'information", 'Tri de cartes', 'Wireframes'],
  },
  {
    emoji: '🎨',
    titre: 'Habiller (UI)',
    texte: 'Donner une forme visuelle cohérente à cette structure, jusqu\'au moindre détail.',
    methodes: ['Design system', 'Prototypes', "Tests d'utilisabilité"],
  },
];

const apports = [
  {
    titre: 'Rétention',
    texte: 'Des utilisateurs qui comprennent le produit du premier coup, et qui restent.',
  },
  {
    titre: 'Confiance',
    texte: 'Une interface soignée qui rassure avant même la première interaction.',
  },
  {
    titre: 'Moins de rework',
    texte: 'Des choix validés en amont, pour ne pas redévelopper trois fois la même chose.',
  },
  {
    titre: 'Conversion',
    texte: "Des parcours pensés pour l'objectif business, pas juste pour être jolis.",
  },
];

---

<section class="vision" id="vision">
  <span class="blob blob--vision" aria-hidden="true"></span>

  <div class="vision__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Ma vision
    </span>

    <div class="title-flanked">
      <span class="title-flanked__line" aria-hidden="true" />
      <h2 class="vision__title">
        Le design, ce n'est pas qu'une question <em>d'esthétique.</em>
      </h2>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <div class="vision__grid">
      <p class="vision__paragraph">
        Un bon design, c'est la preuve qu'un produit se comprend du premier coup — et qu'il reste
        cohérent à mesure qu'il grandit. Ce n'est pas une question de goût, c'est une méthode :
        comprendre l'utilisateur, structurer le parcours, puis donner une forme visuelle qui sert
        cet objectif.
      </p>

      <p class="vision__paragraph">
        Le développement assisté par IA ne remplace rien de tout ça — il accélère la dernière
        étape, celle qui transforme une maquette validée en interface réellement utilisable,
        sans attendre des mois.
      </p>
    </div>

    <div class="vision__block">
      <h3 class="vision__block-title">C'est quoi, concrètement, l'UX/UI Design ?</h3>

      <div class="cocoon">
        <div class="cocoon__visual" data-stage="0">
          <svg class="cocoon__svg" viewBox="0 0 240 220" aria-hidden="true">
            <path class="cocoon__branch-line" d="M30,24 Q120,4 210,24" fill="none" />
            <path class="cocoon__leaf" d="M74,21 C63,10 46,12 40,23 C46,32 65,31 74,21 Z" />
            <path class="cocoon__leaf" d="M166,21 C177,10 194,12 200,23 C194,32 175,31 166,21 Z" />
            <line class="cocoon__thread" x1="120" y1="24" x2="120" y2="58" />

            <g class="cocoon__swing">
              <g class="cocoon__shell">
                <path
                  class="cocoon__shell-fill"
                  d="M120,58 C142,64 150,88 150,110 C150,136 137,157 120,160 C103,157 90,136 90,110 C90,88 98,64 120,58 Z"
                />
                <path class="cocoon__band" d="M96,82 Q120,89 144,82" />
                <path class="cocoon__band" d="M93,102 Q120,110 147,102" />
                <path class="cocoon__band" d="M94,124 Q120,132 146,124" />
                <path class="cocoon__band" d="M98,143 Q120,149 142,143" />
              </g>

              <ellipse class="cocoon__glow" cx="120" cy="112" rx="46" ry="56" />
              <g class="cocoon__veins">
                <path d="M118,66 Q94,88 91,118 Q91,140 106,156" />
                <path d="M122,66 Q146,88 149,118 Q149,140 134,156" />
              </g>

              <g class="cocoon__butterfly" aria-hidden="true">
                <g class="cocoon__wing cocoon__wing--lower-left">
                  <path
                    class="cocoon__wing-fill"
                    d="M117,120 C102,130 78,138 67,163 C60,180 65,196 80,190 L74,211 L94,186 C107,172 115,146 119,124 Z"
                  />
                </g>
                <g class="cocoon__wing cocoon__wing--lower-right">
                  <path
                    class="cocoon__wing-fill"
                    d="M123,120 C138,130 162,138 173,163 C180,180 175,196 160,190 L166,211 L146,186 C133,172 125,146 121,124 Z"
                  />
                </g>
                <g class="cocoon__wing cocoon__wing--upper-left">
                  <path
                    class="cocoon__wing-fill"
                    d="M118,100 C90,62 50,56 34,80 C18,105 33,136 70,141 C97,144 113,120 118,100 Z"
                  />
                  <circle class="cocoon__ocelle" cx="66" cy="98" r="7" />
                </g>
                <g class="cocoon__wing cocoon__wing--upper-right">
                  <path
                    class="cocoon__wing-fill"
                    d="M122,100 C150,62 190,56 206,80 C222,105 207,136 170,141 C143,144 127,120 122,100 Z"
                  />
                  <circle class="cocoon__ocelle" cx="174" cy="98" r="7" />
                </g>
                <g class="cocoon__body">
                  <path class="cocoon__antenna" d="M117,72 Q107,54 98,48" />
                  <path class="cocoon__antenna" d="M123,72 Q133,54 142,48" />
                  <ellipse cx="120" cy="77" rx="5" ry="6" />
                  <ellipse cx="120" cy="92" rx="6" ry="8" />
                  <ellipse cx="120" cy="109" rx="6.5" ry="9" />
                  <ellipse cx="120" cy="126" rx="5.5" ry="8" />
                  <ellipse cx="120" cy="140" rx="4.5" ry="6" />
                </g>
                <g class="cocoon__sparkles">
                  <path class="cocoon__spark" d="M0,-6 L1.6,-1.6 L6,0 L1.6,1.6 L0,6 L-1.6,1.6 L-6,0 L-1.6,-1.6 Z" transform="translate(48,64)" />
                  <circle class="cocoon__spark" cx="192" cy="70" r="2.4" />
                  <path class="cocoon__spark" d="M0,-5 L1.3,-1.3 L5,0 L1.3,1.3 L0,5 L-1.3,1.3 L-5,0 L-1.3,-1.3 Z" transform="translate(200,120)" />
                  <circle class="cocoon__spark" cx="38" cy="130" r="2" />
                  <path class="cocoon__spark" d="M0,-5 L1.3,-1.3 L5,0 L1.3,1.3 L0,5 L-1.3,1.3 L-5,0 L-1.3,-1.3 Z" transform="translate(120,30)" />
                </g>
              </g>
            </g>
          </svg>

          <p class="cocoon__label" aria-hidden="true">{etapes[0].titre}</p>

          <div class="cocoon__dots" aria-hidden="true">
            {etapes.map((_, index) => <span class="cocoon__dot" data-dot={index} />)}
          </div>
        </div>

        <div class="cocoon__steps">
          {
            etapes.map((etape, index) => (
              <button
                type="button"
                class="cocoon__step reveal-item"
                style={`--i: ${index}`}
                data-stage-trigger={index}
                aria-pressed="false"
              >
                <span class="cocoon__step-num">0{index + 1}</span>
                <h4 class="cocoon__step-titre">{etape.titre}</h4>
                <p class="cocoon__step-texte">{etape.texte}</p>
                <ul class="cocoon__step-methodes">
                  {etape.methodes.map((methode) => <li>{methode}</li>)}
                </ul>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="vision__block">
      <h3 class="vision__block-title">Ce que ça change sur un projet</h3>

      <div class="vision-benefits">
        {
          apports.map((apport, index) => (
            <div class="vision-benefit glass-card reveal-item" style={`--i: ${index}`}>
              <h4 class="vision-benefit__titre">{apport.titre}</h4>
              <p class="vision-benefit__texte">{apport.texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const visual = document.querySelector('.cocoon__visual') as HTMLElement | null;
  const butterfly = document.querySelector('.cocoon__butterfly') as SVGGElement | null;
  const label = document.querySelector('.cocoon__label') as HTMLElement | null;
  const dots = Array.from(document.querySelectorAll('.cocoon__dot')) as HTMLElement[];
  const stepButtons = Array.from(document.querySelectorAll('.cocoon__step')) as HTMLButtonElement[];

  if (visual && butterfly && label && dots.length === stepButtons.length && stepButtons.length > 0) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STAGE_MS = 7000 / stepButtons.length;
    const LAST = stepButtons.length - 1;
    const titles = stepButtons.map((btn) => btn.querySelector('.cocoon__step-titre')?.textContent ?? '');

    let stage = 0;
    let timer = 0;
    let flying = false;

    function render() {
      visual!.dataset.stage = String(stage);
      label!.textContent = titles[stage];
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === stage));
      stepButtons.forEach((btn, i) => {
        btn.classList.toggle('is-active', i === stage);
        btn.setAttribute('aria-pressed', String(i === stage));
      });
    }

    function goToStage(i: number) {
      stage = i;
      render();
    }

    function scheduleNext() {
      clearTimeout(timer);
      if (prefersReduced) return;
      timer = window.setTimeout(() => {
        if (!flying) {
          goToStage((stage + 1) % stepButtons.length);
        }
        scheduleNext();
      }, STAGE_MS);
    }

    function jumpTo(i: number) {
      if (flying) return;
      clearTimeout(timer);
      goToStage(i);
      scheduleNext();
    }

    // Bonus ponctuel : le papillon s'envole hors du cadre, puis le cycle
    // repart de "Comprendre" après un court délai — sans transition
    // inversée visible (on coupe la transition le temps de repositionner).
    function flyAway() {
      if (flying || prefersReduced) return;
      flying = true;
      clearTimeout(timer);
      butterfly!.classList.add('is-flying');
      window.setTimeout(() => {
        butterfly!.classList.add('cocoon__butterfly--no-transition');
        butterfly!.classList.remove('is-flying');
        goToStage(0);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            butterfly!.classList.remove('cocoon__butterfly--no-transition');
            flying = false;
            scheduleNext();
          });
        });
      }, 3100);
    }

    stepButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        if (i === LAST) {
          jumpTo(LAST);
          flyAway();
        } else {
          jumpTo(i);
        }
      });
    });

    // Le papillon reste cliquable à la souris pour l'envol, mais pas dans
    // l'ordre de tabulation : l'ensemble du visuel est aria-hidden, et le
    // bouton "Habiller" ci-dessous offre déjà le même déclenchement au
    // clavier.
    butterfly.addEventListener('click', () => {
      if (stage === LAST) flyAway();
    });

    goToStage(prefersReduced ? LAST : 0);
    scheduleNext();
  }
</script>

<style>
  .vision {
    position: relative;
    padding: var(--section-py) 0;
    overflow: hidden;
  }

  .blob--vision {
    width: 420px;
    height: 420px;
    top: 10%;
    right: -160px;
    background: radial-gradient(circle, rgba(31, 61, 46, 0.12), transparent 70%);
  }

  .vision__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .vision__title {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 26ch;
  }

  .vision .title-flanked {
    margin-top: 20px;
  }

  .vision__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .vision__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .vision__paragraph {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vision__block {
    margin-top: 64px;
  }

  .vision__block-title {
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    color: var(--color-ink);
    max-width: 32ch;
  }

  /* Visuel 1 — cocon qui devient papillon, illustrant Comprendre →
     Structurer → Habiller. Palette strictement vert + doré (celui déjà
     utilisé pour les cubes), aucune couleur nouvelle. */
  .cocoon {
    display: flex;
    align-items: center;
    gap: 48px;
    margin-top: 32px;
  }

  .cocoon__visual {
    flex-shrink: 0;
    width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cocoon__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .cocoon__branch-line {
    stroke: var(--color-accent-2);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .cocoon__leaf {
    fill: var(--color-accent-2);
    opacity: 0.8;
  }

  .cocoon__thread {
    stroke: var(--color-line);
    stroke-width: 1.5;
    transition: opacity 0.5s ease;
  }

  .cocoon__swing {
    transform-origin: 120px 24px;
    animation: cocoon-swing 4.5s ease-in-out infinite;
  }

  .cocoon__shell-fill {
    fill: var(--color-accent-2);
  }

  .cocoon__band {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  .cocoon__shell {
    transition: opacity 0.6s ease;
  }

  .cocoon__glow {
    fill: #d9a854;
    opacity: 0;
    filter: blur(10px);
    transition: opacity 0.6s ease;
  }

  .cocoon__veins {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .cocoon__veins path {
    fill: none;
    stroke: #d9a854;
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
  }

  .cocoon__butterfly {
    opacity: 0;
    cursor: default;
    pointer-events: none;
    transform-origin: 120px 110px;
    /* Envol plus doux et plus long : on lui laisse le temps de s'éloigner
       vers le haut avant de disparaître, pas un saut brusque. */
    transition: opacity 1.4s ease, transform 2.8s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .cocoon__butterfly--no-transition {
    transition: none !important;
  }

  .cocoon__wing-fill {
    fill: var(--color-accent-2);
    stroke: #d9a854;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .cocoon__ocelle {
    fill: #d9a854;
  }

  .cocoon__wing--upper-left,
  .cocoon__wing--lower-left {
    transform-origin: 118px 108px;
    animation: cocoon-flap-left 1.15s ease-in-out infinite;
  }

  .cocoon__wing--upper-right,
  .cocoon__wing--lower-right {
    transform-origin: 122px 108px;
    animation: cocoon-flap-right 1.15s ease-in-out infinite;
  }

  .cocoon__body ellipse {
    fill: var(--color-accent);
  }

  .cocoon__antenna {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .cocoon__spark {
    fill: #d9a854;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: cocoon-twinkle 1.8s ease-in-out infinite;
  }

  .cocoon__sparkles .cocoon__spark:nth-child(1) {
    animation-delay: 0s;
  }
  .cocoon__sparkles .cocoon__spark:nth-child(2) {
    animation-delay: 0.35s;
  }
  .cocoon__sparkles .cocoon__spark:nth-child(3) {
    animation-delay: 0.7s;
  }
  .cocoon__sparkles .cocoon__spark:nth-child(4) {
    animation-delay: 1.05s;
  }
  .cocoon__sparkles .cocoon__spark:nth-child(5) {
    animation-delay: 1.4s;
  }

  .cocoon__visual[data-stage='1'] .cocoon__shell {
    opacity: 0.4;
  }

  .cocoon__visual[data-stage='1'] .cocoon__glow {
    opacity: 1;
    animation: cocoon-glow-pulse 2s ease-in-out infinite;
  }

  .cocoon__visual[data-stage='1'] .cocoon__veins {
    opacity: 1;
  }

  .cocoon__visual[data-stage='2'] .cocoon__shell,
  .cocoon__visual[data-stage='2'] .cocoon__glow,
  .cocoon__visual[data-stage='2'] .cocoon__veins,
  .cocoon__visual[data-stage='2'] .cocoon__thread {
    opacity: 0;
  }

  .cocoon__visual[data-stage='2'] .cocoon__butterfly {
    opacity: 1;
    cursor: pointer;
    pointer-events: auto;
  }

  .cocoon__visual[data-stage='2'] .cocoon__swing {
    animation: none;
    transform: none;
  }

  .cocoon__butterfly.is-flying {
    /* S'envole nettement plus haut (au-delà du cadre du visuel, vers le
       haut de la section) plutôt qu'un petit déplacement local. */
    transform: translate(60px, -420px) rotate(12deg) scale(0.22);
    opacity: 0;
  }

  @keyframes cocoon-swing {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }

  @keyframes cocoon-glow-pulse {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 0.9;
    }
  }

  @keyframes cocoon-flap-left {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.8);
    }
  }

  @keyframes cocoon-flap-right {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.8);
    }
  }

  @keyframes cocoon-twinkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .cocoon__label {
    margin-top: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .cocoon__dots {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .cocoon__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-line);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .cocoon__dot.is-active {
    background: #d9a854;
    transform: scale(1.3);
  }

  .cocoon__steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .cocoon__step {
    display: block;
    width: 100%;
    padding: 18px 20px;
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-card-sm);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .cocoon__step:hover,
  .cocoon__step.is-active {
    background: var(--color-glass-strong);
    border-color: var(--color-accent-2);
  }

  .cocoon__step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #d9a854;
  }

  .cocoon__step-titre {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 4px 0 6px;
  }

  .cocoon__step-texte {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cocoon__step-methodes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    list-style: none;
    margin: 12px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--color-line);
  }

  .cocoon__step-methodes li {
    position: relative;
    padding-left: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .cocoon__step-methodes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .cocoon__swing,
    .cocoon__wing,
    .cocoon__spark,
    .cocoon__glow {
      animation: none !important;
    }

    .cocoon__butterfly,
    .cocoon__shell,
    .cocoon__veins,
    .cocoon__thread {
      transition: none !important;
    }
  }

  /* Visuel 2 — quatre bénéfices concrets, même grammaire visuelle que les
     problématiques mais tournée vers l'apport plutôt que le manque. */
  .vision-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vision-benefit {
    padding: 26px;
  }

  .vision-benefit__titre {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .vision-benefit__texte {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .vision {
      padding: var(--section-py-mobile) 0;
    }

    .vision__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .vision__block {
      margin-top: 48px;
    }

    .cocoon {
      flex-direction: column;
      gap: 24px;
    }

    .cocoon__visual {
      width: 260px;
    }

    .vision-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .vision-benefits {
      grid-template-columns: 1fr;
    }
  }
</style>
