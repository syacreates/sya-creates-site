  /* rotateY (pas scaleX) : l'aile pivote vraiment autour de son bord
     d'attache, avec le raccourci en perspective que ça implique — un
     aplatissement non-linéaire, pas un simple étirement horizontal. Descente
     0→45% (rapide), tenue 45→55% (le bas du battement), remontée 55→100%
     (un peu plus lente) : un vrai battement est asymétrique, jamais un
     aller-retour parfaitement symétrique. */
  @keyframes cocoon-flap-left {
    0% {
      transform: perspective(240px) rotateY(0deg);
    }
    45% {
      transform: perspective(240px) rotateY(62deg);
    }
    55% {
      transform: perspective(240px) rotateY(66deg);
    }
    100% {
      transform: perspective(240px) rotateY(0deg);
    }
  }

  @keyframes cocoon-flap-right {
    0% {
      transform: perspective(240px) rotateY(0deg);
    }
    45% {
      transform: perspective(240px) rotateY(-62deg);
    }
    55% {
      transform: perspective(240px) rotateY(-66deg);
    }
    100% {
      transform: perspective(240px) rotateY(0deg);
    }
  }

