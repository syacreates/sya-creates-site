---
const stats = [
  { valeur: '10 ans', label: "d'expérience produit" },
  { valeur: 'IA-assisted', label: 'développement accéléré' },
  { valeur: 'Zéro', label: 'boîte noire' },
];

const tags = [
  'Discovery',
  'UX Research',
  'UI Design',
  'Design System',
  'AI-assisted Dev',
  'Fast Shipping',
  'Suivi produit',
];
---

<section class="vision" id="vision">
  <span class="blob blob--vision" aria-hidden="true"></span>

  <div class="vision__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Ma vision
    </span>

    <h2 class="vision__title">
      Le design, ce n'est pas qu'une question <em>d'esthétique.</em>
    </h2>

    <div class="vision__grid">
      <p class="vision__paragraph">
        Un bon design, c'est la preuve qu'un produit se comprend du premier coup — et qu'il reste
        cohérent à mesure qu'il grandit. Ce n'est pas une question de goût, c'est une méthode :
        comprendre l'utilisateur, structurer le parcours, puis donner une forme visuelle qui sert
        cet objectif.
      </p>

      <p class="vision__paragraph">
        Le développement assisté par IA ne remplace rien de tout ça — il accélère la dernière
        étape, celle qui transforme une maquette validée en interface réellement utilisable,
        sans attendre des mois.
      </p>
    </div>

    <div class="vision__stats">
      {
        stats.map((stat) => (
          <div class="vision-stat">
            <span class="vision-stat__valeur">{stat.valeur}</span>
            <span class="vision-stat__label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="vision__marquee" role="presentation">
      <div class="vision__marquee-track">
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
        {tags.map((tag) => <span class="tag-pill" aria-hidden="true">{tag}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .vision {
    position: relative;
    padding: 96px 0;
    overflow: hidden;
  }

  .blob--vision {
    width: 420px;
    height: 420px;
    top: 10%;
    right: -160px;
    background: radial-gradient(circle, rgba(31, 61, 46, 0.12), transparent 70%);
  }

  .vision__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .vision__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 26ch;
  }

  .vision__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .vision__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .vision__paragraph {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vision__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .vision-stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vision-stat__valeur {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    font-weight: 600;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .vision-stat__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vision__marquee {
    margin-top: 56px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .vision__marquee-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marquee 26s linear infinite;
  }

  @media (max-width: 860px) {
    .vision {
      padding: 64px 0;
    }

    .vision__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .vision__stats {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 48px;
    }
  }
</style>
