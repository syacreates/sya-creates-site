---
const stats = [
  { emoji: '🕒', valeur: '10 ans', label: "d'expérience produit" },
  { emoji: '🤖', valeur: 'IA-assisted', label: 'développement accéléré' },
  { emoji: '🔓', valeur: 'Zéro', label: 'boîte noire' },
];

const etapes = [
  {
    emoji: '🔍',
    titre: 'Comprendre',
    texte: "Observer les utilisateurs, leurs besoins et leurs blocages avant de dessiner quoi que ce soit.",
    methodes: ['Interviews utilisateurs', 'Personas', "Cartes d'empathie"],
  },
  {
    emoji: '🧭',
    titre: 'Structurer (UX)',
    texte: "Organiser l'information et les parcours pour que tout se trouve sans effort.",
    methodes: ["Architecture de l'information", 'Tri de cartes', 'Wireframes'],
  },
  {
    emoji: '🎨',
    titre: 'Habiller (UI)',
    texte: 'Donner une forme visuelle cohérente à cette structure, jusqu\'au moindre détail.',
    methodes: ['Design system', 'Prototypes', "Tests d'utilisabilité"],
  },
];

const apports = [
  {
    emoji: '🧲',
    titre: 'Rétention',
    texte: 'Des utilisateurs qui comprennent le produit du premier coup, et qui restent.',
  },
  {
    emoji: '🤝',
    titre: 'Confiance',
    texte: 'Une interface soignée qui rassure avant même la première interaction.',
  },
  {
    emoji: '🛠️',
    titre: 'Moins de rework',
    texte: 'Des choix validés en amont, pour ne pas redévelopper trois fois la même chose.',
  },
  {
    emoji: '📈',
    titre: 'Conversion',
    texte: "Des parcours pensés pour l'objectif business, pas juste pour être jolis.",
  },
];

---

<section class="vision" id="vision">
  <span class="blob blob--vision" aria-hidden="true"></span>

  <div class="vision__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Ma vision
    </span>

    <h2 class="vision__title">
      Le design, ce n'est pas qu'une question <em>d'esthétique.</em>
    </h2>

    <div class="vision__grid">
      <p class="vision__paragraph">
        Un bon design, c'est la preuve qu'un produit se comprend du premier coup — et qu'il reste
        cohérent à mesure qu'il grandit. Ce n'est pas une question de goût, c'est une méthode :
        comprendre l'utilisateur, structurer le parcours, puis donner une forme visuelle qui sert
        cet objectif.
      </p>

      <p class="vision__paragraph">
        Le développement assisté par IA ne remplace rien de tout ça — il accélère la dernière
        étape, celle qui transforme une maquette validée en interface réellement utilisable,
        sans attendre des mois.
      </p>
    </div>

    <div class="vision__block">
      <h3 class="vision__block-title">C'est quoi, concrètement, l'UX/UI Design ?</h3>

      <div class="vision-flow">
        {
          etapes.map((etape, index) => (
            <>
              <div
                class="vision-flow__step glass-card reveal-item flip-card"
                style={`--i: ${index}`}
                tabindex="0"
                role="button"
                aria-expanded="false"
                aria-label={`${etape.titre} — appuie pour voir le détail`}
              >
                <div class="flip-card__inner">
                  <div class="flip-card__front">
                    <span class="vision-flow__icon">
                      <span class="emoji-live" aria-hidden="true">{etape.emoji}</span>
                    </span>
                    <h4 class="vision-flow__titre">{etape.titre}</h4>
                  </div>
                  <div class="flip-card__back">
                    <p>{etape.texte}</p>
                    <ul class="vision-flow__methodes">
                      {etape.methodes.map((methode) => <li>{methode}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
              {index < etapes.length - 1 && (
                <span class="vision-flow__arrow" aria-hidden="true">→</span>
              )}
            </>
          ))
        }
      </div>
    </div>

    <div class="vision__block">
      <h3 class="vision__block-title">Ce que ça change sur un projet</h3>

      <div class="vision-benefits">
        {
          apports.map((apport, index) => (
            <div class="vision-benefit glass-card reveal-item" style={`--i: ${index}`}>
              <span class="vision-benefit__icon">
                <span class="emoji-live" aria-hidden="true">{apport.emoji}</span>
              </span>
              <h4 class="vision-benefit__titre">{apport.titre}</h4>
              <p class="vision-benefit__texte">{apport.texte}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="vision__stats">
      {
        stats.map((stat, index) => (
          <div class="vision-stat reveal-item" style={`--i: ${index}`}>
            <span class="vision-stat__icon">
              <span class="emoji-live" aria-hidden="true">{stat.emoji}</span>
            </span>
            <span class="vision-stat__valeur">{stat.valeur}</span>
            <span class="vision-stat__label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vision {
    position: relative;
    padding: 96px 0;
    overflow: hidden;
  }

  .blob--vision {
    width: 420px;
    height: 420px;
    top: 10%;
    right: -160px;
    background: radial-gradient(circle, rgba(31, 61, 46, 0.12), transparent 70%);
  }

  .vision__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .vision__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 26ch;
  }

  .vision__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .vision__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .vision__paragraph {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .vision__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--color-line);
  }

  .vision-stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    margin: -20px;
    border-radius: var(--radius-card-sm);
    transition: background-color 0.3s ease;
  }

  .vision-stat:hover {
    background: var(--color-glass-strong);
  }

  .vision-stat:hover .emoji-live {
    animation: emoji-wiggle 0.6s ease;
  }

  .vision-stat__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-line);
    font-size: 1.1875rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .vision-stat:hover .vision-stat__icon {
    background: var(--color-surface);
    border-color: var(--color-accent-2);
  }

  .vision-stat__valeur {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    font-weight: 600;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent-2),
      var(--color-accent)
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 4s linear infinite;
  }

  @keyframes shimmer {
    to {
      background-position: -200% center;
    }
  }

  .vision-stat__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .vision__block {
    margin-top: 64px;
  }

  .vision__block-title {
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    color: var(--color-ink);
    max-width: 32ch;
  }

  /* Visuel 1 — le flux compréhension → structure → habillage, relié par
     des flèches pour rendre le déroulé visible en un coup d'œil. */
  .vision-flow {
    display: grid;
    grid-template-columns: 1fr 32px 1fr 32px 1fr;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
  }

  .vision-flow__step {
    height: 100%;
    min-height: 300px;
  }

  .vision-flow__step .flip-card__front {
    padding: 28px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .vision-flow__step .flip-card__back {
    padding: 26px;
  }

  .vision-flow__step .flip-card__back p {
    font-size: 0.875rem;
  }

  .vision-flow__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-line);
    font-size: 1.1875rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .glass-card:hover .vision-flow__icon {
    background: var(--color-surface);
    border-color: var(--color-accent-2);
  }

  .vision-flow__titre {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .vision-flow__methodes {
    display: flex;
    flex-direction: column;
    gap: 6px;
    list-style: none;
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .vision-flow__methodes li {
    position: relative;
    padding-left: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .vision-flow__methodes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
  }

  .vision-flow__arrow {
    text-align: center;
    font-size: 1.375rem;
    color: var(--color-accent-2);
    animation: emoji-float 3s ease-in-out infinite;
  }

  /* Visuel 2 — quatre bénéfices concrets, même grammaire visuelle que les
     problématiques mais tournée vers l'apport plutôt que le manque. */
  .vision-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .vision-benefit {
    padding: 26px;
  }

  .vision-benefit__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--gradient-accent);
    font-size: 1.0625rem;
  }

  .vision-benefit__titre {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .vision-benefit__texte {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .vision {
      padding: 64px 0;
    }

    .vision__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .vision__stats {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 48px;
    }

    .vision__block {
      margin-top: 48px;
    }

    .vision-flow {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vision-flow__arrow {
      display: none;
    }

    .vision-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .vision-benefits {
      grid-template-columns: 1fr;
    }
  }
</style>
