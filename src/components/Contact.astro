---
const email = 'sya.creates@gmail.com';
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<section class="contact" id="contact">
  <span class="blob blob--contact" aria-hidden="true"></span>

  <div class="contact__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Contact
    </span>

    <h2 class="contact__title">Trois façons simples de démarrer la conversation.</h2>

    <p class="contact__intro">
      Choisis ce qui te convient le mieux — un créneau dans l'agenda, un email direct, ou
      quelques minutes pour cadrer ton besoin.
    </p>

    <div class="contact__channels">
      <div class="channel-card glass-card reveal-item" style="--i: 0">
        <span class="channel-card__symbol" aria-hidden="true">→</span>
        <h3 class="channel-card__titre">Prendre rendez-vous</h3>
        <p class="channel-card__texte">Réserve un créneau directement dans mon agenda.</p>
        <a
          href="https://calendly.com/sya-creates"
          class="btn btn--primary channel-card__cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ouvrir Calendly
        </a>
        <span class="channel-card__note">Lien Calendly à connecter</span>
      </div>

      <div class="channel-card glass-card reveal-item" style="--i: 1">
        <span class="channel-card__symbol" aria-hidden="true">@</span>
        <h3 class="channel-card__titre">Email direct</h3>
        <p class="channel-card__texte">Pour une question rapide ou un premier contact informel.</p>
        <p class="channel-card__email" id="contact-email">{email}</p>
        <div class="channel-card__email-actions">
          <button type="button" class="link-underline" id="copy-email-btn" data-email={email}>
            Copier l'adresse
          </button>
          <a href={`mailto:${email}`} class="link-underline">Envoyer un email</a>
        </div>
      </div>

      <div class="channel-card glass-card reveal-item" style="--i: 2">
        <span class="channel-card__symbol" aria-hidden="true">✎</span>
        <h3 class="channel-card__titre">Formulaire de cadrage</h3>
        <p class="channel-card__texte">
          Décris ton besoin en quelques minutes, je reviens vers toi avec une proposition.
        </p>
        <a href="#formulaire-cadrage" class="link-underline channel-card__cta">
          Remplir le formulaire ↓
        </a>
      </div>
    </div>

    <div class="contact__form-wrap glass-panel" id="formulaire-cadrage">
      <h3 class="contact__form-title">Formulaire de cadrage</h3>
      <p class="contact__form-subtitle">
        Quelques questions courtes pour comprendre ton besoin avant notre échange.
      </p>

      <form class="contact-form" id="cadrage-form">
        <input type="hidden" name="access_key" value={web3formsAccessKey} />

        <div class="contact-form__field">
          <label for="nom">Prénom et nom</label>
          <input type="text" id="nom" name="nom" required />
        </div>

        <div class="contact-form__field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="contact-form__field contact-form__field--full">
          <label for="entreprise">Entreprise ou secteur d'activité</label>
          <input type="text" id="entreprise" name="entreprise" />
        </div>

        <div class="contact-form__field">
          <label for="besoin">Besoin principal</label>
          <select id="besoin" name="besoin" required>
            <option value="">Sélectionner…</option>
            <option>Discovery</option>
            <option>UX Design</option>
            <option>UI Design</option>
            <option>Fast Integration</option>
            <option>Strategy / Marketing</option>
            <option>UX Audit</option>
            <option>Ongoing Support</option>
            <option>Je ne sais pas encore</option>
          </select>
        </div>

        <div class="contact-form__field">
          <label for="stade">Stade du projet</label>
          <select id="stade" name="stade">
            <option value="">Sélectionner…</option>
            <option>Idée</option>
            <option>MVP existant</option>
            <option>Produit en production à améliorer</option>
          </select>
        </div>

        <div class="contact-form__field contact-form__field--full">
          <label for="delai">Délai souhaité</label>
          <select id="delai" name="delai">
            <option value="">Sélectionner…</option>
            <option>Urgent (moins d'1 mois)</option>
            <option>1 à 3 mois</option>
            <option>Pas de contrainte de délai</option>
          </select>
        </div>

        <div class="contact-form__field contact-form__field--full">
          <label for="message">Message libre <span class="contact-form__optional">(optionnel)</span></label>
          <textarea id="message" name="message" rows="4"></textarea>
        </div>

        <input type="checkbox" name="botcheck" class="contact-form__honeypot" tabindex="-1" autocomplete="off" />

        <div class="contact-form__field contact-form__field--full contact-form__submit-row">
          <button type="submit" class="btn btn--primary" id="cadrage-submit">
            Envoyer ma demande de cadrage
          </button>
          <p class="contact-form__reassurance">Réponse sous 24 à 48h ouvrées.</p>
        </div>

        <p class="contact-form__success" id="cadrage-success" role="status">
          Merci ! Ta demande a bien été prise en compte, je reviens vers toi rapidement.
        </p>

        <p class="contact-form__error" id="cadrage-error" role="alert">
          L'envoi a échoué. Tu peux réessayer, ou m'écrire directement à <a href={`mailto:${email}`}>{email}</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  copyBtn?.addEventListener('click', async () => {
    const emailValue = copyBtn.getAttribute('data-email') || '';
    try {
      await navigator.clipboard.writeText(emailValue);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copié !';
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    } catch {
      // clipboard indisponible — l'utilisateur peut toujours utiliser le lien mailto
    }
  });

  const form = document.getElementById('cadrage-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('cadrage-submit') as HTMLButtonElement | null;
  const successMessage = document.getElementById('cadrage-success');
  const errorMessage = document.getElementById('cadrage-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.remove('contact-form__error--visible');

    const formData = new FormData(form);
    formData.append('subject', 'Nouvelle demande de cadrage — Sya Creates');

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours…';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        form.hidden = true;
        successMessage?.classList.add('contact-form__success--visible');
      } else {
        throw new Error(result.message || 'submission failed');
      }
    } catch {
      errorMessage?.classList.add('contact-form__error--visible');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma demande de cadrage';
      }
    }
  });
</script>

<style>
  .contact {
    position: relative;
    padding: 96px 24px;
    overflow: hidden;
  }

  .blob--contact {
    width: 420px;
    height: 420px;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(76, 140, 99, 0.14), transparent 70%);
  }

  .contact__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .contact__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 30ch;
  }

  .contact__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  .contact__channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
  }

  .channel-card__symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    margin-bottom: 18px;
  }

  .channel-card__titre {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .channel-card__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    flex-grow: 1;
  }

  .channel-card__cta {
    margin-top: 20px;
  }

  .channel-card__note {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-secondary);
    opacity: 0.7;
    margin-top: 8px;
  }

  .channel-card__email {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-ink);
    margin-top: 16px;
    word-break: break-all;
  }

  .channel-card__email-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 16px;
  }

  .contact__form-wrap {
    margin-top: 56px;
    padding: 48px;
  }

  .contact__form-title {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact__form-subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-top: 10px;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 32px;
    margin: 40px auto 0;
    max-width: 760px;
  }

  .contact-form[hidden] {
    display: none;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 10px;
  }

  .contact-form__optional {
    text-transform: none;
    font-family: var(--font-body);
    letter-spacing: normal;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card-sm);
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .contact-form__submit-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 8px;
  }

  .contact-form__reassurance {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .contact-form__success {
    display: none;
    grid-column: 1 / -1;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
    padding: 20px 0;
  }

  .contact-form__success--visible {
    display: block;
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .contact-form__error {
    display: none;
    grid-column: 1 / -1;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-accent-2);
    margin-top: -8px;
  }

  .contact-form__error--visible {
    display: block;
  }

  @media (max-width: 860px) {
    .contact {
      padding: 64px 20px;
    }

    .contact__channels {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }

    .contact__form-wrap {
      margin-top: 40px;
      padding: 28px;
    }

    .contact-form {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .contact-form__field--full {
      grid-column: auto;
    }
  }
</style>
