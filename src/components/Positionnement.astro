---
const piliers = [
  {
    numero: '01',
    titre: 'Expertise UX/UI',
    texte:
      "Dix ans de pratique produit : interviews, tri de cartes, wireframes, tests d'utilisabilité — de la recherche utilisateur au design d'interface, dont plusieurs années sur des sujets de transformation RH et d'innovation au sein de grandes organisations.",
  },
  {
    numero: '02',
    titre: 'AI-assisted development',
    texte:
      "Le code va aussi vite que le design. Les outils d'IA accélèrent le prototypage et l'intégration, pour livrer des interfaces fonctionnelles en jours, pas en mois.",
  },
  {
    numero: '03',
    titre: "Rapidité d'exécution",
    texte:
      "Moins d'allers-retours, moins d'incertitude : une méthode resserrée qui va du cadrage à la mise en ligne sans perdre en qualité ni en clarté.",
  },
];
---

<section class="positioning" id="positionnement">
  <span class="blob blob--positioning" aria-hidden="true"></span>
  <div class="positioning__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Positionnement
    </span>

    <div class="title-flanked">
      <span class="title-flanked__line" aria-hidden="true" />
      <h2 class="positioning__title">
        Le design comme métier, <em>l'IA comme accélérateur.</em>
      </h2>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="positioning__intro">
      Dix ans à concevoir des produits pour des équipes exigeantes m'ont appris qu'un bon
      design, ce n'est pas juste une interface soignée : c'est une méthode. Le développement
      assisté par IA ne la remplace pas — il me fait juste aller plus vite, sans rogner sur la
      qualité.
    </p>

    <div class="positioning__pillars">
      {
        piliers.map((pilier, index) => (
          <div
            class="pillar glass-card reveal-item flip-card"
            style={`--i: ${index}`}
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label={`${pilier.titre} — appuie pour voir le détail`}
          >
            <div class="flip-card__inner">
              <div class="flip-card__front">
                <div class="pillar__header">
                  <span class="pillar__numero">{pilier.numero}</span>
                </div>
                <h3 class="pillar__titre">{pilier.titre}</h3>
              </div>
              <div class="flip-card__back">
                <p>{pilier.texte}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .positioning {
    position: relative;
    padding: var(--section-py) 24px;
    overflow: hidden;
  }

  .blob--positioning {
    width: 400px;
    height: 400px;
    bottom: -140px;
    right: -140px;
    background: radial-gradient(circle, rgba(214, 178, 110, 0.14), transparent 70%);
  }

  .positioning__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .positioning__title {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 28ch;
  }

  .positioning .title-flanked {
    margin-top: 20px;
  }

  .positioning__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .positioning__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 24px auto 0;
    text-align: center;
  }

  .positioning__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .pillar {
    min-height: 240px;
  }

  .pillar .flip-card__front {
    padding: 32px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .pillar .flip-card__back {
    padding: 28px;
  }

  .pillar .flip-card__back p {
    font-size: 0.875rem;
  }

  .pillar__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .pillar__numero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gradient-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .pillar__titre {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 12px;
  }


  @media (max-width: 860px) {
    .positioning {
      padding: var(--section-py-mobile) 20px;
    }

    .positioning__pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
