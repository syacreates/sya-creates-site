---
// Étude de cas produit — voir tache-claude-code-section-pinlove.md pour le
// brief complet (structure/copy/logique de couleurs viennent de la maquette
// de référence ; l'implémentation CSS réutilise les tokens/composants
// existants du site plutôt que le CSS inline de cette maquette).
import { Image } from 'astro:assets';
import stampIcon from '../assets/pinlove/pinlove-stamp.png';
import screenPresentation from '../assets/pinlove/pinlove-screen-presentation.png';
import screenCarte from '../assets/pinlove/pinlove-screen-carte.png';
import screenFiche from '../assets/pinlove/pinlove-screen-fiche.png';
import screenPartage from '../assets/pinlove/pinlove-screen-partage.png';
import photoKiosque from '../assets/pinlove/pinlove-photo-kiosque.jpg';
import photoBanc from '../assets/pinlove/pinlove-photo-banc.jpg';

const phoneScreens = [
  { src: screenPresentation, alt: "Capture de l'application PinLove : écran de présentation, ne perds plus jamais un spot" },
  { src: screenCarte, alt: "Capture de l'application PinLove : la carte avec les lieux épinglés" },
  { src: screenFiche, alt: "Capture de l'application PinLove : ajout d'un nouveau lieu" },
  { src: screenPartage, alt: "Capture de l'application PinLove : import direct depuis TikTok ou Instagram" },
];

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

const faits = [
  {
    label: 'Challenge',
    texte:
      "Faire tenir un produit mobile complet — design, développement, infra — sur les épaules d'une seule personne, sans sacrifier la qualité.",
  },
  {
    label: 'Signature',
    texte:
      'Une identité pensée comme un vrai produit : cœur en dégradé brass→cerise, tampon, ton chaleureux — le même soin que pour mes clients.',
  },
];

const fonctionnalites = [
  {
    titre: 'Épingler un lieu',
    texte:
      "On dépose un point sur la carte, on y attache une photo ou un mot, et le souvenir reste à cet endroit précis.",
  },
  {
    titre: 'Partager depuis TikTok ou Instagram',
    texte:
      'On envoie une vidéo repérée ailleurs directement vers PinLove : le lieu et la carte se remplissent seuls.',
  },
  {
    titre: 'Garder ça entre proches',
    texte:
      "Chaque carte se partage avec qui on veut, pour construire ensemble l'atlas des endroits qui comptent.",
  },
];

const stackChips = ['Expo', 'Supabase', 'Firebase', 'Stripe', 'Google Maps API', 'Vercel'];

const roles = [
  {
    titre: 'Design',
    texte: 'Identité de marque, tampon signature et cœur en dégradé brass→cerise, parcours utilisateur complet.',
  },
  {
    titre: 'Développement',
    texte: "App mobile fonctionnelle, géocodage automatique, extension de partage en cours d'intégration.",
  },
  {
    titre: 'Cadrage produit',
    texte: 'Choix techniques et arbitrages de coûts pensés dès le départ pour rester soutenable en solo.',
  },
];
---

<section class="pinlove" id="pinlove">
  <span class="blob blob--pinlove" aria-hidden="true"></span>

  <div class="pinlove__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Projet indépendant · Design &amp; développement
    </span>

    <div class="title-flanked">
      <span class="title-flanked__line" aria-hidden="true" />
      <h2 class="pinlove__title">
        Chaque lieu garde <em>une histoire.</em>
      </h2>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="pinlove__subtitle">
      PinLove épingle les endroits qui comptent, y accroche un souvenir, et le partage avec les
      personnes qu'on aime — même depuis TikTok ou Instagram.
    </p>

    <div class="pinlove__hero">
      <div class="pinlove__ctas">
        <a href="#pinlove-waitlist" class="btn btn--primary">Rejoindre la liste d'attente</a>
        <!-- Pas de page projet détaillée à ce jour — lien à cibler vers une
             étude de cas ou le site PinLove une fois disponible. -->
        <a href="#" class="link-underline">Voir le projet en détail</a>
      </div>

      <!-- Visuel signature : mockup téléphone + 2 polaroids + tampon, façon
           corkboard. Recréé en CSS/SVG (pas les assets de la maquette de
           référence), avec le vrai cœur PinLove extrait du brief. Seul le
           mockup téléphone est réellement interactif (flèches de
           navigation) : aria-hidden retiré du conteneur global et posé
           élément par élément sur le reste, purement décoratif. -->
      <div class="pinlove__board">
        <svg class="pinlove__thread" viewBox="0 0 400 460" preserveAspectRatio="none" aria-hidden="true">
          <path d="M50,100 C110,145 145,200 190,225" />
          <path d="M340,360 C285,325 250,290 210,245" />
        </svg>
        <span class="pinlove__pinhead" style="left:46px; top:92px;" aria-hidden="true" />
        <span class="pinlove__pinhead" style="right:46px; bottom:108px;" aria-hidden="true" />

        <div class="pinlove__stamp" aria-hidden="true">
          <Image src={stampIcon} alt="" width="200" height="177" />
        </div>

        <div class="pinlove__polaroid pinlove__polaroid--1" aria-hidden="true">
          <div class="pinlove__polaroid-pic">
            <Image src={photoKiosque} alt="" width="200" height="144" />
          </div>
          <p class="pinlove__polaroid-cap">le kiosque, 8h12</p>
        </div>

        <div class="pinlove__polaroid pinlove__polaroid--2" aria-hidden="true">
          <div class="pinlove__polaroid-pic">
            <Image src={photoBanc} alt="" width="200" height="144" />
          </div>
          <p class="pinlove__polaroid-cap">notre banc</p>
        </div>

        <div class="pinlove__phone">
          <div class="pinlove__phone-screen" id="pinlove-phone-screen">
            <!-- Vraies captures de l'app (carte, ajout d'un lieu, import
                 TikTok/Instagram), navigables aux flèches (voir <script>
                 plus bas) plutôt qu'en fondu automatique. -->
            {
              phoneScreens.map((screen, i) => (
                <Image
                  src={screen.src}
                  alt={screen.alt}
                  width="172"
                  height="344"
                  class="pinlove__phone-shot"
                  data-index={i}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  class:list={[{ 'is-active': i === 0 }]}
                />
              ))
            }
          </div>
          <button
            type="button"
            class="pinlove__phone-nav pinlove__phone-nav--prev"
            id="pinlove-phone-prev"
            aria-label="Écran précédent"
          >
            ‹
          </button>
          <button
            type="button"
            class="pinlove__phone-nav pinlove__phone-nav--next"
            id="pinlove-phone-next"
            aria-label="Écran suivant"
          >
            ›
          </button>
        </div>
      </div>
    </div>

    <div class="pinlove__facts">
      {
        faits.map((fait, index) => (
          <div class="pinlove-fact reveal-item" style={`--i: ${index}`}>
            <span class="pinlove-fact__label">{fait.label}</span>
            <p class="pinlove-fact__texte">{fait.texte}</p>
          </div>
        ))
      }
    </div>

    <div class="pinlove__features-head">
      <span class="eyebrow-pill">
        <span class="eyebrow-pill__dot"></span>
        Ce qu'on peut faire
      </span>
      <h3 class="pinlove__features-title">Un lieu, un souvenir, une personne à qui l'envoyer.</h3>
    </div>

    <div class="pinlove__features">
      {
        fonctionnalites.map((item, index) => (
          <div class="pinlove-feature glass-card reveal-item" style={`--i: ${index}`}>
            <span class="pinlove-feature__mark" aria-hidden="true" />
            <h4 class="pinlove-feature__titre">{item.titre}</h4>
            <p class="pinlove-feature__texte">{item.texte}</p>
          </div>
        ))
      }
    </div>

    <div class="pinlove__coulisses">
      <div class="pinlove-coulisses__intro">
        <span class="eyebrow-pill">
          <span class="eyebrow-pill__dot"></span>
          Dans les coulisses
        </span>
        <h3 class="pinlove-coulisses__titre">Un projet mené de bout en bout.</h3>
        <p class="pinlove-coulisses__texte">
          De l'identité visuelle — un cœur en dégradé brass vers cerise, affiné après plusieurs
          rondes de simplification — jusqu'à l'architecture technique et sa distribution, chaque
          brique a été construite et testée à la main.
        </p>
        <div class="pinlove-coulisses__chips">
          {stackChips.map((chip) => <span class="tag-pill">{chip}</span>)}
        </div>
      </div>

      <div class="pinlove-coulisses__roles">
        {
          roles.map((role) => (
            <div class="pinlove-role">
              <span class="pinlove-role__dot" aria-hidden="true" />
              <div>
                <h4 class="pinlove-role__titre">{role.titre}</h4>
                <p class="pinlove-role__texte">{role.texte}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="pinlove__final-cta" id="pinlove-waitlist">
      <h3 class="pinlove-final-cta__titre">Envie de suivre l'aventure PinLove ?</h3>

      <form class="pinlove-waitlist-form" id="pinlove-waitlist-form" novalidate>
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="Liste d'attente PinLove — Sya Creates" />
        <input
          type="checkbox"
          name="botcheck"
          class="pinlove-waitlist-form__honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <label class="pinlove-waitlist-form__field">
          <span class="pinlove-waitlist-form__sr-label">Adresse email</span>
          <input
            type="email"
            name="email"
            id="pinlove-waitlist-email"
            placeholder="votre email"
            required
            aria-describedby="pinlove-waitlist-error"
          />
          <button type="submit" class="btn btn--primary" id="pinlove-waitlist-submit">S'inscrire</button>
        </label>

        <p class="pinlove-waitlist-form__success" id="pinlove-waitlist-success" role="status">
          Merci ! Tu seras prévenu·e dès que PinLove ouvre ses portes.
        </p>
        <p class="pinlove-waitlist-form__error" id="pinlove-waitlist-error" role="alert">
          L'inscription a échoué. Réessaie, ou écris directement à sya.creates@gmail.com.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('pinlove-waitlist-form') as HTMLFormElement | null;
  const emailField = document.getElementById('pinlove-waitlist-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('pinlove-waitlist-submit') as HTMLButtonElement | null;
  const successMessage = document.getElementById('pinlove-waitlist-success');
  const errorMessage = document.getElementById('pinlove-waitlist-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.remove('pinlove-waitlist-form__error--visible');

    if (!emailField?.checkValidity()) {
      emailField?.reportValidity();
      return;
    }

    const formData = new FormData(form);

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi…';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        form.hidden = true;
        successMessage?.classList.add('pinlove-waitlist-form__success--visible');
      } else {
        throw new Error(result.message || 'submission failed');
      }
    } catch {
      errorMessage?.classList.add('pinlove-waitlist-form__error--visible');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "S'inscrire";
      }
    }
  });
</script>

<script>
  // Carrousel du mockup téléphone : flèches gauche/droite plutôt qu'un
  // fondu automatique — l'utilisateur garde la main, pas de mouvement
  // imposé en continu sur une section de portfolio.
  const shots = Array.from(
    document.querySelectorAll<HTMLElement>('#pinlove-phone-screen .pinlove__phone-shot')
  );
  const prevBtn = document.getElementById('pinlove-phone-prev');
  const nextBtn = document.getElementById('pinlove-phone-next');

  if (shots.length && prevBtn && nextBtn) {
    let current = shots.findIndex((shot) => shot.classList.contains('is-active'));
    if (current < 0) current = 0;

    function show(index: number) {
      const next = (index + shots.length) % shots.length;
      shots[current].classList.remove('is-active');
      shots[current].setAttribute('aria-hidden', 'true');
      shots[next].classList.add('is-active');
      shots[next].setAttribute('aria-hidden', 'false');
      current = next;
    }

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
  }
</script>

<style>
  /* Tokens locaux à PinLove uniquement : l'accent doré remplace le vert
     sauge ici, sans toucher --color-accent/--color-accent-2 utilisés par
     le reste du site. Les teintes brass/cerise sont propres au produit
     (logo du cœur PinLove) — jamais réutilisées comme accent de section. */
  .pinlove {
    --pin-gold: #d9a441;
    --pin-gold-pale: #ebd09a;
    --pin-ink-on-gold: #14140f;
    --pin-brass: #dca05a;
    --pin-cherry: #f1566a;
    --pin-cherry-deep: #d93753;

    position: relative;
    padding: var(--section-py) 24px;
    overflow: hidden;
  }

  .blob--pinlove {
    width: 420px;
    height: 420px;
    top: -100px;
    right: -140px;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.14), transparent 70%);
  }

  .pinlove__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .pinlove .eyebrow-pill__dot {
    background: var(--pin-gold);
  }

  .pinlove .title-flanked__line {
    background: linear-gradient(to left, var(--pin-gold), transparent);
  }

  .pinlove .title-flanked__line--right {
    background: linear-gradient(to right, var(--pin-gold), transparent);
  }

  .pinlove__title {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 26ch;
    margin: 0 auto;
    text-align: center;
  }

  .pinlove .title-flanked {
    margin-top: 20px;
  }

  .pinlove__title em {
    font-style: italic;
    font-weight: 500;
    color: var(--pin-gold);
  }

  .pinlove__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 56ch;
    margin: 24px auto 0;
    text-align: center;
  }

  .pinlove .btn--primary {
    background: var(--pin-gold);
    color: var(--pin-ink-on-gold);
  }

  .pinlove .link-underline {
    text-decoration-color: var(--pin-gold);
  }

  /* --- Hero : CTA + visuel corkboard --- */
  .pinlove__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    margin-top: 40px;
  }

  .pinlove__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pinlove__board {
    position: relative;
    width: 100%;
    max-width: 420px;
    height: 340px;
  }

  .pinlove__thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--color-text-secondary);
    stroke-width: 1.2;
    fill: none;
    opacity: 0.4;
    stroke-dasharray: 3 4;
  }

  .pinlove__pinhead {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--pin-cherry);
    border: 2px solid var(--color-bg);
    z-index: 4;
  }

  .pinlove__stamp {
    position: absolute;
    top: 0;
    right: 4%;
    width: 96px;
    height: 96px;
    z-index: 5;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.6);
  }

  .pinlove__stamp img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pinlove__polaroid {
    position: absolute;
    width: 92px;
    padding: 8px 8px 16px;
    background: var(--color-ink);
    border-radius: 3px;
    box-shadow: 0 14px 26px -12px rgba(0, 0, 0, 0.55);
    z-index: 2;
  }

  .pinlove__polaroid-pic {
    width: 100%;
    height: 66px;
    border-radius: 1px;
    overflow: hidden;
  }

  .pinlove__polaroid-pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pinlove__polaroid-cap {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.6875rem;
    color: var(--color-bg);
    margin: 6px 0 0;
    text-align: center;
  }

  .pinlove__polaroid--1 {
    left: 0;
    top: 4%;
    transform: rotate(-9deg);
  }

  .pinlove__polaroid--2 {
    right: 0;
    bottom: 4%;
    transform: rotate(7deg);
  }

  .pinlove__phone {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-4deg);
    width: 172px;
    height: 344px;
    background: var(--color-surface);
    border-radius: 28px;
    border: 6px solid #050403;
    box-shadow: 0 26px 60px -20px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    z-index: 3;
  }

  .pinlove__phone-screen {
    position: absolute;
    inset: 0;
    background: radial-gradient(140% 100% at 25% 0%, #4a2e12 0%, #2a0e10 55%, var(--color-surface) 100%);
  }

  /* Les 3 vraies captures de l'app se succèdent au clic sur les flèches
     (voir <script> plus haut) plutôt qu'en fondu automatique imposé. */
  .pinlove__phone-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .pinlove__phone-shot.is-active {
    opacity: 1;
  }

  .pinlove__phone-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-glass-border);
    background: var(--color-glass-strong);
    color: var(--color-ink);
    font-size: 16px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    transition: background 0.15s ease;
  }

  .pinlove__phone-nav:hover {
    background: var(--color-glass);
  }

  .pinlove__phone-nav--prev {
    left: 8px;
  }

  .pinlove__phone-nav--next {
    right: 8px;
  }

  /* --- Bandeau faits --- */
  .pinlove__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 64px;
    padding: 32px 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .pinlove-fact {
    padding: 0 28px;
    border-left: 1px solid var(--color-line);
  }

  .pinlove-fact:first-child {
    border-left: none;
    padding-left: 0;
  }

  .pinlove-fact__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pin-gold);
    margin-bottom: 10px;
  }

  .pinlove-fact__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* --- Fonctionnalités --- */
  .pinlove__features-head {
    max-width: 560px;
    margin: 64px auto 0;
    text-align: center;
  }

  .pinlove__features-title {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 14px;
  }

  .pinlove__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1080px;
    margin: 40px auto 0;
  }

  .pinlove-feature {
    padding: 30px 26px;
  }

  .pinlove-feature__mark {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--pin-brass), var(--pin-cherry));
    margin-bottom: 20px;
  }

  .pinlove-feature__titre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-ink);
    margin: 0 0 10px;
  }

  .pinlove-feature__texte {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* --- Coulisses --- */
  .pinlove__coulisses {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    margin-top: 72px;
    padding-top: 56px;
    border-top: 1px solid var(--color-line);
  }

  .pinlove-coulisses__titre {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    color: var(--pin-gold-pale);
    margin: 14px 0 18px;
  }

  .pinlove-coulisses__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 46ch;
  }

  .pinlove-coulisses__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .pinlove-coulisses__roles {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
  }

  .pinlove-role {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .pinlove-role__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pin-gold);
    margin-top: 7px;
    flex-shrink: 0;
  }

  .pinlove-role__titre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
    margin: 0 0 4px;
  }

  .pinlove-role__texte {
    font-family: var(--font-body);
