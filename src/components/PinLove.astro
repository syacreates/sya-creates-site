---
// Étude de cas produit — PinLove, dans sa DA actuelle (thème « Cerise » de
// l'appli : fond crème, accent cerise, Fraunces + DM Sans, épingle-cœur).
// La section sort volontairement du noir du site : c'est l'univers du
// produit qu'on montre, pas celui du studio. Couleurs et visuels repris tels
// quels du dépôt de l'appli (lib/design-tokens.ts, public/logo.svg,
// public/landing/, public/ambiance/).
import { Image } from 'astro:assets';
import affiche from '../assets/pinlove/pinlove-affiche.webp';
import photoTerrasse from '../assets/pinlove/couple-terrasse.webp';
import photoRooftop from '../assets/pinlove/amies-rooftop.webp';
import photoCanal from '../assets/pinlove/velo-canal.webp';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

const atouts = [
  { icone: 'pin', texte: 'Crée ta carte' },
  { icone: 'etincelle', texte: 'Découvre de nouveaux lieux' },
  { icone: 'groupe', texte: 'Seul ou à plusieurs' },
];

const faits = [
  {
    label: 'Challenge',
    texte:
      "Faire tenir un produit mobile complet — design, développement, infra — sur les épaules d'une seule personne, sans sacrifier la qualité.",
  },
  {
    label: 'Signature',
    texte:
      "Une identité pensée comme un vrai produit : l'épingle-cœur cerise, un fond crème chaleureux, Fraunces et DM Sans, des photos de vie partagée — le même soin que pour mes clients.",
  },
];

const fonctionnalites = [
  {
    icone: 'lien',
    titre: 'Importer depuis Instagram ou TikTok',
    texte:
      'On colle le lien d’une vidéo repérée, ou on la partage vers PinLove : le lieu se place tout seul sur la carte.',
    photo: photoTerrasse,
    legende: 'vu sur TikTok, testé vendredi',
  },
  {
    icone: 'etincelle',
    titre: 'Découvrir de nouveaux lieux',
    texte:
      'Restaurants, culture, balades, sorties : la carte se remplit d’idées triées par envie, autour de soi ou en voyage.',
    photo: photoCanal,
    legende: 'balade du dimanche',
  },
  {
    icone: 'groupe',
    titre: 'Seul ou à plusieurs',
    texte:
      'Chaque carte se partage avec qui on veut, pour construire ensemble la liste des endroits qui comptent.',
    photo: photoRooftop,
    legende: 'le rooftop des copines',
  },
];
---

<section class="pinlove" id="pinlove">
  <svg class="pinlove__defs" aria-hidden="true" focusable="false">
    <symbol id="pl-icone-pin" viewBox="0 0 24 24">
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.6" />
    </symbol>
    <symbol id="pl-icone-etincelle" viewBox="0 0 24 24">
      <path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z" />
    </symbol>
    <symbol id="pl-icone-groupe" viewBox="0 0 24 24">
      <circle cx="9" cy="8.5" r="3" />
      <path d="M3.5 19c.4-3.2 2.6-5 5.5-5s5.1 1.8 5.5 5" />
      <circle cx="16.5" cy="9.5" r="2.4" />
      <path d="M15.5 14.2c2.6-.2 4.6 1.4 5 4.3" />
    </symbol>
    <symbol id="pl-icone-lien" viewBox="0 0 24 24">
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
      <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
    </symbol>
  </svg>

  <div class="pinlove__inner">
    <div class="pinlove__hero">
      <div class="pinlove__intro">
        <span class="pinlove__eyebrow">Projet indépendant · Design &amp; développement</span>

        <p class="pinlove__logo">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="38" fill="none" stroke="#C8243F" stroke-width="3.4" stroke-dasharray="11.2 8.7" stroke-dashoffset="5.6" transform="rotate(-90 50 50)" />
            <ellipse cx="50" cy="73.2" rx="6.6" ry="1.9" fill="#C8243F" fill-opacity=".55" />
            <path d="M48.4 60v12a1.6 1.6 0 0 0 3.2 0V60Z" fill="#9E1B31" />
            <path d="M50 64.7C39.5 58 33.5 51.6 33.5 44.1 33.5 38.5 38 34 43.6 34c3.3 0 6 1.5 6.4 3.75C50.4 35.5 53.1 34 56.4 34 62 34 66.5 38.5 66.5 44.1 66.5 51.6 60.5 58 50 64.7Z" fill="#C8243F" />
          </svg>
          <span>Pin<span class="pinlove__logo-love">Love</span></span>
        </p>

        <h2 class="pinlove__title">
          Transforme tes inspirations en <em>une carte de lieux.</em>
        </h2>

        <p class="pinlove__subtitle">
          On importe les liens Instagram ou TikTok, ou on les envoie à PinLove : les lieux se placent
          automatiquement sur la carte, prêts à être partagés avec les personnes qu'on aime.
        </p>

        <ul class="pinlove__atouts">
          {
            atouts.map((atout) => (
              <li class="pinlove-atout">
                <span class="pinlove-icone" aria-hidden="true">
                  <svg><use href={`#pl-icone-${atout.icone}`} /></svg>
                </span>
                {atout.texte}
              </li>
            ))
          }
        </ul>

        <a href="https://pinlove.app" class="pinlove__cta" target="_blank" rel="noopener">
          Créer ma carte
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <div class="pinlove__visuel">
        <div class="pinlove__affiche">
          <Image
            src={affiche}
            alt="Affiche PinLove : « Transforme tes inspirations en une carte de lieux. » Un téléphone affiche la carte PinLove, entourée de lieux importés depuis Instagram et TikTok."
            widths={[320, 480, 640]}
            sizes="(max-width: 860px) 300px, 400px"
            loading="lazy"
          />
        </div>
        <figure class="pinlove-polaroid pinlove-polaroid--a" aria-hidden="true">
          <Image src={photoTerrasse} alt="" widths={[200, 320]} sizes="160px" loading="lazy" />
          <figcaption>notre terrasse</figcaption>
        </figure>
        <figure class="pinlove-polaroid pinlove-polaroid--b" aria-hidden="true">
          <Image src={photoRooftop} alt="" widths={[200, 320]} sizes="160px" loading="lazy" />
          <figcaption>coucher de soleil, 21h</figcaption>
        </figure>
      </div>
    </div>

    <div class="pinlove__facts">
      {
        faits.map((fait, index) => (
          <div class="pinlove-fact reveal-item" style={`--i: ${index}`}>
            <span class="pinlove-fact__label">{fait.label}</span>
            <p class="pinlove-fact__texte">{fait.texte}</p>
          </div>
        ))
      }
    </div>

    <div class="pinlove__features-head">
      <span class="pinlove__eyebrow">Ce qu'on peut faire</span>
      <h3 class="pinlove__features-title">Un lien repéré, un lieu sur la carte, des proches avec qui y aller.</h3>
    </div>

    <div class="pinlove__features">
      {
        fonctionnalites.map((item, index) => (
          <article class="pinlove-feature reveal-item" style={`--i: ${index}`}>
            <div class="pinlove-feature__photo">
              <Image src={item.photo} alt="" widths={[360, 540]} sizes="(max-width: 860px) 90vw, 340px" loading="lazy" />
              <span class="pinlove-feature__legende" aria-hidden="true">{item.legende}</span>
            </div>
            <div class="pinlove-feature__corps">
              <span class="pinlove-icone" aria-hidden="true">
                <svg><use href={`#pl-icone-${item.icone}`} /></svg>
              </span>
              <h4 class="pinlove-feature__titre">{item.titre}</h4>
              <p class="pinlove-feature__texte">{item.texte}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="pinlove__final-cta" id="pinlove-waitlist">
      <h3 class="pinlove-final-cta__titre">Envie de suivre l'aventure <em>PinLove</em> ?</h3>

      <a href="https://pinlove.app" class="pinlove-final-cta__link" target="_blank" rel="noopener">
        Découvrir pinlove.app
      </a>

      <form class="pinlove-waitlist-form" id="pinlove-waitlist-form" novalidate>
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="Liste d'attente PinLove — Sya Creates" />
        <input
          type="checkbox"
          name="botcheck"
          class="pinlove-waitlist-form__honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <label class="pinlove-waitlist-form__field">
          <span class="pinlove-waitlist-form__sr-label">Adresse email</span>
          <input
            type="email"
            name="email"
            id="pinlove-waitlist-email"
            placeholder="votre email"
            required
            aria-describedby="pinlove-waitlist-error"
          />
          <button type="submit" class="pinlove-waitlist-form__submit" id="pinlove-waitlist-submit">S'inscrire</button>
        </label>

        <p class="pinlove-waitlist-form__success" id="pinlove-waitlist-success" role="status">
          Merci ! Tu seras prévenu·e dès que PinLove ouvre ses portes.
        </p>
        <p class="pinlove-waitlist-form__error" id="pinlove-waitlist-error" role="alert">
          L'inscription a échoué. Réessaie, ou écris directement à sya.creates@gmail.com.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('pinlove-waitlist-form') as HTMLFormElement | null;
  const emailField = document.getElementById('pinlove-waitlist-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('pinlove-waitlist-submit') as HTMLButtonElement | null;
  const successMessage = document.getElementById('pinlove-waitlist-success');
  const errorMessage = document.getElementById('pinlove-waitlist-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.remove('pinlove-waitlist-form__error--visible');

    if (!emailField?.checkValidity()) {
      emailField?.reportValidity();
      return;
    }

    const formData = new FormData(form);

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi…';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        form.hidden = true;
        successMessage?.classList.add('pinlove-waitlist-form__success--visible');
      } else {
        throw new Error(result.message || 'submission failed');
      }
    } catch {
      errorMessage?.classList.add('pinlove-waitlist-form__error--visible');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "S'inscrire";
      }
    }
  });
</script>

<style>
  /* Tokens locaux à PinLove uniquement — thème « Cerise » de l'appli
     (lib/design-tokens.ts du dépôt pinlove). Jamais réutilisés ailleurs sur
     le site, qui garde son propre noir/anthracite. */
  .pinlove {
    --pin-bg: #f7f3ef;
    --pin-surface: #ffffff;
    --pin-ink: #1e1a1a;
    --pin-ink-soft: #4a4341;
    --pin-muted: #6b6360;
    --pin-accent: #c8243f;
    --pin-accent-dark: #9e1b31;
    --pin-accent-light: #fbedef;
    --pin-accent-tag: #f6dde1;
    --pin-line: #d9d0c8;
    --pin-font: 'DM Sans', -apple-system, sans-serif;
    --pin-hand: 'Caveat', 'Bradley Hand', cursive;

    position: relative;
    padding: var(--section-py) 24px;
    overflow: hidden;
    /* Plus spécifique que main > section:nth-of-type(…) : la section garde
       son fond crème quelle que soit sa place dans la page. */
    background: var(--pin-bg) !important;
    color: var(--pin-ink);
    color-scheme: light;
  }

  /* Halo cerise très doux, comme la lumière chaude de l'affiche */
  .pinlove::before {
    content: '';
    position: absolute;
    width: 720px;
    height: 720px;
    top: -260px;
    right: -220px;
    background: radial-gradient(circle, rgba(200, 36, 63, 0.1), transparent 65%);
    pointer-events: none;
  }

  .pinlove__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  .pinlove :focus-visible {
    outline-color: var(--pin-accent);
  }

  .pinlove__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .pinlove__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-family: var(--pin-font);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pin-accent-dark);
    background: var(--pin-accent-light);
    border-radius: var(--radius-pill);
  }

  .pinlove__eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pin-accent);
  }

  /* --- Hero : texte à gauche, affiche à droite --- */
  .pinlove__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .pinlove__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 28px 0 0;
    font-family: var(--pin-font);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.02em;
    color: var(--pin-ink);
  }

  .pinlove__logo svg {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
  }

  .pinlove__logo-love {
    color: var(--pin-accent);
  }

  .pinlove__title {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 3.2vw, 3.6rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--pin-ink);
    max-width: 16ch;
  }

  .pinlove__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--pin-accent);
  }

  .pinlove__subtitle {
    font-family: var(--pin-font);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--pin-ink-soft);
    max-width: 48ch;
    margin-top: 20px;
  }

  .pinlove__atouts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin: 28px 0 0;
    padding: 0;
  }

  .pinlove-atout {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--pin-font);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--pin-ink);
  }

  .pinlove-icone {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--pin-accent-tag);
    color: var(--pin-accent);
  }

  .pinlove-icone svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pinlove__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
    padding: 17px 32px;
    font-family: var(--pin-font);
    font-weight: 700;
    font-size: 1.0625rem;
    color: #fff;
    text-decoration: none;
    background: var(--pin-accent);
    border-radius: var(--radius-pill);
    box-shadow: 0 14px 30px -14px rgba(200, 36, 63, 0.7);
    transition: transform 0.35s var(--ease-spring), box-shadow 0.35s var(--ease-spring),
      background-color 0.2s ease;
  }

  .pinlove__cta svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease-spring);
  }

  .pinlove__cta:hover {
    background: var(--pin-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 20px 38px -16px rgba(200, 36, 63, 0.75);
  }

  .pinlove__cta:hover svg {
    transform: translateX(4px);
  }

  .pinlove__cta:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 0.1s;
  }

  /* --- Visuel : l'affiche, entourée de deux polaroïds --- */
  .pinlove__visuel {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 400px;
    padding: 24px 0;
  }

  .pinlove__affiche {
    position: relative;
    z-index: 2;
    aspect-ratio: 941 / 1672;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(30, 26, 26, 0.45), 0 0 0 1px rgba(30, 26, 26, 0.06);
    transform: rotate(2deg);
  }

  .pinlove__affiche img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pinlove-polaroid {
    position: absolute;
    z-index: 3;
    width: 150px;
    margin: 0;
    padding: 8px 8px 0;
    background: var(--pin-surface);
    border-radius: 4px;
    box-shadow: 0 18px 34px -16px rgba(30, 26, 26, 0.45);
  }

  .pinlove-polaroid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 38%;
    border-radius: 2px;
  }

  .pinlove-polaroid figcaption {
    font-family: var(--pin-hand);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--pin-ink);
    text-align: center;
    padding: 8px 0 10px;
  }

  /* Petite épingle-cœur plantée sur chaque polaroïd */
  .pinlove-polaroid::before {
    content: '';
    position: absolute;
    top: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    background: var(--pin-accent);
    border: 3px solid var(--pin-surface);
    box-shadow: 0 3px 6px rgba(30, 26, 26, 0.25);
  }

  .pinlove-polaroid--a {
    left: -88px;
    top: 18%;
    transform: rotate(-8deg);
  }

  .pinlove-polaroid--b {
    right: -72px;
    bottom: 10%;
    transform: rotate(6deg);
  }

  /* --- Bandeau faits --- */
  .pinlove__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 72px;
    padding: 32px 0;
    border-top: 1px solid var(--pin-line);
    border-bottom: 1px solid var(--pin-line);
  }

  .pinlove-fact {
    padding: 0 28px;
    border-left: 1px solid var(--pin-line);
  }

  .pinlove-fact:first-child {
    border-left: none;
    padding-left: 0;
  }

  .pinlove-fact__label {
    display: block;
    font-family: var(--pin-font);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pin-accent);
    margin-bottom: 10px;
  }

  .pinlove-fact__texte {
    font-family: var(--pin-font);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--pin-ink-soft);
  }

  /* --- Fonctionnalités --- */
  .pinlove__features-head {
    max-width: 620px;
    margin: 72px auto 0;
    text-align: center;
  }

  .pinlove__features-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.125rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--pin-ink);
    margin-top: 16px;
  }

  .pinlove__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 44px auto 0;
  }

  .pinlove-feature {
    display: flex;
    flex-direction: column;
    background: var(--pin-surface);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(30, 26, 26, 0.06), 0 1px 2px rgba(30, 26, 26, 0.04);
    transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease-spring);
  }

  .pinlove-feature:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 44px -22px rgba(30, 26, 26, 0.35);
  }

  .pinlove-feature__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .pinlove-feature__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transition: transform 0.8s var(--ease-spring);
  }

  .pinlove-feature:hover .pinlove-feature__photo img {
    transform: scale(1.04);
  }

  .pinlove-feature__legende {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 4px 12px 6px;
    font-family: var(--pin-hand);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--pin-ink);
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-pill);
  }

  .pinlove-feature__corps {
    padding: 24px 24px 28px;
  }

  .pinlove-feature__titre {
    font-family: var(--pin-font);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--pin-ink);
    margin: 16px 0 8px;
  }

  .pinlove-feature__texte {
    font-family: var(--pin-font);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--pin-ink-soft);
  }

  /* --- CTA final --- */
  .pinlove__final-cta {
    margin-top: 80px;
    padding-top: 56px;
    border-top: 1px solid var(--pin-line);
    text-align: center;
    scroll-margin-top: 100px;
  }

  .pinlove-final-cta__titre {
