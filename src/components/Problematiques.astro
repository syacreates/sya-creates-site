---
const problemes = [
  {
    emoji: '📉',
    titre: 'Une interface qui ne convertit pas',
    texte:
      "Le produit fonctionne, mais les utilisateurs abandonnent avant l'étape clé — sans qu'on sache précisément où, ni pourquoi.",
  },
  {
    emoji: '🔀',
    titre: 'Design et développement désynchronisés',
    texte:
      'Les maquettes prennent des semaines à devenir une interface réelle, et le résultat livré finit par trahir ce qui avait été validé.',
  },
  {
    emoji: '🎲',
    titre: 'Des décisions produit prises à vue',
    texte:
      "Sans parcours utilisateur clairement cadré, chaque nouvelle fonctionnalité rouvre le débat au lieu de s'appuyer sur une base solide.",
  },
  {
    emoji: '🕰️',
    titre: 'Un design qui vieillit mal',
    texte:
      'Une interface bricolée au fil des besoins finit par perdre en cohérence — et en crédibilité aux yeux de tes utilisateurs.',
  },
];
---

<section class="problems" id="problematiques">
  <div class="problems__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Problématiques
    </span>

    <h2 class="problems__title">
      Les problèmes UX/UI que tu rencontres <em>forcément.</em>
    </h2>

    <p class="problems__intro">
      Un produit peut être fonctionnel, bien codé, presque complet — et pourtant perdre des
      utilisateurs en route. Voici ce qui revient le plus souvent chez les équipes que
      j'accompagne.
    </p>

    <div class="problems__grid">
      {
        problemes.map((probleme, index) => (
          <div class="problem-card glass-card reveal-item" style={`--i: ${index}`}>
            <span class="problem-card__icon">
              <span class="emoji-live" aria-hidden="true">{probleme.emoji}</span>
            </span>
            <h3 class="problem-card__titre">{probleme.titre}</h3>
            <p class="problem-card__texte">{probleme.texte}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .problems {
    position: relative;
    padding: 96px 24px;
  }

  .problems__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .problems__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 30ch;
  }

  .problems__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .problems__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  .problems__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  .problem-card {
    padding: 32px;
  }

  .problem-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-line);
    font-size: 1.1875rem;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .glass-card:hover .problem-card__icon {
    background: var(--color-surface);
    border-color: var(--color-accent-2);
  }

  .problem-card__titre {
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .problem-card__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .problems {
      padding: 64px 20px;
    }

    .problems__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
