<div class="side-cubes-glow" aria-hidden="true"></div>
<canvas id="side-cubes" class="side-cubes" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const canvas = document.getElementById('side-cubes') as HTMLCanvasElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Le rail latéral n'a de sens que quand la colonne de contenu (~1180px)
  // laisse assez de marge de chaque côté pour y faire flotter des cubes.
  const CONTENT_WIDTH = 1180;
  const MIN_LANE = 70;
  const MIN_VIEWPORT = CONTENT_WIDTH + MIN_LANE * 2 + 80;

  if (canvas && !prefersReduced) {
    let width = window.innerWidth;
    let height = window.innerHeight;
    let active = width >= MIN_VIEWPORT;
    let scrollY = window.scrollY;
    let docHeight = document.documentElement.scrollHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.06).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.65);
    const key = new THREE.DirectionalLight(0xffffff, 1.2);
    key.position.set(100, 200, 260);
    scene.add(ambient, key);

    const palette = [0x3f7a58, 0x1f3d2e, 0x4c8c63, 0xd9a854, 0x2c5240];

    // Même animation que le champ de cubes central du hero, reprise ici en
    // rail gauche/droit sur toute la page : à chaque fin de section
    // (frontière entre deux <section>), un cube tombe et se pose des deux
    // côtés, exactement quand cette frontière atteint le bas de l'écran.
    type Dropper = {
      mesh: THREE.Mesh;
      side: -1 | 1;
      x: number;
      boundaryY: number;
      pageY: number;
      vy: number;
      triggered: boolean;
      landed: boolean;
      fallDelay: number;
      sinceTriggered: number;
      squash: number;
      pulse: number;
      age: number;
      spin: THREE.Vector3;
    };

    let droppers: Dropper[] = [];

    function laneX(side: -1 | 1) {
      const laneOuter = width / 2 - 24;
      const laneInner = CONTENT_WIDTH / 2 + MIN_LANE * 0.4;
      const t = Math.random();
      return side * (laneInner + t * Math.max(laneOuter - laneInner, 10));
    }

    function buildDroppers(boundaries: number[]) {
      for (const d of droppers) {
        scene.remove(d.mesh);
        d.mesh.geometry.dispose();
        (d.mesh.material as THREE.Material).dispose();
      }
      droppers = [];

      boundaries.forEach((boundaryY, bi) => {
        ([-1, 1] as const).forEach((side, si) => {
          // Pêle-mêle : 2 ou 3 cubes par côté, groupés autour d'un même
          // point de chute, décalés et tombant en léger décalage pour ne
          // pas atterrir tous alignés au même endroit.
          const clusterCount = 2 + Math.floor(Math.random() * 2);
          const clusterX = laneX(side);

          for (let ci = 0; ci < clusterCount; ci++) {
            const size = 64 + Math.random() * 56;
            const geo = new RoundedBoxGeometry(size, size, size, 4, size * 0.15);
            const mat = new THREE.MeshStandardMaterial({
              color: palette[(bi + si + ci) % palette.length],
              metalness: 1,
              roughness: 0.24,
              envMapIntensity: 1.2,
              transparent: true,
              opacity: 0,
            });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
            scene.add(mesh);

            const landOffset = ci === 0 ? 0 : ci * (16 + Math.random() * 26);

            // Le jitter du pêle-mêle ne doit jamais pousser un cube hors du
            // viewport — on le borne à l'intérieur du bord réel de l'écran.
            const halfSize = size / 2;
            const edge = width / 2 - 24 - halfSize;
            let x = clusterX + (Math.random() - 0.5) * 90;
            x = side === 1 ? Math.min(x, edge) : Math.max(x, -edge);

            droppers.push({
              mesh,
              side,
              x,
              boundaryY: boundaryY - landOffset,
              pageY: boundaryY - 260 - Math.random() * 100,
              vy: 0,
              triggered: false,
              landed: false,
              fallDelay: ci * (0.1 + Math.random() * 0.2),
              sinceTriggered: 0,
              squash: 0,
              pulse: 0,
              age: 0,
              spin: new THREE.Vector3(
                (Math.random() - 0.5) * 0.5,
                (Math.random() - 0.5) * 0.5,
                (Math.random() - 0.5) * 0.5
              ),
            });
          }
        });
      });
    }

    function computeBoundaries() {
      const els = Array.from(document.querySelectorAll('section[id], footer')) as HTMLElement[];
      const currentScroll = window.scrollY;
      const boundaries = els
        .map((el) => el.getBoundingClientRect().top + currentScroll)
        .filter((top) => top > 40)
        .sort((a, b) => a - b);
      docHeight = document.documentElement.scrollHeight;
      buildDroppers(boundaries);
    }

    let running = false;
    let rafId = 0;
    let prevTime = performance.now();
    let lastScrollY = scrollY;

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      // Rotation "sur le côté" pilotée par le scroll — chaque pixel
      // défilé fait tourner les cubes, en miroir gauche/droite.
      const scrollDelta = scrollY - lastScrollY;
      lastScrollY = scrollY;
      const scrollPulse = Math.min(Math.abs(scrollDelta) * 0.03, 1);

      for (const d of droppers) {
        // Se déclenche quand la frontière de section approche du bas de
        // l'écran — le cube tombe alors depuis un peu au-dessus et se pose
        // pile sur la ligne, comme dans le hero.
        if (!d.triggered && d.boundaryY - (scrollY + height) < 260 && d.boundaryY > scrollY - 200) {
          d.triggered = true;
        }

        if (d.triggered && !d.landed) {
          d.sinceTriggered += dt;
          if (d.sinceTriggered >= d.fallDelay) {
            d.vy += 750 * dt;
            d.pageY += d.vy * dt;
            if (d.pageY >= d.boundaryY) {
              d.pageY = d.boundaryY;
              d.landed = true;
              d.vy = 0;
              d.squash = 1;
            }
          }
        }

        const screenTopY = d.pageY - scrollY;
        const worldY = height / 2 - screenTopY;
        d.mesh.position.set(d.x, worldY, d.side * 40);
        d.mesh.rotation.x += d.spin.x * dt;
        d.mesh.rotation.y += d.spin.y * dt + d.side * scrollDelta * 0.015;
        d.mesh.rotation.z += d.spin.z * dt;

        // Fondu d'apparition — évite qu'un cube ne recouvre brutalement un
        // label/contenu qu'il traverse en tombant.
        if (d.triggered) d.age += dt;
        (d.mesh.material as THREE.MeshStandardMaterial).opacity = Math.min(d.age / 0.4, 1);

        // La rotation au scroll fait aussi respirer le cube : il grossit
        // avec l'énergie du scroll puis revient à sa taille au repos.
        d.pulse = Math.max(d.pulse - dt * 2.2, scrollPulse);
        const pulseScale = 1 + d.pulse * 0.55;

        if (d.squash > 0) {
          d.squash = Math.max(d.squash - dt * 3.4, 0);
          const t = 1 - d.squash;
          const bounce = Math.sin(t * Math.PI) * d.squash;
          d.mesh.scale.set(
            (1 + bounce * 0.32) * pulseScale,
            (1 - bounce * 0.45) * pulseScale,
            (1 + bounce * 0.32) * pulseScale
          );
        } else {
          d.mesh.scale.set(pulseScale, pulseScale, pulseScale);
        }
      }

      renderer.render(scene, camera);
    }

    function start() {
      if (running) return;
      running = true;
      prevTime = performance.now();
      rafId = requestAnimationFrame(tick);
    }

    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (active) start();
    });

    window.addEventListener(
      'scroll',
      () => {
        scrollY = window.scrollY;
      },
      { passive: true }
    );

    window.addEventListener('load', computeBoundaries);
    setTimeout(computeBoundaries, 300);
    computeBoundaries();

    if (active) start();

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      active = width >= MIN_VIEWPORT;

      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      computeBoundaries();

      if (active) start();
      else stop();
    });
  }
</script>

<style>
  .side-cubes {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  /* Fondu vert discret derrière les cubes latéraux, sur toute la hauteur
     de l'écran — reprend la teinte de la nébuleuse du hero. */
  .side-cubes-glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(to right, rgba(63, 122, 88, 0.16), transparent 22%),
      linear-gradient(to left, rgba(63, 122, 88, 0.16), transparent 22%);
  }

  @media (max-width: 1440px) {
    .side-cubes,
    .side-cubes-glow {
      display: none;
    }
  }
</style>
