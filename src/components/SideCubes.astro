<canvas id="side-cubes" class="side-cubes" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const canvas = document.getElementById('side-cubes') as HTMLCanvasElement | null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Le rail latéral n'a de sens que quand la colonne de contenu (~1180px)
  // laisse assez de marge de chaque côté pour y faire flotter des cubes.
  const CONTENT_WIDTH = 1180;
  const MIN_LANE = 70;
  const MIN_VIEWPORT = CONTENT_WIDTH + MIN_LANE * 2 + 80;

  if (canvas && !prefersReduced) {
    let width = window.innerWidth;
    let height = window.innerHeight;
    let active = width >= MIN_VIEWPORT;
    let scrollY = window.scrollY;
    let docHeight = document.documentElement.scrollHeight;

    // Frontières = le haut de chaque section/du footer, en coordonnées
    // de page (indépendantes du scroll) — c'est contre ces lignes que
    // les cubes s'écrasent en traversant la page.
    let boundaries: number[] = [];

    function computeBoundaries() {
      const els = Array.from(document.querySelectorAll('section[id], footer')) as HTMLElement[];
      const currentScroll = window.scrollY;
      boundaries = els
        .map((el) => el.getBoundingClientRect().top + currentScroll)
        .filter((top) => top > 40)
        .sort((a, b) => a - b);
      docHeight = document.documentElement.scrollHeight;
    }

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.06).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.65);
    const key = new THREE.DirectionalLight(0xffffff, 1.2);
    key.position.set(100, 200, 260);
    scene.add(ambient, key);

    const palette = [0x3f7a58, 0x1f3d2e, 0x4c8c63, 0xd9a854, 0x2c5240];

    type Drifter = {
      mesh: THREE.Mesh;
      side: -1 | 1;
      baseX: number;
      swayAmp: number;
      swayFreq: number;
      swayPhase: number;
      vy: number;
      spin: THREE.Vector3;
      pageY: number;
      size: number;
      squash: number;
    };

    const drifters: Drifter[] = [];
    const COUNT = 8;

    function laneX(side: -1 | 1) {
      const laneOuter = width / 2 - 24;
      const laneInner = CONTENT_WIDTH / 2 + MIN_LANE * 0.4;
      const t = Math.random();
      const x = laneInner + t * Math.max(laneOuter - laneInner, 10);
      return side * x;
    }

    function respawn(d: Drifter, initial = false) {
      d.size = 30 + Math.random() * 34;
      d.baseX = laneX(d.side);
      d.swayAmp = 14 + Math.random() * 18;
      d.swayFreq = 0.15 + Math.random() * 0.15;
      d.swayPhase = Math.random() * Math.PI * 2;
      // "plus ralenti" — chute lente et constante, façon feuille qui tombe.
      d.vy = 10 + Math.random() * 8;
      d.spin.set((Math.random() - 0.5) * 0.4, (Math.random() - 0.5) * 0.4, (Math.random() - 0.5) * 0.4);
      d.pageY = initial ? Math.random() * docHeight : -d.size - Math.random() * 400;
      d.squash = 0;

      if (d.mesh.geometry) d.mesh.geometry.dispose();
      d.mesh.geometry = new RoundedBoxGeometry(d.size, d.size, d.size, 4, d.size * 0.15);
      (d.mesh.material as THREE.MeshStandardMaterial).color.setHex(
        palette[Math.floor(Math.random() * palette.length)]
      );
    }

    for (let i = 0; i < COUNT; i++) {
      const side: -1 | 1 = i % 2 === 0 ? -1 : 1;
      const mat = new THREE.MeshStandardMaterial({ metalness: 1, roughness: 0.24, envMapIntensity: 1.2 });
      const mesh = new THREE.Mesh(new THREE.BufferGeometry(), mat);
      scene.add(mesh);
      const d: Drifter = {
        mesh,
        side,
        baseX: 0,
        swayAmp: 0,
        swayFreq: 0,
        swayPhase: 0,
        vy: 0,
        spin: new THREE.Vector3(),
        pageY: 0,
        size: 40,
        squash: 0,
      };
      respawn(d, true);
      drifters.push(d);
    }

    let running = false;
    let rafId = 0;
    let prevTime = performance.now();
    let elapsed = 0;
    let lastScrollY = scrollY;

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;
      elapsed += dt;

      // Rotation "sur le côté" pilotée par le scroll — chaque pixel
      // défilé fait tourner les cubes autour de leur axe vertical,
      // en miroir entre le rail gauche et le rail droit.
      const scrollDelta = scrollY - lastScrollY;
      lastScrollY = scrollY;

      for (const d of drifters) {
        const prevPageY = d.pageY;
        d.pageY += d.vy * dt;

        // Traversée d'une frontière de section pendant cette frame →
        // le cube s'écrase contre la ligne, comme pressé entre les deux.
        for (const b of boundaries) {
          if (prevPageY < b && d.pageY >= b) {
            d.squash = 1;
            break;
          }
        }

        if (d.pageY - d.size > docHeight) respawn(d);

        // pageY grandit vers le bas (coordonnées document) → on le
        // convertit en Y monde (haut du viewport = +height/2, y-up).
        const screenTopY = d.pageY - scrollY;
        const worldY = height / 2 - screenTopY;

        const x = d.baseX + Math.sin(elapsed * d.swayFreq + d.swayPhase) * d.swayAmp;
        d.mesh.position.set(x, worldY, d.side * 40);
        d.mesh.rotation.x += d.spin.x * dt;
        d.mesh.rotation.y += d.spin.y * dt + d.side * scrollDelta * 0.015;
        d.mesh.rotation.z += d.spin.z * dt;

        if (d.squash > 0) {
          d.squash = Math.max(d.squash - dt * 3.4, 0);
          // Aplatissement en Y, léger élargissement en X/Z, avec un
          // petit rebond élastique en fin de course (overshoot).
          const t = 1 - d.squash;
          const bounce = Math.sin(t * Math.PI) * d.squash;
          d.mesh.scale.set(1 + bounce * 0.32, 1 - bounce * 0.45, 1 + bounce * 0.32);
        } else {
          d.mesh.scale.set(1, 1, 1);
        }
      }

      renderer.render(scene, camera);
    }

    function start() {
      if (running) return;
      running = true;
      prevTime = performance.now();
      rafId = requestAnimationFrame(tick);
    }

    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (active) start();
    });

    window.addEventListener(
      'scroll',
      () => {
        scrollY = window.scrollY;
      },
      { passive: true }
    );

    window.addEventListener('load', computeBoundaries);
    setTimeout(computeBoundaries, 300);
    computeBoundaries();

    if (active) start();

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      active = width >= MIN_VIEWPORT;

      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      computeBoundaries();

      if (active) start();
      else stop();
    });
  }
</script>

<style>
  .side-cubes {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  @media (max-width: 1440px) {
    .side-cubes {
      display: none;
    }
  }
</style>
