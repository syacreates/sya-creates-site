---
// Illustration cocon → papillon, factorisée pour pouvoir apparaître
// plusieurs fois sur la page (le grand visuel interactif, plus une
// miniature fixe par étape sur mobile — voir Vision.astro) sans collision
// d'id de dégradé (voir Logo.astro pour le même souci déjà résolu là-bas).
interface Props {
  idSuffix: string;
}

const { idSuffix } = Astro.props;
const gradientId = `wing-gradient-${idSuffix}`;
---

<svg class="cocoon__svg" viewBox="0 0 240 220" aria-hidden="true">
  <defs>
    <!-- Dégradé façon monarque : ambre clair côté corps, orange
         brûlé côté pointe d'aile. objectBoundingBox (par défaut)
         applique le même dégradé 0%→100% sur chacune des 4 ailes
         indépendamment de leur orientation, sans le dupliquer. -->
    <linearGradient id={gradientId} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffcb6b" />
      <stop offset="55%" stop-color="#f0932b" />
      <stop offset="100%" stop-color="#c2540f" />
    </linearGradient>
  </defs>
  <path class="cocoon__branch-line" d="M30,24 Q120,4 210,24" fill="none" />
  <path class="cocoon__leaf" d="M74,21 C63,10 46,12 40,23 C46,32 65,31 74,21 Z" />
  <path class="cocoon__leaf" d="M166,21 C177,10 194,12 200,23 C194,32 175,31 166,21 Z" />
  <line class="cocoon__thread" x1="120" y1="24" x2="120" y2="58" />

  <g class="cocoon__swing">
    <g class="cocoon__shell">
      <path
        class="cocoon__shell-fill"
        d="M120,58 C142,64 150,88 150,110 C150,136 137,157 120,160 C103,157 90,136 90,110 C90,88 98,64 120,58 Z"
      />
      <path class="cocoon__band" d="M96,82 Q120,89 144,82" />
      <path class="cocoon__band" d="M93,102 Q120,110 147,102" />
      <path class="cocoon__band" d="M94,124 Q120,132 146,124" />
      <path class="cocoon__band" d="M98,143 Q120,149 142,143" />
    </g>

    <ellipse class="cocoon__glow" cx="120" cy="112" rx="46" ry="56" />
    <g class="cocoon__veins">
      <path d="M118,66 Q94,88 91,118 Q91,140 106,156" />
      <path d="M122,66 Q146,88 149,118 Q149,140 134,156" />
    </g>

    <g class="cocoon__butterfly" aria-hidden="true">
      <!-- Silhouette réaliste (ailes pointues, façon monarque/machaon)
           plutôt que les lobes arrondis d'origine : bord d'attaque
           droit vers une pointe nette, bord externe qui revient en
           courbe. Ailes inférieures prolongées d'une petite queue,
           signature des machaons. -->
      <g class="cocoon__wing cocoon__wing--lower-left">
        <path
          class="cocoon__wing-fill"
          fill={`url(#${gradientId})`}
          d="M117,122 Q80,130 65,155 Q58,176 72,205 Q88,180 100,165 Q112,150 118,145 Q120,133 117,122 Z"
        />
        <path class="cocoon__wing-vein" d="M117,124 Q95,140 75,165" />
        <path class="cocoon__wing-vein" d="M117,128 Q100,158 87,188" />
        <circle class="cocoon__wing-spot" cx="73" cy="191" r="2.6" />
        <circle class="cocoon__wing-spot" cx="86" cy="174" r="2.2" />
        <circle class="cocoon__wing-spot" cx="65" cy="158" r="2" />
      </g>
      <g class="cocoon__wing cocoon__wing--lower-right">
        <path
          class="cocoon__wing-fill"
          fill={`url(#${gradientId})`}
          d="M123,122 Q160,130 175,155 Q182,176 168,205 Q152,180 140,165 Q128,150 122,145 Q120,133 123,122 Z"
        />
        <path class="cocoon__wing-vein" d="M123,124 Q145,140 165,165" />
        <path class="cocoon__wing-vein" d="M123,128 Q140,158 153,188" />
        <circle class="cocoon__wing-spot" cx="167" cy="191" r="2.6" />
        <circle class="cocoon__wing-spot" cx="154" cy="174" r="2.2" />
        <circle class="cocoon__wing-spot" cx="175" cy="158" r="2" />
      </g>
      <g class="cocoon__wing cocoon__wing--upper-left">
        <path
          class="cocoon__wing-fill"
          fill={`url(#${gradientId})`}
          d="M120,95 L20,46 Q50,95 58,118 Q75,135 100,132 Q114,118 120,95 Z"
        />
        <path class="cocoon__wing-vein" d="M118,89 Q68,68 28,49" />
        <path class="cocoon__wing-vein" d="M118,97 Q80,103 58,119" />
        <path class="cocoon__wing-vein" d="M118,104 Q96,119 80,128" />
        <circle class="cocoon__wing-spot" cx="36" cy="58" r="2.4" />
        <circle class="cocoon__wing-spot" cx="50" cy="90" r="2.2" />
        <circle class="cocoon__wing-spot" cx="66" cy="115" r="2" />
        <circle class="cocoon__ocelle" cx="47" cy="84" r="5.5" />
      </g>
      <g class="cocoon__wing cocoon__wing--upper-right">
        <path
          class="cocoon__wing-fill"
          fill={`url(#${gradientId})`}
          d="M120,95 L220,46 Q190,95 182,118 Q165,135 140,132 Q126,118 120,95 Z"
        />
        <path class="cocoon__wing-vein" d="M122,89 Q172,68 212,49" />
        <path class="cocoon__wing-vein" d="M122,97 Q160,103 182,119" />
        <path class="cocoon__wing-vein" d="M122,104 Q144,119 160,128" />
        <circle class="cocoon__wing-spot" cx="204" cy="58" r="2.4" />
        <circle class="cocoon__wing-spot" cx="190" cy="90" r="2.2" />
        <circle class="cocoon__wing-spot" cx="174" cy="115" r="2" />
        <circle class="cocoon__ocelle" cx="193" cy="84" r="5.5" />
      </g>
      <g class="cocoon__body">
        <!-- Antennes à massue (renflement au bout) : signature des
             papillons de jour (monarque compris), contrairement
             aux antennes filiformes/plumeuses des papillons de
             nuit. -->
        <path class="cocoon__antenna" d="M117,72 Q107,54 98,48" />
        <circle class="cocoon__antenna-club" cx="98" cy="48" r="2.2" />
        <path class="cocoon__antenna" d="M123,72 Q133,54 142,48" />
        <circle class="cocoon__antenna-club" cx="142" cy="48" r="2.2" />
        <ellipse cx="120" cy="77" rx="5" ry="6" />
        <ellipse cx="120" cy="92" rx="6" ry="8" />
        <ellipse cx="120" cy="109" rx="6.5" ry="9" />
        <ellipse cx="120" cy="126" rx="5.5" ry="8" />
        <ellipse cx="120" cy="140" rx="4.5" ry="6" />
        <!-- Petites taches claires sur le corps sombre, comme chez
             le monarque réel. -->
        <circle class="cocoon__body-spot" cx="117" cy="90" r="1" />
        <circle class="cocoon__body-spot" cx="123" cy="90" r="1" />
        <circle class="cocoon__body-spot" cx="117" cy="107" r="1" />
        <circle class="cocoon__body-spot" cx="123" cy="107" r="1" />
        <circle class="cocoon__body-spot" cx="117" cy="124" r="1" />
        <circle class="cocoon__body-spot" cx="123" cy="124" r="1" />
      </g>
      <g class="cocoon__sparkles">
        <path class="cocoon__spark" d="M0,-6 L1.6,-1.6 L6,0 L1.6,1.6 L0,6 L-1.6,1.6 L-6,0 L-1.6,-1.6 Z" transform="translate(48,64)" />
        <circle class="cocoon__spark" cx="192" cy="70" r="2.4" />
        <path class="cocoon__spark" d="M0,-5 L1.3,-1.3 L5,0 L1.3,1.3 L0,5 L-1.3,1.3 L-5,0 L-1.3,-1.3 Z" transform="translate(200,120)" />
        <circle class="cocoon__spark" cx="38" cy="130" r="2" />
        <path class="cocoon__spark" d="M0,-5 L1.3,-1.3 L5,0 L1.3,1.3 L0,5 L-1.3,1.3 L-5,0 L-1.3,-1.3 Z" transform="translate(120,30)" />
      </g>
    </g>
  </g>
</svg>
