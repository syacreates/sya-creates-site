---
const etapes = [
  {
    numero: '01',
    titre: 'Cadrage',
    texte: "On clarifie l'objectif, le périmètre et les contraintes — interviews et personas si le projet s'y prête — avant de concevoir quoi que ce soit.",
  },
  {
    numero: '02',
    titre: 'Design',
    texte: 'Parcours utilisateur, wireframes puis interfaces visuelles — testés et validés avec toi à chaque étape clé.',
  },
  {
    numero: '03',
    titre: 'Développement IA-assisted',
    texte: "Le design devient une interface fonctionnelle, développée rapidement grâce à des outils d'IA.",
  },
  {
    numero: '04',
    titre: 'Livraison',
    texte: 'Mise en ligne ou transmission à ton équipe technique, avec une documentation claire.',
  },
  {
    numero: '05',
    titre: 'Suivi',
    texte: "Un accompagnement disponible après la livraison, avec des itérations basées sur les retours et l'usage réel du produit.",
  },
];

// Chemin serpentin — le tracé et les cubes partagent les mêmes points, calculés
// une seule fois ici, pour que le curseur (SMIL <animateMotion>) et les faces des
// cubes coïncident exactement avec le tracé, sans jamais dupliquer des coordonnées
// à la main entre le SVG et le CSS.
const CUBE_HALF = 22; // demi-taille de la face isométrique (viewBox du cube : 0–44)
const LABEL_W = 152;
const LABEL_GAP = 14;

function buildSerpentine(points: { x: number; y: number }[], axis: 'x' | 'y') {
  let d = `M${points[0].x},${points[0].y}`;
  for (let i = 0; i < points.length - 1; i++) {
    const a = points[i];
    const b = points[i + 1];
    if (axis === 'x') {
      const half = (b.x - a.x) / 2;
      d += ` C${a.x + half},${a.y} ${b.x - half},${b.y} ${b.x},${b.y}`;
    } else {
      const half = (b.y - a.y) / 2;
      d += ` C${a.x},${a.y + half} ${b.x},${b.y - half} ${b.x},${b.y}`;
    }
  }
  return d;
}

// --- Desktop : tracé horizontal, amplitude verticale alternée ---
const DW = 1180;
const DH = 330;
const D_MARGIN_X = 100;
const D_Y_HIGH = 85;
const D_Y_LOW = 205;
const dStepX = (DW - D_MARGIN_X * 2) / (etapes.length - 1);
const desktopPoints = etapes.map((etape, i) => ({
  ...etape,
  x: D_MARGIN_X + i * dStepX,
  y: i % 2 === 0 ? D_Y_LOW : D_Y_HIGH,
}));
const desktopPath = buildSerpentine(desktopPoints, 'x');

// --- Mobile : tracé vertical, amplitude horizontale alternée ---
const MW = 320;
const M_MARGIN_TOP = 90;
const M_STEP_Y = 260;
const M_X_LEFT = 110;
const M_X_RIGHT = 230;
const MH = M_MARGIN_TOP + (etapes.length - 1) * M_STEP_Y + 120;
const mobilePoints = etapes.map((etape, i) => ({
  ...etape,
  x: i % 2 === 0 ? M_X_LEFT : M_X_RIGHT,
  y: M_MARGIN_TOP + i * M_STEP_Y,
}));
const mobilePath = buildSerpentine(mobilePoints, 'y');
---

<section class="method" id="methode">
  <div class="method__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Méthode
    </span>

    <h2 class="method__title">
      Une méthode claire, <em>pour savoir toujours où on en est.</em>
    </h2>

    <p class="method__intro">
      Pas de boîte noire : chaque étape est cadrée, documentée et validée avant de passer à la
      suivante. Le développement assisté par IA accélère l'exécution — jamais la clarté du
      processus.
    </p>

    <div class="method-path">
      <svg
        class="method-path__svg method-path__svg--desktop"
        viewBox={`0 0 ${DW} ${DH}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          id="method-curve-desktop"
          class="method-path__track"
          d={desktopPath}
          fill="none"
        />
        {
          desktopPoints.map((p) => (
            <g
              transform={`translate(${p.x - CUBE_HALF} ${p.y - CUBE_HALF})`}
              role="img"
              aria-label={`Étape ${p.numero} : ${p.titre} — ${p.texte}`}
            >
              <path class="method-cube-face method-cube-face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
              <path class="method-cube-face method-cube-face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
              <path class="method-cube-face method-cube-face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
            </g>
          ))
        }
        <circle class="method-path__cursor" r="8">
          <animateMotion dur="5.5s" repeatCount="indefinite" rotate="0">
            <mpath href="#method-curve-desktop" />
          </animateMotion>
        </circle>
        {
          desktopPoints.map((p) => (
            <foreignObject x={p.x - LABEL_W / 2} y={p.y + CUBE_HALF + LABEL_GAP} width={LABEL_W} height="60">
              <div xmlns="http://www.w3.org/1999/xhtml" class="method-path__label">
                {p.titre}
              </div>
            </foreignObject>
          ))
        }
      </svg>

      <svg
        class="method-path__svg method-path__svg--mobile"
        viewBox={`0 0 ${MW} ${MH}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          id="method-curve-mobile"
          class="method-path__track"
          d={mobilePath}
          fill="none"
        />
        {
          mobilePoints.map((p) => (
            <g
              transform={`translate(${p.x - CUBE_HALF} ${p.y - CUBE_HALF})`}
              role="img"
              aria-label={`Étape ${p.numero} : ${p.titre} — ${p.texte}`}
            >
              <path class="method-cube-face method-cube-face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
              <path class="method-cube-face method-cube-face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
              <path class="method-cube-face method-cube-face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
            </g>
          ))
        }
        <circle class="method-path__cursor" r="8">
          <animateMotion dur="5.5s" repeatCount="indefinite" rotate="0">
            <mpath href="#method-curve-mobile" />
          </animateMotion>
        </circle>
        {
          mobilePoints.map((p) => (
            <foreignObject x={p.x - LABEL_W / 2} y={p.y + CUBE_HALF + LABEL_GAP} width={LABEL_W} height="60">
              <div xmlns="http://www.w3.org/1999/xhtml" class="method-path__label">
                {p.titre}
              </div>
            </foreignObject>
          ))
        }
      </svg>
    </div>
  </div>
</section>

<script>
  // Sous prefers-reduced-motion, le curseur doré reste figé sur la première
  // étape (Cadrage) plutôt que de boucler indéfiniment — pauseAnimations()
  // gèle le timeline SMIL à t=0, avant que l'animateMotion n'ait progressé.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    document.querySelectorAll('.method-path__svg').forEach((svg) => {
      (svg as unknown as SVGSVGElement).pauseAnimations();
    });
  }
</script>

<style>
  .method {
    position: relative;
    padding: 96px 24px;
  }

  .method__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .method__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 36ch;
  }

  .method__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .method__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  /* Chemin serpentin — le tracé et les titres restent sobres (gris/beige),
     le vert des cubes et le doré du curseur sont les deux seules touches
     d'accent de ce visuel. */
  .method-path {
    margin-top: 56px;
  }

  .method-path__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .method-path__svg--mobile {
    display: none;
  }

  .method-path__track {
    stroke: var(--color-line);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .method-cube-face {
    fill: var(--color-accent);
  }

  .method-cube-face--left {
    opacity: 0.8;
  }

  .method-cube-face--right {
    opacity: 0.55;
  }

  .method-path__cursor {
    fill: #d9a854;
    filter: drop-shadow(0 0 6px rgba(217, 168, 84, 0.65));
  }

  .method-path__label {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .method-path__cursor {
      filter: none;
    }
  }

  @media (max-width: 860px) {
    .method {
      padding: 64px 20px;
    }

    .method-path {
      margin-top: 40px;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .method-path__svg--desktop {
      display: none;
    }

    .method-path__svg--mobile {
      display: block;
    }
  }
</style>
