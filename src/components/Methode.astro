---
const etapes = [
  {
    numero: '01',
    titre: 'Cadrage',
    texte: "On clarifie l'objectif, le périmètre et les contraintes avant de concevoir quoi que ce soit.",
  },
  {
    numero: '02',
    titre: 'Design',
    texte: 'Parcours, wireframes puis interfaces visuelles, validés avec toi à chaque étape clé.',
  },
  {
    numero: '03',
    titre: 'Développement IA-assisted',
    texte: "Le design devient une interface fonctionnelle, développée rapidement grâce à des outils d'IA.",
  },
  {
    numero: '04',
    titre: 'Livraison',
    texte: 'Mise en ligne ou transmission à ton équipe technique, avec une documentation claire.',
  },
  {
    numero: '05',
    titre: 'Suivi',
    texte: 'Un accompagnement disponible après la livraison pour ajuster et faire évoluer le produit.',
  },
];
---

<section class="method" id="methode">
  <div class="method__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Méthode
    </span>

    <h2 class="method__title">
      Une méthode claire, <em>pour savoir toujours où on en est.</em>
    </h2>

    <p class="method__intro">
      Pas de boîte noire : chaque étape est cadrée, documentée et validée avant de passer à la
      suivante. Le développement assisté par IA accélère l'exécution — jamais la clarté du
      processus.
    </p>

    <div class="method__steps">
      {
        etapes.map((etape, index) => (
          <div
            class={`method-step glass-card reveal-item ${index === etapes.length - 1 ? 'method-step--active' : ''}`}
            style={`--i: ${index}`}
          >
            <span class="method-step__dot" />
            <span class="method-step__numero">{etape.numero}</span>
            <h3 class="method-step__titre">{etape.titre}</h3>
            <p class="method-step__texte">{etape.texte}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .method {
    position: relative;
    padding: 96px 24px;
  }

  .method__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .method__title {
    margin-top: 20px;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 36ch;
  }

  .method__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .method__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: 24px;
  }

  .method__steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-top: 64px;
  }

  .method-step {
    position: relative;
    padding: 24px 18px;
    text-align: left;
  }

  .method-step__dot {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1.5px solid var(--color-ink);
    margin-bottom: 16px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .method-step--active .method-step__dot {
    background: var(--gradient-accent);
    border-color: transparent;
  }

  .reveal.is-visible .method-step--active .method-step__dot {
    animation: dot-pop 0.5s ease 0.3s both;
  }

  @media (hover: hover) and (pointer: fine) {
    .method-step:hover .method-step__dot {
      background: var(--gradient-accent);
      border-color: transparent;
    }
  }

  .method-step__numero {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .method-step__titre {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .method-step__texte {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .method {
      padding: 64px 20px;
    }

    .method__steps {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 40px;
    }
  }
</style>
