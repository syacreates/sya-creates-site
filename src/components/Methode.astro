---
const etapes = [
  {
    numero: '01',
    titre: 'Cadrage',
    texte: "On clarifie l'objectif, le périmètre et les contraintes — interviews et personas si le projet s'y prête — avant de concevoir quoi que ce soit.",
  },
  {
    numero: '02',
    titre: 'Design',
    texte: 'Parcours utilisateur, wireframes puis interfaces visuelles — testés et validés avec toi à chaque étape clé.',
  },
  {
    numero: '03',
    titre: 'Développement IA-assisted',
    texte: "Le design devient une interface fonctionnelle, développée rapidement grâce à des outils d'IA.",
  },
  {
    numero: '04',
    titre: 'Livraison',
    texte: 'Mise en ligne ou transmission à ton équipe technique, avec une documentation claire.',
  },
  {
    numero: '05',
    titre: 'Suivi',
    texte: "Un accompagnement disponible après la livraison, avec des itérations basées sur les retours et l'usage réel du produit.",
  },
];

// Chemin serpentin — le tracé et les cubes partagent les mêmes points, calculés
// une seule fois ici, pour que le curseur (SMIL <animateMotion>) et les faces des
// cubes coïncident exactement avec le tracé, sans jamais dupliquer des coordonnées
// à la main entre le SVG et le CSS.
const CUBE_HALF = 22; // demi-taille locale du cube (viewBox du dessin : 0–44)
// Les tracés des faces sont fixés dans ce repère 0–44 : CUBE_HALF ne sert
// qu'au centrage, pas à la taille réellement affichée. CUBE_SCALE agrandit
// le cube pour de bon (rendu visiblement plus grand que le curseur, dont
// le rayon reste fixe) — CUBE_WORLD_HALF est son demi-encombrement une
// fois agrandi, utilisé pour replacer le libellé juste en dessous.
const CUBE_SCALE = 1.3;
const CUBE_WORLD_HALF = CUBE_HALF * CUBE_SCALE;
const LABEL_W = 152;
const LABEL_GAP = 14;

function buildSerpentine(points: { x: number; y: number }[], axis: 'x' | 'y') {
  let d = `M${points[0].x},${points[0].y}`;
  for (let i = 0; i < points.length - 1; i++) {
    const a = points[i];
    const b = points[i + 1];
    if (axis === 'x') {
      const half = (b.x - a.x) / 2;
      d += ` C${a.x + half},${a.y} ${b.x - half},${b.y} ${b.x},${b.y}`;
    } else {
      const half = (b.y - a.y) / 2;
      d += ` C${a.x},${a.y + half} ${b.x},${b.y - half} ${b.x},${b.y}`;
    }
  }
  return d;
}

// Le curseur doré marque un temps d'arrêt à chaque étape plutôt que de
// glisser sans jamais s'arrêter : keyTimes/keyPoints construits pour tenir
// chaque valeur (arrêt) puis glisser vers la suivante (déplacement), en
// alternance. HOLD_MS/MOVE_MS pilotent aussi le cycle de mise en avant
// automatique de chaque étape en JS (voir <script> plus bas) — une seule
// source de vérité pour le minutage des deux animations.
const HOLD_MS = 1800;
const MOVE_MS = 700;

function buildHoldTiming(n: number) {
  const totalMs = n * HOLD_MS + (n - 1) * MOVE_MS;
  const keyTimes: number[] = [];
  const keyPoints: number[] = [];
  let t = 0;
  for (let i = 0; i < n; i++) {
    const value = n === 1 ? 0 : i / (n - 1);
    keyTimes.push(t / totalMs);
    keyPoints.push(value);
    t += HOLD_MS;
    keyTimes.push(t / totalMs);
    keyPoints.push(value);
    if (i < n - 1) t += MOVE_MS;
  }
  keyTimes[keyTimes.length - 1] = 1;
  return {
    keyTimes: keyTimes.map((v) => v.toFixed(4)).join(';'),
    keyPoints: keyPoints.map((v) => v.toFixed(4)).join(';'),
    dur: `${(totalMs / 1000).toFixed(2)}s`,
  };
}

const holdTiming = buildHoldTiming(etapes.length);

// --- Desktop : tracé horizontal, amplitude verticale alternée ---
const DW = 1180;
const DH = 330;
const D_MARGIN_X = 100;
const D_Y_HIGH = 85;
const D_Y_LOW = 205;
const dStepX = (DW - D_MARGIN_X * 2) / (etapes.length - 1);
const desktopPoints = etapes.map((etape, i) => ({
  ...etape,
  x: D_MARGIN_X + i * dStepX,
  y: i % 2 === 0 ? D_Y_LOW : D_Y_HIGH,
}));
const desktopPath = buildSerpentine(desktopPoints, 'x');

// --- Mobile : tracé vertical, amplitude horizontale alternée ---
const MW = 320;
const M_MARGIN_TOP = 90;
const M_STEP_Y = 260;
const M_X_LEFT = 110;
const M_X_RIGHT = 230;
const MH = M_MARGIN_TOP + (etapes.length - 1) * M_STEP_Y + 120;
const mobilePoints = etapes.map((etape, i) => ({
  ...etape,
  x: i % 2 === 0 ? M_X_LEFT : M_X_RIGHT,
  y: M_MARGIN_TOP + i * M_STEP_Y,
}));
const mobilePath = buildSerpentine(mobilePoints, 'y');
---

<section class="method" id="methode">
  <span class="blob blob--method" aria-hidden="true"></span>
  <div class="method__inner">
    <span class="eyebrow-pill">
      <span class="eyebrow-pill__dot"></span>
      Méthode
    </span>

    <div class="title-flanked">
      <span class="title-flanked__line" aria-hidden="true" />
      <h2 class="method__title">
        Une méthode claire, <em>pour savoir toujours où on en est.</em>
      </h2>
      <span class="title-flanked__line title-flanked__line--right" aria-hidden="true" />
    </div>

    <p class="method__intro">
      Pas de boîte noire : on avance étape par étape, et tu valides avant qu'on passe à la
      suivante. Le développement assisté par IA me fait gagner du temps sur l'exécution —
      jamais sur la clarté du processus.
    </p>

    <div class="method-path">
      <svg
        class="method-path__svg method-path__svg--desktop"
        viewBox={`0 0 ${DW} ${DH}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          id="method-curve-desktop"
          class="method-path__track"
          d={desktopPath}
          fill="none"
        />
        {
          desktopPoints.map((p, i) => (
            <g
              class="method-cube"
              transform={`translate(${p.x} ${p.y}) scale(${CUBE_SCALE}) translate(${-CUBE_HALF} ${-CUBE_HALF})`}
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label={`Étape ${p.numero} : ${p.titre} — appuie pour voir le détail`}
              data-step={i}
            >
              <circle class="method-cube-glow" r={CUBE_HALF + 12} cx={CUBE_HALF} cy={CUBE_HALF} />
              <path class="method-cube-face method-cube-face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
              <path class="method-cube-face method-cube-face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
              <path class="method-cube-face method-cube-face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
            </g>
          ))
        }
        <circle class="method-path__cursor" r="8">
          <animateMotion
            dur={holdTiming.dur}
            repeatCount="indefinite"
            rotate="0"
            keyTimes={holdTiming.keyTimes}
            keyPoints={holdTiming.keyPoints}
            calcMode="linear"
          >
            <mpath href="#method-curve-desktop" />
          </animateMotion>
        </circle>
        {
          desktopPoints.map((p) => (
            <foreignObject x={p.x - LABEL_W / 2} y={p.y + CUBE_WORLD_HALF + LABEL_GAP} width={LABEL_W} height="60">
              <div xmlns="http://www.w3.org/1999/xhtml" class="method-path__label">
                {p.titre}
              </div>
            </foreignObject>
          ))
        }
      </svg>

      <svg
        class="method-path__svg method-path__svg--mobile"
        viewBox={`0 0 ${MW} ${MH}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          id="method-curve-mobile"
          class="method-path__track"
          d={mobilePath}
          fill="none"
        />
        {
          mobilePoints.map((p, i) => (
            <g
              class="method-cube"
              transform={`translate(${p.x} ${p.y}) scale(${CUBE_SCALE}) translate(${-CUBE_HALF} ${-CUBE_HALF})`}
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label={`Étape ${p.numero} : ${p.titre} — appuie pour voir le détail`}
              data-step={i}
            >
              <circle class="method-cube-glow" r={CUBE_HALF + 12} cx={CUBE_HALF} cy={CUBE_HALF} />
              <path class="method-cube-face method-cube-face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
              <path class="method-cube-face method-cube-face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
              <path class="method-cube-face method-cube-face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
            </g>
          ))
        }
        <circle class="method-path__cursor" r="8">
          <animateMotion
            dur={holdTiming.dur}
            repeatCount="indefinite"
            rotate="0"
            keyTimes={holdTiming.keyTimes}
            keyPoints={holdTiming.keyPoints}
            calcMode="linear"
          >
            <mpath href="#method-curve-mobile" />
          </animateMotion>
        </circle>
        {
          mobilePoints.map((p) => (
            <foreignObject x={p.x - LABEL_W / 2} y={p.y + CUBE_WORLD_HALF + LABEL_GAP} width={LABEL_W} height="60">
              <div xmlns="http://www.w3.org/1999/xhtml" class="method-path__label">
                {p.titre}
              </div>
            </foreignObject>
          ))
        }
      </svg>
    </div>

    <!-- Détail de l'étape en cours — mis en avant automatiquement au rythme
         du curseur (arrêt à chaque étape), ou épinglé manuellement au clic
         sur un cube. Une seule zone, partagée par les deux tracés
         (desktop/mobile), plutôt qu'un texte casé dans le SVG. -->
    <div class="method-detail" id="method-detail" aria-live="polite">
      <span class="method-detail__accent" aria-hidden="true" />
      <div class="method-detail__body">
        <span class="method-detail__numero" id="method-detail-numero" />
        <p class="method-detail__titre" id="method-detail-titre" />
        <p class="method-detail__texte" id="method-detail-texte" />
      </div>
    </div>
  </div>

  <script type="application/json" id="method-steps-data" set:html={JSON.stringify(etapes)} />
</section>

<script>
  type Etape = { numero: string; titre: string; texte: string };

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const svgs = Array.from(document.querySelectorAll('.method-path__svg')) as unknown as SVGSVGElement[];
  const cubesBySvg = svgs.map((svg) => Array.from(svg.querySelectorAll('.method-cube')) as SVGGElement[]);
  const dataEl = document.getElementById('method-steps-data');
  const etapes: Etape[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const detail = document.getElementById('method-detail');
  const detailNumero = document.getElementById('method-detail-numero');
  const detailTitre = document.getElementById('method-detail-titre');
  const detailTexte = document.getElementById('method-detail-texte');

  // Durées partagées avec le minutage SMIL (voir buildHoldTiming côté
  // serveur) : le curseur tient chaque étape HOLD_MS, glisse pendant
  // MOVE_MS — la mise en avant automatique suit exactement ce même rythme.
  const HOLD_MS = 1800;
  const MOVE_MS = 700;

  let activeIndex = 0;
  let pinned = false;
  let tourTimer: ReturnType<typeof setTimeout> | undefined;

  function renderStep(index: number, animate: boolean) {
    const etape = etapes[index];
    if (!etape || !detail) return;

    cubesBySvg.forEach((cubes) => {
      cubes.forEach((cube, i) => {
        const isActive = i === index;
        cube.classList.toggle('is-active', isActive);
        cube.setAttribute('aria-pressed', String(isActive));
      });
    });

    if (animate && !prefersReduced) {
      detail.classList.add('is-swapping');
      window.setTimeout(() => {
        if (detailNumero) detailNumero.textContent = `Étape ${etape.numero}`;
        if (detailTitre) detailTitre.textContent = etape.titre;
        if (detailTexte) detailTexte.textContent = etape.texte;
        detail.classList.remove('is-swapping');
      }, 180);
    } else {
      if (detailNumero) detailNumero.textContent = `Étape ${etape.numero}`;
      if (detailTitre) detailTitre.textContent = etape.titre;
      if (detailTexte) detailTexte.textContent = etape.texte;
    }
  }

  function tourStep(index: number) {
    activeIndex = index;
    renderStep(index, true);
    tourTimer = window.setTimeout(() => tourStep((index + 1) % etapes.length), HOLD_MS + MOVE_MS);
  }

  function startTour() {
    clearTimeout(tourTimer);
    tourStep(activeIndex);
  }

  function stopTour() {
    clearTimeout(tourTimer);
  }

  // Fait "sauter" le curseur SMIL des deux tracés jusqu'au milieu du
  // palier de l'étape choisie, puis fige l'animation à cet instant — le
  // curseur se retrouve visuellement pile sur le cube cliqué.
  function seekCursorTo(index: number) {
    const holdStart = index * (HOLD_MS + MOVE_MS);
    const seconds = (holdStart + HOLD_MS / 2) / 1000;
    svgs.forEach((svg) => {
      svg.setCurrentTime(seconds);
      svg.pauseAnimations();
    });
  }

  function selectStep(index: number) {
    if (pinned && activeIndex === index) {
      // Reclic sur l'étape déjà épinglée : referme et reprend la tournée
      // automatique depuis le début.
      pinned = false;
      if (!prefersReduced) {
        svgs.forEach((svg) => svg.unpauseAnimations());
        startTour();
      }
      return;
    }
    pinned = true;
    stopTour();
    activeIndex = index;
    renderStep(index, true);
    if (!prefersReduced) seekCursorTo(index);
  }

  cubesBySvg.forEach((cubes) => {
    cubes.forEach((cube) => {
      const index = Number(cube.dataset.step);
      cube.addEventListener('click', () => selectStep(index));
      cube.addEventListener('keydown', (event) => {
        const e = event as KeyboardEvent;
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        selectStep(index);
      });
    });
  });

  if (prefersReduced) {
    // Pas de tournée automatique ni de curseur en mouvement : la première
    // étape est affichée directement, le clic reste pleinement fonctionnel
    // mais sans transition animée.
    svgs.forEach((svg) => svg.pauseAnimations());
    renderStep(0, false);
  } else {
    startTour();
  }
</script>

<style>
  .method {
    position: relative;
    padding: var(--section-py) 24px;
    overflow: hidden;
  }

  .blob--method {
    width: 420px;
    height: 420px;
    top: 15%;
    left: -160px;
    background: radial-gradient(circle, rgba(31, 61, 46, 0.12), transparent 70%);
  }

  .method__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  .method__title {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 36ch;
  }

  .method .title-flanked {
    margin-top: 20px;
  }

  .method__title em {
    font-style: italic;
    font-weight: 500;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .method__intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 24px auto 0;
    text-align: center;
  }

  /* Chemin serpentin — le tracé et les titres restent sobres (gris/beige),
     le vert des cubes et le doré du curseur sont les deux seules touches
     d'accent de ce visuel. */
  .method-path {
    margin-top: 56px;
  }

  .method-path__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .method-path__svg--mobile {
    display: none;
  }

  .method-path__track {
    stroke: var(--color-line);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .method-cube-face {
    /* Vert franc (accent-2) plutôt que le vert quasi noir de --color-accent
       — se lit clairement comme "vert", pas comme du noir/marron une fois
       les faces assombries par l'opacité ci-dessous. */
    fill: var(--color-accent-2);
  }

  .method-cube-face--left {
    opacity: 0.8;
  }

  .method-cube-face--right {
    opacity: 0.55;
  }

  .method-path__cursor {
    fill: #d9a854;
    filter: drop-shadow(0 0 6px rgba(217, 168, 84, 0.65));
  }

  .method-path__label {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* Cubes cliquables : agrandissement au survol/focus, halo doré pulsant
     sur l'étape mise en avant (tournée automatique ou clic). transform-box
     recentre le scale sur le cube lui-même plutôt que sur l'origine du
     SVG. */
  /* Le survol ne change plus jamais la géométrie du cube (plus de
     transform:scale) : un cercle de halo invisible mais 50% plus large que
     le cube (voir CUBE_HALF+12 dans le markup) reste dans la zone de
     survol du <g> même à opacité 0, donc scaler le groupe au survol
     déplaçait sa propre limite de survol sous le curseur — d'où le
     clignotement en boucle en déplaçant la souris. Le feedback passe
     maintenant uniquement par l'opacité du halo (jamais par sa géométrie),
     et le halo est exclu du hit-test (pointer-events: none). */
  .method-cube {
    cursor: pointer;
  }

  .method-cube:hover .method-cube-glow {
    opacity: 0.3;
  }

  .method-cube:focus-visible {
    outline: 2px solid var(--color-accent-2);
    outline-offset: 6px;
    border-radius: 4px;
  }

  .method-cube-glow {
    fill: #d9a854;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .method-cube.is-active .method-cube-glow {
    animation: method-glow-pulse 1.8s ease-in-out infinite;
  }

  @keyframes method-glow-pulse {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.18);
    }
  }

  /* Panneau de détail — mis à jour au rythme du curseur (tournée auto) ou
     épinglé par clic. Barre d'accent dégradée or → vert, contenu qui
     s'efface/réapparaît brièvement à chaque changement d'étape plutôt
     qu'un remplacement brut du texte. */
  .method-detail {
    display: flex;
    gap: 20px;
    max-width: 620px;
    margin: 40px auto 0;
    padding: 26px 32px;
    background: var(--color-glass-strong);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .method-detail__accent {
    flex-shrink: 0;
    width: 3px;
    border-radius: 999px;
    background: linear-gradient(180deg, #d9a854, var(--color-accent-2));
  }

  .method-detail__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .method-detail.is-swapping .method-detail__body {
    opacity: 0;
    transform: translateY(4px);
  }

  .method-detail__numero {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ab7d33;
  }

  .method-detail__titre {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-ink);
    margin: 0;
  }

  .method-detail__texte {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .method-path__cursor {
      filter: none;
    }

    .method-cube-glow,
    .method-detail__body {
      transition: none;
    }

    .method-cube.is-active .method-cube-glow {
      animation: none;
      opacity: 0.3;
    }
  }

  @media (max-width: 860px) {
    .method {
      padding: var(--section-py-mobile) 20px;
    }

    .method-path {
      margin-top: 40px;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .method-path__svg--desktop {
      display: none;
    }

    .method-path__svg--mobile {
      display: block;
    }

    .method-detail {
      max-width: 320px;
      padding: 22px 24px;
    }
  }
</style>
