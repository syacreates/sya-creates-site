<!-- Écran d'intro — pyramide de cubes chromés (même matériau/palette que les
     cubes du hero) qui s'écroule doucement au clic sur le CTA. Purement
     décoratif pour les technologies d'assistance (aria-hidden) : un lecteur
     d'écran accède directement au contenu réel en dessous, sans blocage.
     Rejoue à chaque chargement complet de la page (rafraîchissement inclus)
     — pas de mémorisation de session. -->
<div id="intro-overlay" class="intro-overlay" aria-hidden="true">
  <canvas id="intro-overlay-canvas" class="intro-overlay__canvas"></canvas>
  <button type="button" id="intro-overlay-cta" class="intro-overlay__cta">
    <span class="intro-overlay__cta-icon" aria-hidden="true">
      <svg viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg">
        <path class="intro-overlay__cta-face intro-overlay__cta-face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
        <path class="intro-overlay__cta-face intro-overlay__cta-face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
        <path class="intro-overlay__cta-face intro-overlay__cta-face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
      </svg>
    </span>
    Découvrir le site
  </button>
</div>

<script is:inline>
  // Décision synchrone (avant peinture) : sous prefers-reduced-motion, pas
  // d'overlay du tout — la scène WebGL (plus lourde à construire) reste
  // dans le script différé ci-dessous.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var el = document.getElementById('intro-overlay');
    if (el) el.style.display = 'none';
  }
</script>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import * as CANNON from 'cannon-es';

  const overlay = document.getElementById('intro-overlay');
  const canvas = document.getElementById('intro-overlay-canvas') as HTMLCanvasElement | null;
  const cta = document.getElementById('intro-overlay-cta');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && canvas && cta && !prefersReduced) {
    let width = window.innerWidth;
    let height = window.innerHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.55);
    const key = new THREE.DirectionalLight(0xffffff, 1.5);
    key.position.set(140, 260, 320);
    // Contre-jour froid en léger dégradé or : sépare tonalement la face
    // latérale de la face du dessus une fois les cubes inclinés (sans quoi
    // l'unique lumière clé aplatit les faces sombres entre elles).
    const rim = new THREE.DirectionalLight(0xffe3ad, 0.5);
    rim.position.set(-200, -80, 180);
    scene.add(ambient, key, rim);

    // Gravité nulle au départ : les cubes n'existent pas encore avant le
    // clic (voir plus bas), la gravité n'est activée qu'au moment de leur
    // création, déjà en train de tomber.
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, 0, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);
    const cubeMat = new CANNON.Material('cube');
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, cubeMat, { friction: 0.4, restitution: 0.1 }));

    // Trois nuances de vert de la marque (accent foncé + les deux verts du
    // hero) — plus d'or, tout reste dans la même famille de teinte.
    const palette = [0x1f3d2e, 0x3f7a58, 0x4c8c63];
    // Cubes un peu plus grands qu'avant : une grille plein écran (pas une
    // pyramide) compte nettement plus de cubes à taille égale, donc on
    // agrandit légèrement pour garder un nombre de corps physiques
    // raisonnable sur mobile/bas de gamme.
    const cubeSize = width < 640 ? 52 : width < 1100 ? 64 : 82;

    type CubeRig = { mesh: THREE.Mesh; body: CANNON.Body };
    const cubes: CubeRig[] = [];

    // Le cube visuel est légèrement plus petit que la maille de la grille :
    // un mince interstice laisse respirer le fond entre les cubes plutôt
    // qu'une surface 100% pleine, et évite tout chevauchement de coins une
    // fois les cubes en rotation pendant la chute.
    const visualSize = cubeSize * 0.9;

    // Les cubes n'existent pas avant le clic — rien à construire au
    // chargement, la page reste un simple aplat beige sable jusqu'à ce que
    // le CTA soit déclenché.
    function spawnCube(cx: number, cy: number) {
      const color = palette[Math.floor(Math.random() * palette.length)];
      const geo = new RoundedBoxGeometry(visualSize, visualSize, visualSize, 4, visualSize * 0.06);
      const mat = new THREE.MeshStandardMaterial({ color, metalness: 1, roughness: 0.22, envMapIntensity: 1.3 });
      const mesh = new THREE.Mesh(geo, mat);
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo, 25),
        new THREE.LineBasicMaterial({ color: 0x1f3d2e, transparent: true, opacity: 0.35 })
      );
      mesh.add(edges);
      scene.add(mesh);

      // Corps dynamique dès la création : le cube naît déjà en train de
      // tomber (vitesse + rotation données par collapse()), pas de temps de
      // repos figé — c'est le clic qui le fait exister.
      const half = visualSize / 2;
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.45,
        angularDamping: 0.5,
      });
      body.position.set(cx, cy, (Math.random() - 0.5) * cubeSize * 0.4);
      body.velocity.set((Math.random() - 0.5) * 220, -Math.random() * 120, (Math.random() - 0.5) * 160);
      body.angularVelocity.set((Math.random() - 0.5) * 5, (Math.random() - 0.5) * 5, (Math.random() - 0.5) * 5);
      world.addBody(body);

      cubes.push({ mesh, body });
    }

    // Grille pleine : les cubes couvrent tout l'écran, bord à bord, du sol
    // au plafond du viewport — pas une pyramide qui laisse des coins vides.
    function buildGrid() {
      const cols = Math.ceil(width / cubeSize);
      const rows = Math.ceil(height / cubeSize);
      const startX = -width / 2 + cubeSize / 2;
      const startY = -height / 2 + cubeSize / 2;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          spawnCube(startX + c * cubeSize, startY + r * cubeSize);
        }
      }
    }

    let running = true;
    let rafId = 0;
    let prevTime = performance.now();
    let collapsedAt: number | null = null;

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      world.step(1 / 60, dt, 6);

      for (const c of cubes) {
        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);
        c.mesh.quaternion.set(c.body.quaternion.x, c.body.quaternion.y, c.body.quaternion.z, c.body.quaternion.w);
      }
      renderer.render(scene, camera);

      if (collapsedAt !== null && now - collapsedAt > 3200) {
        running = false;
        cancelAnimationFrame(rafId);
        overlay.remove();
      }
    }
    // La boucle de rendu ne démarre qu'au clic : avant, aucun cube n'existe
    // et il n'y a rien à faire tourner en continu — juste la page beige.

    let collapsed = false;
    function collapse() {
      if (collapsed) return;
      collapsed = true;
      prevTime = performance.now();
      rafId = requestAnimationFrame(tick);

      // Gravité douce (pas un lâcher brutal) : les cubes, qui n'existaient
      // pas jusqu'ici, naissent au même instant déjà en train de tomber
      // (vitesse + rotation aléatoires données dans spawnCube) — l'effet
      // 3D n'apparaît donc qu'à partir de ce clic, jamais avant.
      world.gravity.set(0, -900, 0);
      buildGrid();

      overlay.classList.add('is-falling');
      window.removeEventListener('keydown', collapse);
      cta.removeEventListener('click', collapse);
      clearTimeout(safetyTimer);
      collapsedAt = performance.now();
    }

    cta.addEventListener('click', collapse);
    window.addEventListener('keydown', collapse);
    const safetyTimer = setTimeout(collapse, 4500);

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    });
  }
</script>

<style is:global>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-accent);
    overflow: hidden;
    /* Le fond opaque disparaît vite au clic : on doit voir la page
       d'accueil derrière les cubes pendant qu'ils tombent, pas seulement
       une fois qu'ils ont fini de tomber. */
    transition: background-color 0.25s ease;
  }

  .intro-overlay.is-falling {
    background-color: transparent;
    /* Le site redevient utilisable immédiatement — pas besoin d'attendre
       que les cubes finissent de tomber pour cliquer en dessous. */
    pointer-events: none;
  }

  .intro-overlay__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* CTA sur mesure — dégradé or (pas le vert des boutons du site) pour
     trancher nettement sur le fond vert de l'overlay, avec le cube
     isométrique de la marque comme icône plutôt qu'un bouton texte nu.
     Halo qui respire + cube qui tourne doucement en continu : signale que
     ce n'est pas un CTA comme les autres, sans le dire par du texte. */
  .intro-overlay__cta {
    position: absolute;
    top: 48px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 30px 14px 18px;
    border: none;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f0cf8f, #d9a854);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 0 0 0 rgba(217, 168, 84, 0.5), 0 12px 30px -14px rgba(0, 0, 0, 0.5);
    transform: translateX(-50%);
    transition: opacity 0.3s ease, transform 0.35s var(--ease-spring), box-shadow 0.35s var(--ease-spring),
      filter 0.2s ease;
    animation: intro-cta-breathe 2.6s ease-in-out infinite;
  }

  .intro-overlay__cta:hover {
    transform: translateX(-50%) translateY(-2px) scale(1.04);
    filter: brightness(1.05);
  }

  .intro-overlay__cta:active {
    transform: translateX(-50%) scale(0.97);
    transition-duration: 0.1s;
  }

  .intro-overlay__cta-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    animation: intro-cta-spin 4.5s linear infinite;
  }

  .intro-overlay__cta-icon svg {
    width: 100%;
    height: 100%;
  }

  .intro-overlay__cta-face {
    fill: var(--color-accent);
  }

  .intro-overlay__cta-face--left {
    opacity: 0.72;
  }

  .intro-overlay__cta-face--right {
    opacity: 0.48;
  }

  @keyframes intro-cta-breathe {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(217, 168, 84, 0.45), 0 12px 30px -14px rgba(0, 0, 0, 0.5);
    }
    50% {
      box-shadow: 0 0 0 12px rgba(217, 168, 84, 0), 0 16px 34px -12px rgba(0, 0, 0, 0.55);
    }
  }

  @keyframes intro-cta-spin {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(360deg);
    }
  }

  .intro-overlay.is-falling .intro-overlay__cta {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .intro-overlay__cta {
      top: 32px;
    }
  }
</style>
