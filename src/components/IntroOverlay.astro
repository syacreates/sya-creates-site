---

<!-- Écran d'intro — pyramide de cubes chromés (même matériau/palette que les
     cubes du hero) qui s'écroule doucement au clic sur le CTA. Purement
     décoratif pour les technologies d'assistance (aria-hidden) : un lecteur
     d'écran accède directement au contenu réel en dessous, sans blocage.
     Rejoue à chaque chargement complet de la page (rafraîchissement inclus)
     — pas de mémorisation de session. -->
<div id="intro-overlay" class="intro-overlay" aria-hidden="true">
  <canvas id="intro-overlay-canvas" class="intro-overlay__canvas"></canvas>
  <button type="button" id="intro-overlay-cta" class="intro-overlay__cta" aria-label="Commencer, découvrir le site">
    <span class="intro-overlay__cta-row">
      <span class="intro-overlay__cta-icon" aria-hidden="true">
        <canvas id="intro-overlay-cta-canvas" class="intro-overlay__cta-canvas"></canvas>
      </span>
      <span class="intro-overlay__cta-wordmark" aria-hidden="true">Sya<span class="intro-overlay__cta-dot">.</span>Creates</span>
    </span>
    <span class="intro-overlay__cta-hint" aria-hidden="true">
      Commencer
      <span class="intro-overlay__cta-arrow">→</span>
    </span>
  </button>
</div>

<script is:inline>
  // Décision synchrone (avant peinture) : sous prefers-reduced-motion, pas
  // d'overlay du tout — la scène WebGL (plus lourde à construire) reste
  // dans le script différé ci-dessous.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var el = document.getElementById('intro-overlay');
    if (el) el.style.display = 'none';
  }
</script>

<script>
  const overlay = document.getElementById('intro-overlay');
  const canvas = document.getElementById('intro-overlay-canvas') as HTMLCanvasElement | null;
  const cta = document.getElementById('intro-overlay-cta');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && canvas && cta && !prefersReduced) {
    // Three.js/cannon-es (~600 Ko à eux deux) ne sont chargés qu'ici, à la
    // demande, plutôt qu'en import statique évalué au chargement de la
    // page — ce bundle plombait le FCP/LCP (mesuré : ~2,7s de thread
    // principal rien que pour son parsing/exécution). Sous
    // prefers-reduced-motion, il n'est même jamais téléchargé.
    void (async () => {
    const [THREE, { RoundedBoxGeometry }, { RoomEnvironment }, CANNON] = await Promise.all([
      import('three'),
      import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
      import('three/examples/jsm/environments/RoomEnvironment.js'),
      import('cannon-es'),
    ]);

    let width = window.innerWidth;
    let height = window.innerHeight;

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-width / 2, width / 2, height / 2, -height / 2, 1, 2000);
    camera.position.z = 700;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const ambient = new THREE.AmbientLight(0xffffff, 0.55);
    const key = new THREE.DirectionalLight(0xffffff, 1.5);
    key.position.set(140, 260, 320);
    // Contre-jour froid en léger dégradé or : sépare tonalement la face
    // latérale de la face du dessus une fois les cubes inclinés (sans quoi
    // l'unique lumière clé aplatit les faces sombres entre elles).
    const rim = new THREE.DirectionalLight(0xffe3ad, 0.5);
    rim.position.set(-200, -80, 180);
    scene.add(ambient, key, rim);

    // Cube-logo du CTA : petite scène 3D indépendante (pas une icône SVG
    // qu'on pivote en CSS) — même matériau chromé/or que les cubes qui
    // tombent, pour un vrai reflet spéculaire qui bouge avec la rotation
    // plutôt qu'un flat-shading figé. Tourne en continu sur deux axes
    // (tumbling, pas un simple spin Y) jusqu'au clic.
    const iconCanvas = document.getElementById('intro-overlay-cta-canvas') as HTMLCanvasElement | null;
    const iconWrapper = cta.querySelector('.intro-overlay__cta-icon') as HTMLElement | null;
    let iconRafId = 0;
    if (iconCanvas && iconWrapper) {
      const iconScene = new THREE.Scene();
      const iconCamera = new THREE.OrthographicCamera(-22, 22, 22, -22, 1, 500);
      iconCamera.position.z = 100;

      const iconRenderer = new THREE.WebGLRenderer({ canvas: iconCanvas, alpha: true, antialias: true });
      const iconPmrem = new THREE.PMREMGenerator(iconRenderer);
      iconScene.environment = iconPmrem.fromScene(new RoomEnvironment(), 0.04).texture;

      const iconAmbient = new THREE.AmbientLight(0xffffff, 0.55);
      const iconKey = new THREE.DirectionalLight(0xffffff, 1.5);
      iconKey.position.set(140, 260, 320);
      const iconRim = new THREE.DirectionalLight(0xffe3ad, 0.5);
      iconRim.position.set(-200, -80, 180);
      iconScene.add(iconAmbient, iconKey, iconRim);

      const iconGeo = new RoundedBoxGeometry(24, 24, 24, 4, 24 * 0.06);
      // Plus glacé/brillant que les cubes qui tombent (roughness plus basse,
      // envMapIntensity plus haute) : c'est la pièce maîtresse de l'écran
      // d'intro, elle doit accrocher la lumière plus fort que le reste.
      const iconMat = new THREE.MeshStandardMaterial({
        color: 0xd9a854,
        metalness: 1,
        roughness: 0.15,
        envMapIntensity: 1.7,
      });
      const iconMesh = new THREE.Mesh(iconGeo, iconMat);
      iconMesh.rotation.set(-0.5, 0.7, 0);
      const iconEdges = new THREE.LineSegments(
        new THREE.EdgesGeometry(iconGeo, 25),
        new THREE.LineBasicMaterial({ color: 0x1f3d2e, transparent: true, opacity: 0.35 })
      );
      iconMesh.add(iconEdges);
      iconScene.add(iconMesh);

      function sizeIconRenderer() {
        const size = iconWrapper!.clientWidth || 60;
        iconRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        iconRenderer.setSize(size, size, false);
      }
      sizeIconRenderer();

      function iconTick() {
        iconRafId = requestAnimationFrame(iconTick);
        iconMesh.rotation.x += 0.011;
        iconMesh.rotation.y += 0.018;
        iconRenderer.render(iconScene, iconCamera);
      }
      iconTick();

      window.addEventListener('resize', sizeIconRenderer);
    }

    // Gravité nulle au départ : les cubes n'existent pas encore avant le
    // clic (voir plus bas), la gravité n'est activée qu'au moment de leur
    // création, déjà en train de tomber.
    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, 0, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);
    const cubeMat = new CANNON.Material('cube');
    world.addContactMaterial(new CANNON.ContactMaterial(cubeMat, cubeMat, { friction: 0.4, restitution: 0.1 }));

    // Couleurs exactes de la charte (--color-accent, --color-accent-2, or
    // #d9a854) — les mêmes que la pile de cubes du hero, pas une teinte
    // approchée inventée pour l'occasion.
    const palette = [0x1f3d2e, 0x4c8c63, 0xd9a854];
    // Cubes un peu plus grands qu'avant : une grille plein écran (pas une
    // pyramide) compte nettement plus de cubes à taille égale, donc on
    // agrandit légèrement pour garder un nombre de corps physiques
    // raisonnable sur mobile/bas de gamme.
    const cubeSize = width < 640 ? 52 : width < 1100 ? 64 : 82;

    type CubeRig = { mesh: THREE.Mesh; body: CANNON.Body };
    const cubes: CubeRig[] = [];

    // Le cube visuel est légèrement plus petit que la maille de la grille :
    // un mince interstice laisse respirer le fond entre les cubes plutôt
    // qu'une surface 100% pleine, et évite tout chevauchement de coins une
    // fois les cubes en rotation pendant la chute.
    const visualSize = cubeSize * 0.9;

    // Les cubes n'existent pas avant le clic — rien à construire au
    // chargement, la page reste un simple aplat avec le cube doré tournant
    // jusqu'à ce que le clic soit déclenché.
    function spawnCube(cx: number, cy: number, originX: number, originY: number) {
      const color = palette[Math.floor(Math.random() * palette.length)];
      const geo = new RoundedBoxGeometry(visualSize, visualSize, visualSize, 4, visualSize * 0.06);
      const mat = new THREE.MeshStandardMaterial({ color, metalness: 1, roughness: 0.22, envMapIntensity: 1.3 });
      const mesh = new THREE.Mesh(geo, mat);
      const edges = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo, 25),
        new THREE.LineBasicMaterial({ color: 0x1f3d2e, transparent: true, opacity: 0.35 })
      );
      mesh.add(edges);
      scene.add(mesh);

      // Corps dynamique dès la création : le cube naît déjà en train de
      // tomber, propulsé depuis le point cliqué (vitesse radiale calculée
      // ci-dessous) — pas de temps de repos figé.
      const half = visualSize / 2;
      const body = new CANNON.Body({
        mass: 1,
        material: cubeMat,
        shape: new CANNON.Box(new CANNON.Vec3(half, half, half)),
        linearDamping: 0.45,
        angularDamping: 0.5,
      });
      body.position.set(cx, cy, (Math.random() - 0.5) * cubeSize * 0.4);

      // Vitesse radiale : direction du point cliqué vers le cube, pour que
      // l'explosion parte visuellement de là où l'utilisateur a cliqué
      // plutôt que d'une chute uniforme.
      const dx = cx - originX;
      const dy = cy - originY;
      const dist = Math.hypot(dx, dy) || 1;
      const nx = dx / dist;
      const ny = dy / dist;
      const speed = 260 + Math.random() * 200;
      body.velocity.set(
        nx * speed + (Math.random() - 0.5) * 60,
        ny * speed + (Math.random() - 0.5) * 60,
        (Math.random() - 0.5) * 160
      );
      body.angularVelocity.set((Math.random() - 0.5) * 6, (Math.random() - 0.5) * 6, (Math.random() - 0.5) * 6);
      world.addBody(body);

      cubes.push({ mesh, body });
    }

    // Grille pleine : les cubes couvrent tout l'écran, bord à bord, du sol
    // au plafond du viewport — pas une pyramide qui laisse des coins vides.
    function buildGrid(originX: number, originY: number) {
      // Bande réduite plutôt que la hauteur totale de l'écran.
      const gridHeight = height * 0.45;
      const cols = Math.ceil(width / cubeSize);
      const rows = Math.ceil(gridHeight / cubeSize);
      const startX = -width / 2 + cubeSize / 2;
      const startY = -gridHeight / 2 + cubeSize / 2;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          spawnCube(startX + c * cubeSize, startY + r * cubeSize, originX, originY);
        }
      }
    }

    let running = true;
    let rafId = 0;
    let prevTime = performance.now();
    let collapsedAt: number | null = null;

    function tick() {
      rafId = requestAnimationFrame(tick);
      const now = performance.now();
      const dt = Math.min((now - prevTime) / 1000, 1 / 30);
      prevTime = now;

      world.step(1 / 60, dt, 6);

      for (const c of cubes) {
        c.mesh.position.copy(c.body.position as unknown as THREE.Vector3);
        c.mesh.quaternion.set(c.body.quaternion.x, c.body.quaternion.y, c.body.quaternion.z, c.body.quaternion.w);
      }
      renderer.render(scene, camera);

      if (collapsedAt !== null && now - collapsedAt > 3200) {
        running = false;
        cancelAnimationFrame(rafId);
        overlay.remove();
      }
    }
    // La boucle de rendu ne démarre qu'au clic : avant, aucun cube n'existe
    // et il n'y a rien à faire tourner en continu — juste la page beige.

    let collapsed = false;
    function collapse(clientX?: number, clientY?: number) {
      if (collapsed) return;
      collapsed = true;
      prevTime = performance.now();
      rafId = requestAnimationFrame(tick);

      // Origine de l'explosion : le point cliqué (converti en coordonnées
      // monde, 1 unité = 1px, origine au centre) — ou le centre de l'écran
      // par défaut (clavier, timeout de sécurité).
      const originX = typeof clientX === 'number' ? clientX - width / 2 : 0;
      const originY = typeof clientY === 'number' ? height / 2 - clientY : 0;

      // Gravité douce (pas un lâcher brutal) : les cubes, qui n'existaient
      // pas jusqu'ici, naissent au même instant déjà en train de tomber,
      // propulsés depuis le point cliqué — l'effet 3D n'apparaît donc qu'à
      // partir de ce clic, jamais avant.
      world.gravity.set(0, -900, 0);
      buildGrid(originX, originY);

      overlay.classList.add('is-falling');
      overlay.removeEventListener('click', onOverlayClick);
      window.removeEventListener('keydown', onKeydown);
      clearTimeout(safetyTimer);
      collapsedAt = performance.now();
      // Le cube-logo s'efface (transition CSS) au même instant : plus
      // besoin de continuer à le faire tourner en arrière-plan.
      cancelAnimationFrame(iconRafId);
    }

    // Le clic n'importe où sur l'overlay déclenche l'explosion, pas
    // seulement le cube doré — celui-ci reste le seul repère visuel, mais
    // toute la surface est cliquable.
    function onOverlayClick(e: MouseEvent) {
      collapse(e.clientX, e.clientY);
    }
    function onKeydown() {
      collapse();
    }

    overlay.addEventListener('click', onOverlayClick);
    window.addEventListener('keydown', onKeydown);
    const safetyTimer = setTimeout(() => collapse(), 4500);

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.left = -width / 2;
      camera.right = width / 2;
      camera.top = height / 2;
      camera.bottom = -height / 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    });
    })();
  }
</script>

<style is:global>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-accent);
    overflow: hidden;
    /* Le fond opaque disparaît vite au clic : on doit voir la page
       d'accueil derrière les cubes pendant qu'ils tombent, pas seulement
       une fois qu'ils ont fini de tomber. */
    transition: background-color 0.25s ease;
  }

  .intro-overlay.is-falling {
    background-color: transparent;
    /* Le site redevient utilisable immédiatement — pas besoin d'attendre
       que les cubes finissent de tomber pour cliquer en dessous. */
    pointer-events: none;
  }

  .intro-overlay__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Seul repère visuel de l'écran d'intro : le logo (cube + "Sya.Creates"),
     pas de texte d'instruction ("cliquer pour...") — le cube qui tourne et
     le halo qui pulse suffisent à inviter le clic. Toute la surface de
     l'overlay reste cliquable (voir le script). */
  .intro-overlay__cta {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    z-index: 2;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease, transform 0.35s var(--ease-spring);
  }

  .intro-overlay__cta-row {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }

  /* CTA "Commencer" — sans lui, rien n'indique explicitement que l'écran
     est cliquable au premier coup d'œil : le cube tournant seul se lit
     comme un logo décoratif, pas comme une invitation à agir. */
  .intro-overlay__cta-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(217, 168, 84, 0.5);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f4f1e7;
    animation: intro-cta-hint-pulse 2.2s ease-in-out infinite;
  }

  .intro-overlay__cta-arrow {
    color: #d9a854;
    transition: transform 0.3s var(--ease-spring);
  }

  .intro-overlay__cta:hover .intro-overlay__cta-arrow {
    transform: translateX(4px);
  }

  @keyframes intro-cta-hint-pulse {
    0%,
    100% {
      border-color: rgba(217, 168, 84, 0.35);
    }
    50% {
      border-color: rgba(217, 168, 84, 0.85);
    }
  }

  .intro-overlay__cta:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .intro-overlay__cta:active {
    transform: translate(-50%, -50%) scale(0.95);
    transition-duration: 0.1s;
  }

  .intro-overlay__cta-icon {
    display: block;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    /* La rotation elle-même vient du rendu 3D (voir le script) — ici juste
       le halo qui respire, en filter pour ne jamais entrer en conflit avec
       le scale appliqué au survol sur le bouton parent. */
    animation: intro-cta-glow 2.2s ease-in-out infinite;
  }

  .intro-overlay__cta-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .intro-overlay__cta-wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: #f4f1e7;
    white-space: nowrap;
  }

  .intro-overlay__cta-dot {
    color: #d9a854;
  }

  @keyframes intro-cta-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 8px rgba(217, 168, 84, 0.4));
    }
    50% {
      filter: drop-shadow(0 0 22px rgba(217, 168, 84, 0.9));
    }
  }

  .intro-overlay.is-falling .intro-overlay__cta {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .intro-overlay__cta {
      gap: 18px;
    }

    .intro-overlay__cta-row {
      gap: 10px;
    }

    .intro-overlay__cta-hint {
      padding: 8px 18px;
      font-size: 11px;
    }

    .intro-overlay__cta-icon {
      width: 44px;
      height: 44px;
    }

    .intro-overlay__cta-wordmark {
      font-size: 1.125rem;
    }
  }
</style>
