---
interface Props {
  variant?: 'on-dark' | 'on-light';
  class?: string;
}

const { variant = 'on-light', class: className = '' } = Astro.props;
---

<a href="/" class={`logo logo--${variant} ${className}`} aria-label="Sya.Creates, accueil">
  <svg class="logo__mark" viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Cube isométrique — une seule teinte à 3 opacités (100/80/55%) pour
         les 3 faces, comme les 3 étapes de la méthode (comprendre,
         structurer, habiller). Couleur pilotée par le variant on-light/
         on-dark ci-dessous, pas par currentColor (le cube garde toujours
         la teinte de marque, indépendamment du wordmark). -->
    <path class="logo__face logo__face--top" d="M22 4 L38 13 L22 22 L6 13 Z" />
    <path class="logo__face logo__face--left" d="M6 13 L22 22 L22 40 L6 31 Z" />
    <path class="logo__face logo__face--right" d="M38 13 L38 31 L22 40 L22 22 Z" />
  </svg>
  <span class="logo__wordmark">Sya<span class="logo__dot">.</span>Creates</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* Tout le site est désormais en dark mode : les deux variants
     convergent vers la même teinte de marque (sapin clair, le seul accent
     chromatique du site) plutôt que le duo encre/crème d'origine, pensé
     pour une page claire avec de rares zones sombres. */
  .logo--on-dark {
    color: var(--color-ink);
  }

  .logo__mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .logo--on-light .logo__face--top,
  .logo--on-dark .logo__face--top {
    fill: var(--color-accent-2);
  }

  .logo--on-light .logo__face--left,
  .logo--on-dark .logo__face--left {
    fill: var(--color-accent-2);
    opacity: 0.8;
  }

  .logo--on-light .logo__face--right,
  .logo--on-dark .logo__face--right {
    fill: var(--color-accent-2);
    opacity: 0.55;
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: currentColor;
    white-space: nowrap;
  }

  .logo__dot {
    color: var(--color-accent-2);
  }
</style>
